      "/**",
      " * Description: Linear Time Prime Sieve ",
      " */",
      "",
      "template<int SZ> struct Sieve { ",
      "\tint sp[SZ];",
      "\tvi pr;",
      "",
      "\tSieve() {",
      "\t\tmemset(sp,0,sizeof sp);",
      "\t\tFOR(i,2,SZ) { // O(N) sieve",
      "\t\t\tif (sp[i] == 0) { sp[i] = i; pr.pb(i); }",
