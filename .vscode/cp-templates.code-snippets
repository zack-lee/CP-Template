  "content/geo/Polygons/PolyDiameter.h": {
    "scope": "cpp,c",
    "prefix": "PolyDiameter",
    "body": [
      "/**",
      " * Description: computes longest distance between two points in \\$P\\$",
      " * Time: \\$O(N)\\$ given convex hull",
      " * Source: KACTL",
      " * Verification:",
      "\t* https://open.kattis.com/problems/roberthood",
      " */",
      "",
      "#include \"ConvexHull.h\"",
      "",
      "ld diameter(vP P) { // rotating calipers",
      "\tP = hull(P);",
      "\tint n = sz(P), ind = 1; ld ans = 0;",
      "\tF0R(i,n) ",
      "\t\tfor (int j = (i+1)%n;;ind = (ind+1)%n) {",
      "\t\t\tckmax(ans,abs(P[i]-P[ind]));",
      "\t\t\tif (cross(P[j]-P[i],P[(ind+1)%n]-P[ind]) <= 0) break;",
      "\t\t}",
      "\treturn ans;",
      "}"
    ],
