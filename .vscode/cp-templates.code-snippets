  "content/graph/Fundamentals/DSURollBack.h": {
    "scope": "cpp,c",
    "prefix": "DSURollBack",
    "body": [
      "/**",
      " * Description: Disjoint Set Union with Rollback",
      " * Source: see DSU",
      " * Verification: https://codeforces.com/contest/1140/problem/F",
      " */",
      "",
      "struct DSUrb {",
      "\tvi e;",
      "\tvoid init(int n) { e = vi(n,-1); }",
      "\tint get(int x) { return e[x] < 0 ? x : get(e[x]); } // path compression",
      "\tbool sameSet(int a, int b) { return get(a) == get(b); }",
      "\tint size(int x) { return -e[get(x)]; }",
      "\tvector<array<int,4>> mod;",
      "\tbool unite(int x, int y) { // union-by-rank",
      "\t\tx = get(x), y = get(y); ",
      "\t\tif (x == y) {",
      "\t\t\tmod.pb({MOD,MOD,MOD,MOD});",
      "\t\t\treturn 0;",
      "\t\t}",
      "\t\tif (e[x] > e[y]) swap(x,y);",
      "\t\tmod.pb({x,y,e[x],e[y]});",
      "\t\te[x] += e[y]; e[y] = x;",
      "\t\treturn 1;",
      "\t}",
      "\tvoid rollback() {",
      "\t\tauto a = mod.back(); mod.pop_back();",
      "\t\tif (a[0] != MOD) e[a[0]] = a[2], e[a[1]] = a[3];",
      "\t}",
      "};"
    ],
