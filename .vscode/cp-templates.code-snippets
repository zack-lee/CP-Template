      "def partial(s):",
      "    g, pi = 0, [0] * len(s)",
      "    for i in range(1, len(s)):",
      "        while g and (s[g] != s[i]):",
      "            g = pi[g - 1]",
      "        pi[i] = g = g + (s[g] == s[i])",
      "",
      "    return pi",
      "",
      "",
      "def match(s, pat):",
      "    pi = partial(pat)",
      "",
      "    g, idx = 0, []",
      "    for i in range(len(s)):",
      "        while g and pat[g] != s[i]:",
      "            g = pi[g - 1]",
      "        g += pat[g] == s[i]",
      "        if g == len(pi):",
      "            idx.append(i + 1 - g)",
      "            g = pi[g - 1]",
      "",
      "    return idx",
      "",
      "",
      "def string_find(s, pat):",
      "    pi = partial(pat)",
      "",
      "    g = 0",
      "    for i in range(len(s)):",
      "        while g and pat[g] != s[i]:",
      "            g = pi[g - 1]",
      "        g += pat[g] == s[i]",
      "        if g == len(pi):",
      "            return True",
      "",
      "    return False"
    ],
    "description": "strings/kmp.py"
