  "content/combi/MatroidIntersect.h": {
    "scope": "cpp,c",
    "prefix": "MatroidIntersect",
    "body": [
      "/**",
      " * Description: computes a set of maximum size which is independent ",
      " \t* in both graphic and colorful matroids, aka a spanning forest where",
      " \t* no two edges are of the same color",
      " * Time: \\$O(GI^{1.5})\\$ calls to oracles, where \\$G\\$ is the size of the ground set ",
      " \t* and \\$I\\$ is the size of the independent set",
      " * Source: https://codeforces.com/blog/entry/69287",
      " * Verification: https://www.spoj.com/problems/COIN/",
      " */",
      "",
      "#include \"DSU.h\"",
      "",
      "int R;",
      "map<int,int> m;",
      " ",
      "struct Element {",
      "\tpi ed;",
      "\tint col;",
      "\tbool in_independent_set = 0;",
      "\tint independent_set_position;",
      "\tElement(int u, int v, int c) { ed = {u,v}; col = c; }",
      "};",
      " ",
      "vi independent_set;",
      "vector<Element> ground_set;",
      "bool col_used[300];",
      "",
      "struct GBasis {",
      "\tDSU D;",
      "\tvoid reset() { D.init(sz(m)); } ",
      "\tvoid add(pi v) { assert(D.unite(v.f,v.s)); }",
      "\tbool independent_with(pi v) { return !D.sameSet(v.f,v.s); }",
      "};",
      " ",
      "GBasis basis, basis_wo[300];",
      " ",
      "bool graph_oracle(int inserted) {",
      "\treturn basis.independent_with(ground_set[inserted].ed);",
      "}",
      "bool graph_oracle(int inserted, int removed) {",
      "\tint wi = ground_set[removed].independent_set_position;",
      "\treturn basis_wo[wi].independent_with(ground_set[inserted].ed);",
      "}",
      "void prepare_graph_oracle() {",
      "\tbasis.reset();",
      "\tF0R(i,sz(independent_set)) basis_wo[i].reset();",
      "\tF0R(i,sz(independent_set)) {",
      "\t\tpi v = ground_set[independent_set[i]].ed; basis.add(v);",
      "\t\tF0R(j,sz(independent_set)) if (i != j) basis_wo[j].add(v);",
      "\t}",
      "}",
      " ",
      "bool colorful_oracle(int ins) {",
      "\tins = ground_set[ins].col;",
      "\treturn !col_used[ins];",
      "}",
      "bool colorful_oracle(int ins, int rem) {",
      "\tins = ground_set[ins].col;",
      "\trem = ground_set[rem].col;",
      "\treturn !col_used[ins] || ins == rem;",
      "}",
      "void prepare_colorful_oracle() {",
      "\tF0R(i,R) col_used[i] = 0;",
      "\ttrav(t,independent_set) col_used[ground_set[t].col] = 1;",
      "}",
      " ",
      "bool augment() {",
      "\tprepare_graph_oracle();",
      "\tprepare_colorful_oracle();",
      "\t",
      "\tvi par(sz(ground_set),MOD);",
      "\tqueue<int> q;",
      "\tF0R(i,sz(ground_set)) if (colorful_oracle(i)) {",
      "\t\tassert(!ground_set[i].in_independent_set);",
      "\t\tpar[i] = -1; q.push(i);",
      "\t}",
      "\tint lst = -1;",
      "\twhile (sz(q)) {",
      "\t\tint cur = q.front(); q.pop();",
      "\t\tif (ground_set[cur].in_independent_set) {",
      "\t\t\tF0R(to,sz(ground_set)) if (par[to] == MOD) {",
      "\t\t\t\tif (!colorful_oracle(to,cur)) continue;",
      "\t\t\t\tpar[to] = cur; q.push(to);",
      "\t\t\t}",
      "\t\t} else {",
      "\t\t\tif (graph_oracle(cur)) { lst = cur; break;\t}",
      "\t\t\ttrav(to,independent_set) if (par[to] == MOD) {",
      "\t\t\t\tif (!graph_oracle(cur,to)) continue;",
      "\t\t\t\tpar[to] = cur; q.push(to);",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tif (lst == -1) return 0;",
      "\tdo {",
