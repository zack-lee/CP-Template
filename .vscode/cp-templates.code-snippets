      "\tfriend bool operator==(const mint& a, const mint& b) { return a.val == b.val; }",
      "\tfriend bool operator!=(const mint& a, const mint& b) { return !(a == b); }",
      "\tfriend bool operator<(const mint& a, const mint& b) { return a.val < b.val; }",
      "",
      "\tmint operator-() const { return mint(-val); }",
      "\tmint& operator+=(const mint& m) { if ((val += m.val) >= MOD) val -= MOD; return *this; }",
      "\tmint& operator-=(const mint& m) { if ((val -= m.val) < 0) val += MOD; return *this; }",
