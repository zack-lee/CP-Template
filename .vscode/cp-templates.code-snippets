      "struct maxQueue {",
      "    queue<int> q;",
      "    deque<int> dq;",
      "    void push(int v) {",
      "        q.push(v);",
      "        if(q.empty()) {dq.push_back(v); return;}",
      "        while(!dq.empty() && dq.back() < v) dq.pop_back();",
      "        dq.push_back(v);",
      "    }",
