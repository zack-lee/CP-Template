  "content/strings/Lightweight/LyndonFactorization.h": {
    "scope": "cpp,c",
    "prefix": "LyndonFactorization",
    "body": [
      "/**",
      " * Description: ",
      "\t* A string is \"simple\" if it is strictly smaller than any of its own nontrivial suffixes.",
      "\t* The Lyndon factorization of the string \\$s\\$ is a factorization \\$s=w_1w_2\\\\ldots w_k\\$",
      "\t* where all strings \\$w_i\\$ are simple and \\$w_1\\\\ge w_2\\\\ge \\\\cdots \\\\ge w_k\\$",
      " * Source: https://cp-algorithms.com/string/lyndon_factorization.html",
      " * Time: O(N)",
      " * Verification: https://uva.onlinejudge.org/index.php?option=onlinejudge&page=show_problem&problem=660",
      " */",
      "",
      "vector<string> duval(const string& s) {",
      "\tint n = sz(s); vector<string> factors;",
      "\tfor (int i = 0; i < n; ) {",
      "\t\tint j = i + 1, k = i;",
      "\t\tfor (; j < n && s[k] <= s[j]; j++) {",
      "\t\t\tif (s[k] < s[j]) k = i;",
      "\t\t\telse k ++;",
      "\t\t}",
      "\t\tfor (; i <= k; i += j-k) factors.pb(s.substr(i, j-k));",
      "\t}",
      "\treturn factors;",
      "}",
      "",
      "int minRotation(string s) { // get min index i such that cyclic shift starting at i is min rotation",
      "\tint n = sz(s); s += s;",
      "\tauto d = duval(s); int ind = 0, ans = 0;",
      "\twhile (ans+sz(d[ind]) < n) ans += sz(d[ind++]);",
      "\twhile (ind && d[ind] == d[ind-1]) ans -= sz(d[ind--]);",
      "\treturn ans;",
      "}"
    ],
    "description": "strings/Lightweight/LyndonFactorization.h"
  },
  "content/strings/Lightweight/Manacher.h": {
    "scope": "cpp,c",
    "prefix": "Manacher",
    "body": [
      "/**",
      " * Source: http://codeforces.com/blog/entry/12143",
      " * Time: O(N)",
      " * Description: Calculates length of largest palindrome centered at each character of string",
      " * Verification: http://www.spoj.com/problems/MSUBSTR/",
      " */",
      "",
      "vi manacher(string s) {",
      "\tstring s1 = \"@\";",
      "\ttrav(c,s) s1 += c, s1 += \"#\";",
      "\ts1[sz(s1)-1] = '&';",
      "",
      "\tvi ans(sz(s1)-1);",
      "\tint lo = 0, hi = 0;",
      "\tFOR(i,1,sz(s1)-1) {",
      "\t\tif (i != 1) ans[i] = min(hi-i,ans[hi-i+lo]);",
      "\t\twhile (s1[i-ans[i]-1] == s1[i+ans[i]+1]) ans[i] ++;",
      "\t\tif (i+ans[i] > hi) lo = i-ans[i], hi = i+ans[i];",
      "\t}",
      "",
      "\tans.erase(begin(ans));",
      "\tF0R(i,sz(ans)) if ((i&1) == (ans[i]&1)) ans[i] ++; // adjust lengths",
      "\treturn ans;",
      "} ",
      "// ps(manacher(\"abacaba\"))"
    ],
    "description": "strings/Lightweight/Manacher.h"
  },
  "content/strings/Lightweight/MinRotation.h": {
    "scope": "cpp,c",
    "prefix": "MinRotation",
    "body": [
      "/**",
      " * Description: minimum rotation of string",
      " * Time: O(N)",
      " * Source: KACTL",
      " * Verification: https://cses.fi/problemset/task/1110/",
      " */",
      " ",
      "int minRotation(string s) {",
      "\tint a = 0, N = sz(s); s += s;",
      "\tF0R(b,N) F0R(i,N) { // a is current best rotation found up to b-1",
      "\t\tif (a+i == b || s[a+i] < s[b+i]) { b += max(0, i-1); break; } // b to b+i-1 can't be better than a to a+i-1",
      "\t\tif (s[a+i] > s[b+i]) { a = b; break; } // new best found",
      "\t}",
      "\treturn a;",
      "}"
    ],
