      "#include \"Point.h\"",
      "",
      "pair<P,T> ccCenter(P a, P b, P c) { ",
      "\tb -= a; c -= a;",
      "\tP res = b*c*(conj(c)-conj(b))/(b*conj(c)-conj(b)*c);",
