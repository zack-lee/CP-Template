  "content/strings/Lightweight/Z.h": {
    "scope": "cpp,c",
    "prefix": "Z",
    "body": [
      "/**",
      " * Source: http://codeforces.com/blog/entry/3107",
      " * Time: O(N)",
      " * Description: for each index \\$i\\$, computes the the maximum \\$len\\$ such that",
      " \t* \\\\texttt{s.substr(0,len) == s.substr(i,len)}",
      " * Verification: POI 12 Template, https://codeforces.com/contest/1137/problem/B",
      " */",
      "",
      "vi z(string s) {",
      "\tint N = sz(s); s += '#';",
      "\tvi ans(N); ans[0] = N; ",
      "\tint L = 1, R = 0;",
      "\tFOR(i,1,N) {",
      "\t\tif (i <= R) ans[i] = min(R-i+1,ans[i-L]);",
      "\t\twhile (s[i+ans[i]] == s[ans[i]]) ans[i] ++;",
      "\t\tif (i+ans[i]-1 > R) L = i, R = i+ans[i]-1;",
      "\t}",
      "\treturn ans;",
      "}",
      "",
      "vi getPrefix(string a, string b) { // find prefixes of a in b",
      "\tvi t = z(a+b), T(sz(b));",
      "\tF0R(i,sz(T)) T[i] = min(t[i+sz(a)],sz(a));",
      "\treturn T;",
      "}",
      "",
      "// pr(z(\"abcababcabcaba\"),getPrefix(\"abcab\",\"uwetrabcerabcab\"));"
    ],
    "description": "strings/Lightweight/Z.h"
  },
  "content/nt/DiscreteLog.h": {
    "scope": "cpp,c",
    "prefix": "DiscreteLog",
    "body": [
      "/**",
      " * Description: find least integer p such that r^p=x(mod m)",
      "\t* meet in the middle: O(sqrt(mod)) per query",
      " * Source: Own",
      " * Verification: https://www.hackerrank.com/contests/infinitum11/challenges/discrete-logarithm/problem",
      " * Dependency: Modular Int",
      " */",
      "",
      "struct DiscreteLog {",
      "\tint mod, root, block;",
      "\tunordered_map<int,int> u;",
      "\tmi cur;",
      "",
      "\tint query(mi x) { ",
      "\t\tF0R(i,block) {",
      "\t\t\tif (u.count((int)x)) return i*block+u[(int)x];",
      "\t\t\tx *= cur;",
      "\t\t}",
      "\t\treturn -1;",
      "\t}",
      "",
      "\tvoid init(int m, int r) { // gcd(m,r) = 1",
      "\t\tmod = m; root = r; block = sqrt(mod)+1;",
      "\t\tu.clear(); ",
      "\t\tcur = mi(1,mod);",
      "\t\tF0R(i,block) {",
      "\t\t\tif (!u.count((int)cur)) u[(int)cur] = i;",
      "\t\t\tcur *= root;",
      "\t\t}",
      "\t\tcur = 1/cur;",
      "\t} ",
      "};"
    ],
    "description": "nt/DiscreteLog.h"
  },
  "content/nt/ModularArithmetic/ModFact.h": {
    "scope": "cpp,c",
    "prefix": "ModFact",
    "body": [
      "/**",
      " * Description: pre-compute factorial mod inverses for \\$MOD\\$, ",
      " \t* assumes \\$MOD\\$ is prime and \\$SZ < MOD\\$",
      " * Time: O(SZ)",
      " * Source: KACTL",
      " * Verification: https://dmoj.ca/problem/tle17c4p5",
      " */",
      "",
      "vi inv, fac, ifac;",
      "void genInv(int SZ) {",
      "\tinv.resize(SZ), fac.resize(SZ), ifac.resize(SZ);",
      "\tinv[1] = 1; FOR(i,2,SZ) inv[i] = MOD-MOD/i*inv[MOD%i]%MOD;",
      "\tfac[0] = ifac[0] = 1;",
      "\tFOR(i,1,SZ) {",
      "\t\tfac[i] = fac[i-1]*i%MOD;",
      "\t\tifac[i] = ifac[i-1]*inv[i]%MOD;",
      "\t}",
      "}"
    ],
