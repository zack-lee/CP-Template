  "content/geo/Circles/Circles.h": {
    "scope": "cpp,c",
    "prefix": "Circles",
    "body": [
      "/**",
      " * Description: misc operations with two circles",
      " * Source: Own",
      "\t* also see http://mathworld.wolfram.com/Circle-CircleIntersection.html",
      " * Verification: USACO Laser Cows, https://codefights.com/tournaments/s8thqrnQL2YPK7XQt/L",
      " */",
      "",
      "#include \"Point.h\"",
      "",
      "typedef pair<P,T> circ;",
      "bool on(circ x, P y) { return abs(y-x.f) == x.s; }",
      "bool in(circ x, P y) {\treturn abs(y-x.f) <= x.s; }",
      "T arcLength(circ x, P a, P b) {",
      "\tP d = (a-x.f)/(b-x.f);",
      "\treturn x.s*acos(d.f);",
      "}",
      " ",
      "P intersectPoint(circ x, circ y, int t = 0) { // assumes intersection points exist",
      "\tT d = abs(x.f-y.f); // distance between centers",
      "\tT theta = acos((x.s*x.s+d*d-y.s*y.s)/(2*x.s*d)); // law of cosines",
      "\tP tmp = (y.f-x.f)/d*x.s;",
      "\treturn x.f+tmp*dir(t == 0 ? theta : -theta);",
      "}",
      "T intersectArea(circ x, circ y) { // not thoroughly tested",
      "\tT d = abs(x.f-y.f), a = x.s, b = y.s; if (a < b) swap(a,b);",
      "\tif (d >= a+b) return 0;",
      "\tif (d <= a-b) return PI*b*b;",
      "\tauto ca = (a*a+d*d-b*b)/(2*a*d), cb = (b*b+d*d-a*a)/(2*b*d);",
      "\tauto s = (a+b+d)/2, h = 2*sqrt(s*(s-a)*(s-b)*(s-d))/d;",
      "\treturn a*a*acos(ca)+b*b*acos(cb)-d*h;",
      "}",
      "",
      "P tangent(P x, circ y, int t = 0) {",
      "\ty.s = abs(y.s); // abs needed because internal calls y.s < 0",
      "\tif (y.s == 0) return y.f;",
      "\tT d = abs(x-y.f);",
      "\tP a = pow(y.s/d,2)*(x-y.f)+y.f;",
      "\tP b = sqrt(d*d-y.s*y.s)/d*y.s*unit(x-y.f)*dir(PI/2); ",
      "\treturn t == 0 ? a+b : a-b;",
      "}",
      "vector<pair<P,P>> external(circ x, circ y) { // external tangents",
      "\tvector<pair<P,P>> v; ",
      "\tif (x.s == y.s) {",
      "\t\tP tmp = unit(x.f-y.f)*x.s*dir(PI/2);",
      "\t\tv.pb(mp(x.f+tmp,y.f+tmp));",
      "\t\tv.pb(mp(x.f-tmp,y.f-tmp));",
      "\t} else {",
      "\t\tP p = (y.s*x.f-x.s*y.f)/(y.s-x.s);",
      "\t\tF0R(i,2) v.pb({tangent(p,x,i),tangent(p,y,i)});",
      "\t}",
      "\treturn v;",
      "}",
      "vector<pair<P,P>> internal(circ x, circ y) { // internal tangents",
      "\tx.s *= -1; return external(x,y);",
      "}"
    ],
    "description": "geo/Circles/Circles.h"
  },
