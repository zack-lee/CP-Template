      "/**",
      " * Description: query max xor with some int in the trie",
      " * Source: CF Algorithms Gym",
      " * Verification: January Easy 2018 - Shubham and Subarray Xor",
      " */",
      "",
      "const int INF = 1e18;",
      "",
      "template<int MX, int MXBIT> struct Trie {",
      "\tint nex[MX][2], sz[MX], num = 0; // num is last node in trie",
      "\t// change 2 to 26 for lowercase letters",
      "\tTrie() {",
      "\t\tmemset(nex,0,sizeof nex);",
      "\t\tmemset(sz,0,sizeof sz);",
      "\t}",
      "",
      "\tvoid ins(int x, int a = 1) { // insert or delete",
      "\t\tint cur = 0; sz[cur] += a;",
      "\t\tR0F(i,MXBIT) {",
      "\t\t\tint t = (x>>i)&1;",
      "\t\t\tif (!nex[cur][t]) nex[cur][t] = ++num;",
      "\t\t\tsz[cur = nex[cur][t]] += a;",
      "\t\t}",
      "\t}",
      "\tint test(int x) { // compute max xor",
      "\t\tif (!sz[0]) return -INF; // no elements in trie",
      "\t\tint cur = 0;",
      "\t\tR0F(i,MXBIT) {",
      "\t\t\tint t = ((x>>i)&1)^1;",
      "\t\t\tif (!nex[cur][t] || !sz[nex[cur][t]]) t ^= 1;",
      "\t\t\tcur = nex[cur][t]; if (t) x ^= 1LL<<i;",
      "\t\t}",
      "\t\treturn x;",
      "\t}",
