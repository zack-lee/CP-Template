  "content/ds/1D_Range/PerSegTree.h": {
    "scope": "cpp,c",
    "prefix": "PerSegTree",
    "body": [
      "/**",
      " * Description: persistent segtree with lazy updates, assumes that \\\\texttt{lazy[cur]} is ",
      " \t* included in \\\\texttt{val[cur]} before propagating \\\\texttt{cur}",
      " * Time: O(\\\\log N)",
      " * Source: CF, Franklyn Wang",
      " * Verification: https://codeforces.com/contest/1090/problem/G",
      " */ ",
      "",
      "const int INF = 1e18;",
      "",
      "template<class T, int SZ> struct pseg {",
      "\tstatic const int LIMIT = 10000000; // adjust",
      "\tint l[LIMIT], r[LIMIT], nex = 0;",
      "\tT val[LIMIT], lazy[LIMIT];",
      "\t",
      "\t//// HELPER",
      "\tint copy(int cur) {",
      "\t\tint x = nex++;",
      "\t\tval[x] = val[cur], l[x] = l[cur], r[x] = r[cur], lazy[x] = lazy[cur];",
      "\t\treturn x;",
      "\t}",
      "\tT comb(T a, T b) { return min(a,b); }",
      "\tvoid pull(int x) { val[x] = comb(val[l[x]],val[r[x]]); } ",
      "\tvoid push(int cur, int L, int R) { ",
      "\t\tif (!lazy[cur]) return;",
      "\t\tif (L != R) {",
      "\t\t\tl[cur] = copy(l[cur]);",
      "\t\t\tval[l[cur]] += lazy[cur];",
      "\t\t\tlazy[l[cur]] += lazy[cur];",
      "\t\t\t",
      "\t\t\tr[cur] = copy(r[cur]);",
      "\t\t\tval[r[cur]] += lazy[cur];",
      "\t\t\tlazy[r[cur]] += lazy[cur];",
      "\t\t}",
      "\t\tlazy[cur] = 0;",
      "\t}",
      "",
      "\t//// MAIN FUNCTIONS",
      "\tT query(int cur, int lo, int hi, int L, int R) {  ",
      "\t\tif (lo <= L && R <= hi) return val[cur];",
      "\t\tif (R < lo || hi < L) return INF;",
      "\t\tint M = (L+R)/2;",
      "\t\treturn lazy[cur]+comb(query(l[cur],lo,hi,L,M), query(r[cur],lo,hi,M+1,R));",
      "\t}",
      "\tint upd(int cur, int lo, int hi, T v, int L, int R) {",
      "\t\tif (R < lo || hi < L) return cur;",
      "\t\t",
      "\t\tint x = copy(cur);",
      "\t\tif (lo <= L && R <= hi) { val[x] += v, lazy[x] += v; return x; }",
      "\t\tpush(x,L,R);",
      "\t\t",
      "\t\tint M = (L+R)/2;",
      "\t\tl[x] = upd(l[x],lo,hi,v,L,M), r[x] = upd(r[x],lo,hi,v,M+1,R);",
      "\t\tpull(x); return x;",
      "\t}",
      "\tint build(vector<T>& arr, int L, int R) {",
      "\t\tint cur = nex++;",
      "\t\tif (L == R) {",
      "\t\t\tif (L < sz(arr)) val[cur] = arr[L];",
      "\t\t\treturn cur;",
      "\t\t}",
      "\t\t",
      "\t\tint M = (L+R)/2;",
      "\t\tl[cur] = build(arr,L,M), r[cur] = build(arr,M+1,R);",
      "\t\tpull(cur); return cur;",
      "\t}",
      "\t",
      "\t//// PUBLIC",
      "\tvi loc;",
      "\tvoid upd(int lo, int hi, T v) { loc.pb(upd(loc.back(),lo,hi,v,0,SZ-1)); }",
      "\tT query(int ti, int lo, int hi) { return query(loc[ti],lo,hi,0,SZ-1); }",
      "\tvoid build(vector<T>& arr) { loc.pb(build(arr,0,SZ-1)); }",
      "};"
    ],
    "description": "ds/1D_Range/PerSegTree.h"
  },
  "content/ds/1D_Range/RectangleUnion.h": {
    "scope": "cpp,c",
    "prefix": "RectangleUnion",
    "body": [
      "/**",
      " * Description: calculates area of union of rectangles in the form [x1,x2) x [y1,y2)",
      " * Source: Own",
      " * Verification: ",
      "\t* https://cses.fi/problemset/task/1741/",
      "\t* https://codeforces.com/problemset/problem/494/E",
      " */",
      "",
      "pi operator+(const pi& l, const pi& r) {",
      "\tif (l.f != r.f) return min(l,r);",
      "\treturn {l.f,l.s+r.s};",
      "}",
      "",
      "const int SZ = 1<<18;",
      "",
      "template<class T> struct LazySegTree { // stores min + # of mins",
      "\tT lazy[2*SZ]; // set SZ to a power of 2",
      "\tpair<T,int> mn[2*SZ];",
      "\tLazySegTree() {",
      "\t\tmemset(lazy,0,sizeof lazy);",
      "\t\tF0R(i,2*SZ) mn[i] = {0,0};",
      "\t}",
      "\t",
      "\tvoid push(int ind, int L, int R) {",
      "\t\tmn[ind].f += lazy[ind];",
      "\t\tif (L != R) lazy[2*ind] += lazy[ind], lazy[2*ind+1] += lazy[ind];",
      "\t\tlazy[ind] = 0;",
      "\t}",
      "\t",
      "\tvoid pull(int ind) { mn[ind] = mn[2*ind]+mn[2*ind+1]; }",
      "\tvoid build() { ROF(i,1,SZ) pull(i); }",
      "\t",
      "\tvoid upd(int lo, int hi, int inc, int ind = 1, int L = 0, int R = SZ-1) {",
      "\t\tpush(ind,L,R);",
      "\t\tif (hi < L || R < lo) return;",
      "\t\tif (lo <= L && R <= hi) {",
      "\t\t\tlazy[ind] = inc;",
      "\t\t\tpush(ind,L,R);",
      "\t\t\treturn;",
      "\t\t}",
      "\t\t",
      "\t\tint M = (L+R)/2;",
      "\t\tupd(lo,hi,inc,2*ind,L,M); upd(lo,hi,inc,2*ind+1,M+1,R);",
      "\t\tpull(ind);",
      "\t}",
      "};",
      "",
      "int area(vector<pair<pi,pi>> v) { // area of union of rectangles",
      "\tLazySegTree<int> L;",
      "\tvi y; trav(t,v) y.pb(t.s.f), y.pb(t.s.s);",
      "\tsort(all(y)); y.erase(unique(all(y)),y.end());",
      "\tF0R(i,sz(y)-1) L.mn[SZ+i].s = y[i+1]-y[i]; // compress coordinates",
      "\tL.build();",
      "",
      "\tvector<array<int,4>> ev; // sweep line",
      "\ttrav(t,v) {",
      "\t\tt.s.f = lower_bound(all(y),t.s.f)-begin(y);",
      "\t\tt.s.s = lower_bound(all(y),t.s.s)-begin(y)-1;",
      "\t\tev.pb({t.f.f,1,t.s.f,t.s.s});",
      "\t\tev.pb({t.f.s,-1,t.s.f,t.s.s});",
      "\t}",
      "\tsort(all(ev));",
      "",
      "\tint ans = 0;",
      "\tF0R(i,sz(ev)-1) {",
      "\t\tconst auto& t = ev[i];",
      "\t\tL.upd(t[2],t[3],t[1]);",
      "\t\tint len = y.back()-y.front()-L.mn[1].s; // L.mn[0].f should equal 0",
      "\t\tans += (int)(ev[i+1][0]-t[0])*len;",
      "\t}",
      "\treturn ans;",
      "}"
    ],
