      "/**",
      " * Description: Chinese Remainder Theorem",
      " * Source: Own",
      " * Verification: Kattis generalchineseremainder",
      " */",
      "",
      "#include \"Euclid.h\"",
      "",
      "pi solve(pi a, pi b) {",
      "\tauto g = __gcd(a.s,b.s), l = a.s/g*b.s;",
      "\tif ((b.f-a.f) % g != 0) return {-1,-1};",
      "\tauto A = a.s/g, B = b.s/g;",
      "\tauto mul = (b.f-a.f)/g*invGeneral(A,B) % B;",
      "\treturn {((mul*a.s+a.f)%l+l)%l,l};",
      "}"
    ],
