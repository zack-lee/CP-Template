  "content/strings/Lightweight/KMP.h": {
    "scope": "cpp,c",
    "prefix": "KMP",
    "body": [
      "/**",
      " * Source: KACTL",
      " * Time: O(N)",
      " * Description: \\\\texttt{f[i]} equals the length of the longest proper suffix ",
      " \t* of the \\$i\\$-th prefix of \\$s\\$ that is a prefix of \\$s\\$",
      " * Verification: https://open.kattis.com/problems/stringmatching",
      " */",
      "",
      "vi kmp(string s) {",
      "\tint N = sz(s); vi f(N+1); f[0] = -1;",
      "\tFOR(i,1,N+1) {",
      "\t\tf[i] = f[i-1];",
      "\t\twhile (f[i] != -1 && s[f[i]] != s[i-1]) f[i] = f[f[i]];",
      "\t\tf[i] ++;",
      "\t}",
      "\treturn f;",
      "}",
      "",
      "vi getOc(string a, string b) { // find occurrences of a in b",
      "\tvi f = kmp(a+\"@\"+b), ret;",
      "\tFOR(i,sz(a),sz(b)+1) if (f[i+sz(a)+1] == sz(a)) ret.pb(i-sz(a));",
      "\treturn ret;",
      "}"
    ],
    "description": "strings/Lightweight/KMP.h"
