  "content/graph/Matching/Hungarian.h": {
    "scope": "cpp,c",
    "prefix": "Hungarian",
    "body": [
      "/**",
      " * Description: finds min cost to complete n jobs w/ m workers ",
      "\t* each worker is assigned to at most one job (n <= m)",
      " * Time: ?",
      " * Source: https://github.com/mpfeifer1/Kattis/blob/master/cordonbleu.cpp",
      " * Verification: https://www.spoj.com/problems/BABY/",
      "\t* also see https://codeforces.com/blog/entry/63701",
      " */",
      "",
      "int HungarianMatch(const vector<vi>& a) { // cost array, negative values are ok",
      "\tint n = sz(a)-1, m = sz(a[0])-1; // jobs 1..n, workers 1..m",
      "\tvi u(n+1), v(m+1), p(m+1); // p[j] -> job picked by worker j",
      "\tFOR(i,1,n+1) { // find alternating path with job i",
      "\t\tp[0] = i; int j0 = 0;",
      "\t\tvi dist(m+1, MOD), pre(m+1,-1); // dist, previous vertex on shortest path",
      "\t\tvector<bool> done(m+1, false);",
      "\t\tdo {",
      "\t\t\tdone[j0] = true;",
      "\t\t\tint i0 = p[j0], j1; int delta = MOD;",
      "\t\t\tFOR(j,1,m+1) if (!done[j]) {",
      "\t\t\t\tauto cur = a[i0][j]-u[i0]-v[j];",
      "\t\t\t\tif (cur < dist[j]) dist[j] = cur, pre[j] = j0;",
      "\t\t\t\tif (dist[j] < delta) delta = dist[j], j1 = j;",
      "\t\t\t}",
      "\t\t\tF0R(j,m+1) // just dijkstra with potentials",
      "\t\t\t\tif (done[j]) u[p[j]] += delta, v[j] -= delta;",
      "\t\t\t\telse dist[j] -= delta;",
      "\t\t\tj0 = j1;",
      "\t\t} while (p[j0]);",
      "\t\tdo { // update values on alternating path",
      "\t\t\tint j1 = pre[j0];",
      "\t\t\tp[j0] = p[j1];",
      "\t\t\tj0 = j1;",
      "\t\t} while (j0);",
      "\t}",
      "\treturn -v[0]; // min cost",
      "}"
    ],
    "description": "graph/Matching/Hungarian.h"
  },
  "content/graph/Matching/UnweightedMatch.h": {
    "scope": "cpp,c",
    "prefix": "UnweightedMatch",
    "body": [
      "/**",
      " * Description: general unweighted matching",
      " * Time: ?",
      " * Source: ",
      "\t* https://github.com/koosaga/DeobureoMinkyuParty",
      "\t* https://www-m9.ma.tum.de/graph-algorithms/matchings-blossom-algorithm/index_en.html",
      " * Verification: https://codeforces.com/contest/1089/problem/B",
      " */",
      "",
      "template<int SZ> struct UnweightedMatch {",
      "\tint vis[SZ], par[SZ], orig[SZ], match[SZ], aux[SZ], t, N; // 1-based index",
      "\tvi adj[SZ];",
      "\tqueue<int> Q;",
      "\tvoid addEdge(int u, int v) {",
      "\t\tadj[u].pb(v); adj[v].pb(u);",
      "\t}",
      "\t",
      "\tvoid init(int n) {",
      "\t\tN = n; t = 0;",
      "\t\tF0R(i,N+1) {",
      "\t\t\tadj[i].clear();",
      "\t\t\tmatch[i] = aux[i] = par[i] = 0;",
      "\t\t}",
      "\t}",
      "\t",
      "\tvoid augment(int u, int v) {",
      "\t\tint pv = v, nv;",
      "\t\tdo {",
      "\t\t\tpv = par[v]; nv = match[pv];",
      "\t\t\tmatch[v] = pv; match[pv] = v;",
      "\t\t\tv = nv;",
      "\t\t} while(u != pv);",
      "\t}",
      "\t",
      "\tint lca(int v, int w) {",
      "\t\t++t;",
      "\t\twhile (1) {",
      "\t\t\tif (v) {",
      "\t\t\t\tif (aux[v] == t) return v; aux[v] = t;",
      "\t\t\t\tv = orig[par[match[v]]];",
      "\t\t\t}",
      "\t\t\tswap(v, w);",
      "\t\t}",
      "\t}",
      "\t",
      "\tvoid blossom(int v, int w, int a) {",
      "\t\twhile (orig[v] != a) {",
      "\t\t\tpar[v] = w; w = match[v];",
      "\t\t\tif (vis[w] == 1) Q.push(w), vis[w] = 0;",
      "\t\t\torig[v] = orig[w] = a;",
      "\t\t\tv = par[w];",
      "\t\t}",
      "\t}",
      "\t",
      "\tbool bfs(int u) {",
      "\t\tfill(vis+1, vis+1+N, -1); iota(orig + 1, orig + N + 1, 1);",
      "\t\tQ = queue<int> (); Q.push(u); vis[u] = 0;",
      "\t\twhile (sz(Q)) {",
      "\t\t\tint v = Q.front(); Q.pop();",
      "\t\t\ttrav(x,adj[v]) {",
      "\t\t\t\tif (vis[x] == -1) {",
      "\t\t\t\t\tpar[x] = v; vis[x] = 1;",
      "\t\t\t\t\tif (!match[x]) return augment(u, x), true;",
      "\t\t\t\t\tQ.push(match[x]); vis[match[x]] = 0;",
      "\t\t\t\t} else if (vis[x] == 0 && orig[v] != orig[x]) {",
      "\t\t\t\t\tint a = lca(orig[v], orig[x]);",
      "\t\t\t\t\tblossom(x, v, a); blossom(v, x, a);",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t\treturn false;",
      "\t}",
      "\t",
      "\tint match() {",
      "\t\tint ans = 0;",
      "\t\t// find random matching (not necessary, constant improvement)",
      "\t\tvi V(N-1); iota(all(V), 1);",
      "\t\tshuffle(all(V), mt19937(0x94949));",
      "\t\ttrav(x,V) if(!match[x]) ",
      "\t\t\ttrav(y,adj[x]) if (!match[y]) {",
      "\t\t\t\tmatch[x] = y, match[y] = x;",
      "\t\t\t\t++ans; break;",
      "\t\t\t}",
      "\t\t\t",
      "\t\tFOR(i,1,N+1) if (!match[i] && bfs(i)) ++ans;",
      "\t\treturn ans;",
      "\t}",
      "};"
    ],
    "description": "graph/Matching/UnweightedMatch.h"
  },
  "content/graph/Misc/DirectedMST.h": {
    "scope": "cpp,c",
    "prefix": "DirectedMST",
    "body": [
      "/**",
      " * Description: computes minimum weight directed spanning tree, ",
      " \t* edge from \\$inv[i]\\\\to i\\$ for all \\$i\\\\neq r\\$",
      " * Time: O(M\\\\log M)",
      " * Source: KACTL",
      " \t* https://courses.cs.washington.edu/courses/cse490u/17wi/slides/CLE.pdf",
      " * Verification: ",
      " \t* https://open.kattis.com/problems/fastestspeedrun",
      " \t* https://codeforces.com/problemset/problem/240/E",
      " */",
      "",
      "#include \"DSUrb.h\"",
      "",
      "struct Edge { int a, b; int w; };",
      "struct Node { /// lazy skew heap node",
      "\tEdge key;",
      "\tNode *l, *r;",
      "\tint delta;",
      "\tvoid prop() {",
      "\t\tkey.w += delta;",
      "\t\tif (l) l->delta += delta;",
      "\t\tif (r) r->delta += delta;",
      "\t\tdelta = 0;",
      "\t}",
      "\tEdge top() { prop(); return key; }",
      "};",
      "Node *merge(Node *a, Node *b) {",
      "\tif (!a || !b) return a ?: b;",
      "\ta->prop(), b->prop();",
      "\tif (a->key.w > b->key.w) swap(a, b);",
      "\tswap(a->l, (a->r = merge(b, a->r)));",
      "\treturn a;",
      "}",
      "void pop(Node*& a) { a->prop(); a = merge(a->l, a->r); }",
      "",
      "pair<int,vi> dmst(int n, int r, const vector<Edge>& g) {",
      "\tDSUrb dsu; dsu.init(n); // DSU with rollback if need to return edges",
      "\tvector<Node*> heap(n); // store edges entering each vertex in increasing order of weight",
      "\ttrav(e,g) heap[e.b] = merge(heap[e.b], new Node{e});",
      "\tint res = 0; vi seen(n,-1); seen[r] = r;",
      "\tvpi in(n,{-1,-1});",
      "\tvector<pair<int,vector<Edge>>> cycs;",
      "\tF0R(s,n) {",
      "\t\tint u = s, w;",
      "\t\tvector<pair<int,Edge>> path; ",
      "\t\twhile (seen[u] < 0) {",
      "\t\t\tif (!heap[u]) return {-1,{}};",
      "\t\t\tseen[u] = s;",
      "\t\t\tEdge e = heap[u]->top(); path.pb({u,e}); ",
      "\t\t\theap[u]->delta -= e.w, pop(heap[u]);",
      "\t\t\tres += e.w, u = dsu.get(e.a); ",
      "\t\t\tif (seen[u] == s) { // compress verts in cycle",
      "\t\t\t\tNode* cyc = 0; cycs.pb({u,{}});",
      "\t\t\t\tdo {",
      "\t\t\t\t\tcyc = merge(cyc, heap[w = path.back().f]);",
      "\t\t\t\t\tcycs.back().s.pb(path.back().s);",
      "\t\t\t\t\tpath.pop_back(); ",
      "\t\t\t\t} while (dsu.unite(u, w));",
      "\t\t\t\tu = dsu.get(u); heap[u] = cyc, seen[u] = -1;",
      "\t\t\t}",
      "\t\t}",
      "\t\ttrav(t,path) in[dsu.get(t.s.b)] = {t.s.a,t.s.b}; // found path from root",
      "\t}",
      "\twhile (sz(cycs)) { // expand cycs to restore sol",
      "\t\tauto c = cycs.back(); cycs.pop_back();",
      "\t\tpi inEdge = in[c.f];",
      "\t\ttrav(t,c.s) dsu.rollback();",
      "\t\ttrav(t,c.s) in[dsu.get(t.b)] = {t.a,t.b};",
      "\t\tin[dsu.get(inEdge.s)] = inEdge;",
      "\t}",
      "\tvi inv; ",
      "\tF0R(i,n) { ",
      "\t\tassert(i == r ? in[i].s == -1 : in[i].s == i);",
      "\t\tinv.pb(in[i].f); ",
      "\t} ",
      "\treturn {res,inv};",
      "}"
    ],
    "description": "graph/Misc/DirectedMST.h"
  },
  "content/graph/Misc/DirectedMstKACTL.h": {
    "scope": "cpp,c",
    "prefix": "DirectedMstKACTL",
    "body": [
      "/**",
      " * Description: computes weight of minimum directed spanning tree",
      " * Time: O(M\\\\log M)",
      " * Source: KACTL",
      " \t* https://courses.cs.washington.edu/courses/cse490u/17wi/slides/CLE.pdf",
      " * Verification: https://open.kattis.com/problems/fastestspeedrun",
      " */",
      "",
      "#include \"DSU.h\"",
      "",
      "struct Edge { int a, b; int w; };",
      "struct Node { /// lazy skew heap node",
      "\tEdge key;",
      "\tNode *l, *r;",
      "\tint delta;",
      "\tvoid prop() {",
      "\t\tkey.w += delta;",
      "\t\tif (l) l->delta += delta;",
      "\t\tif (r) r->delta += delta;",
      "\t\tdelta = 0;",
      "\t}",
      "\tEdge top() { prop(); return key; }",
      "};",
      "Node *merge(Node *a, Node *b) {",
      "\tif (!a || !b) return a ?: b;",
      "\ta->prop(), b->prop();",
      "\tif (a->key.w > b->key.w) swap(a, b);",
      "\tswap(a->l, (a->r = merge(b, a->r)));",
      "\treturn a;",
      "}",
      "void pop(Node*& a) { a->prop(); a = merge(a->l, a->r); }",
      "",
      "int dmst(int n, int r, vector<Edge>& g) {",
      "\tDSU dsu; dsu.init(n);",
      "\tvector<Node*> heap(n);",
      "\ttrav(e, g) heap[e.b] = merge(heap[e.b], new Node{e});",
      "\tint res = 0;",
      "\tvi seen(n, -1), path(n); seen[r] = r;",
      "\tF0R(s,n) {",
      "\t\tint u = s, qi = 0, w;",
      "\t\twhile (seen[u] < 0) {",
      "\t\t\tpath[qi++] = u, seen[u] = s;",
      "\t\t\tif (!heap[u]) return -1;",
      "\t\t\tEdge e = heap[u]->top();",
      "\t\t\theap[u]->delta -= e.w, pop(heap[u]);",
      "\t\t\tres += e.w, u = dsu.get(e.a);",
      "\t\t\tif (seen[u] == s) {",
      "\t\t\t\tNode* cyc = 0;",
      "\t\t\t\tdo cyc = merge(cyc, heap[w = path[--qi]]);",
      "\t\t\t\twhile (dsu.unite(u, w));",
      "\t\t\t\tu = dsu.get(u);",
      "\t\t\t\theap[u] = cyc, seen[u] = -1;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn res;",
      "}"
    ],
    "description": "graph/Misc/DirectedMstKACTL.h"
  },
  "content/graph/Misc/DominatorTree.h": {
    "scope": "cpp,c",
    "prefix": "DominatorTree",
    "body": [
      "/**",
      " * Description: \\$a\\$ dominates \\$b\\$ iff every path from \\$1\\$ to \\$b\\$ passes through \\$a\\$",
      " * Time: O(M\\\\log N)",
      " * Source: https://tanujkhattar.wordpress.com/2016/01/11/dominator-tree-of-a-directed-graph/",
      " * Verification: https://codeforces.com/gym/100513/problem/L",
      " */",
      "",
      "template<int SZ> struct Dominator {",
      "\tvi adj[SZ], ans[SZ]; // input edges, edges of dominator tree",
      "\tvi radj[SZ], child[SZ], sdomChild[SZ];",
      "\tint label[SZ], rlabel[SZ], sdom[SZ], dom[SZ], co;",
      "\tint root = 1;",
      "\t",
      "\tint par[SZ], bes[SZ]; ",
      "\tint get(int x) { ",
      "\t\t// DSU with path compression",
      "\t\t// get vertex with smallest sdom on path to root",
      "\t\tif (par[x] != x) {",
      "\t\t\tint t = get(par[x]); par[x] = par[par[x]];",
      "\t\t\tif (sdom[t] < sdom[bes[x]]) bes[x] = t;",
      "\t\t}",
      "\t\treturn bes[x];",
      "\t} ",
      "\t",
      "\tvoid dfs(int x) { // create DFS tree",
      "\t\tlabel[x] = ++co; rlabel[co] = x; ",
      "\t\tsdom[co] = par[co] = bes[co] = co;",
      "\t\ttrav(y,adj[x]) {",
      "\t\t\tif (!label[y]) {",
      "\t\t\t\tdfs(y); ",
      "\t\t\t\tchild[label[x]].pb(label[y]);",
      "\t\t\t}",
      "\t\t\tradj[label[y]].pb(label[x]);",
      "\t\t}",
      "\t}",
      "\tvoid init() {",
      "\t\tdfs(root);",
      "\t\tROF(i,1,co+1) {",
      "\t\t\ttrav(j,radj[i]) ckmin(sdom[i],sdom[get(j)]);",
      "\t\t\tif (i > 1) sdomChild[sdom[i]].pb(i);",
      "\t\t\ttrav(j,sdomChild[i]) {",
      "\t\t\t\tint k = get(j);",
      "\t\t\t\tif (sdom[j] == sdom[k]) dom[j] = sdom[j];",
      "\t\t\t\telse dom[j] = k;",
      "\t\t\t}",
      "\t\t\ttrav(j,child[i]) par[j] = i;",
      "\t\t}",
      "\t\tFOR(i,2,co+1) {",
      "\t\t\tif (dom[i] != sdom[i]) dom[i] = dom[dom[i]];",
      "\t\t\tans[rlabel[dom[i]]].pb(rlabel[i]);",
      "\t\t}",
      "\t}",
      "};"
    ],
    "description": "graph/Misc/DominatorTree.h"
  },
  "content/graph/Misc/EdgeColor.h": {
    "scope": "cpp,c",
    "prefix": "EdgeColor",
    "body": [
      "/**",
      " * Description: naive implementation of Misra \\\\& Gries edge coloring, ",
      " * by Vizing's Theorem a simple graph with max degree \\$d\\$ can be ",
      " * edge colored with at most \\$d+1\\$ colors ",
      " * Time: O(MN^2)",
      " * Source: ",
      "\t* https://en.m.wikipedia.org/wiki/Vizing%27s_theorem ",
      "\t* https://en.wikipedia.org/wiki/Misra_%26_Gries_edge_coloring_algorithm",
      " * Verification: https://open.kattis.com/problems/gamescheduling",
      " */",
      " ",
      "template<int SZ> struct EdgeColor {",
      "\tint N = 0, maxDeg = 0, adj[SZ][SZ], deg[SZ];",
      "\tEdgeColor() { ",
      "\t\tmemset(adj,0,sizeof adj); ",
      "\t\tmemset(deg,0,sizeof deg);",
      "\t}",
      "\tvoid addEdge(int a, int b, int c) { ",
      "\t\tadj[a][b] = adj[b][a] = c; ",
      "\t}",
      "\tint delEdge(int a, int b) {",
      "\t\tint c = adj[a][b]; ",
      "\t\tadj[a][b] = adj[b][a] = 0;",
      "\t\treturn c;",
      "\t}",
      "\tvector<bool> genCol(int x) { ",
      "\t\tvector<bool> col(N+1); F0R(i,N) col[adj[x][i]] = 1;",
      "\t\treturn col;",
      "\t}",
      "\tint freeCol(int u) {",
      "\t\tauto col = genCol(u);",
      "\t\tint x = 1; while (col[x]) x ++; return x;",
      "\t}",
      "\tvoid invert(int x, int d, int c) {",
      "\t\tF0R(i,N) if (adj[x][i] == d) ",
      "\t\t\tdelEdge(x,i), invert(i,c,d), addEdge(x,i,c);",
      "\t}",
      "\tvoid addEdge(int u, int v) { // follows wikipedia steps",
      "\t\t// check if you can add edge w/o doing any work",
      "\t\tassert(N); ckmax(maxDeg,max(++deg[u],++deg[v]));",
      "\t\tauto a = genCol(u), b = genCol(v);",
      "\t\tFOR(i,1,maxDeg+2) if (!a[i] && !b[i]) return addEdge(u,v,i); ",
      "",
      "\t\t// 2. find maximal fan of u starting at v",
      "\t\tvector<bool> use(N); vi fan = {v}; use[v] = 1;",
      "\t\twhile (1) {",
      "\t\t\tauto col = genCol(fan.back());",
      "\t\t\tif (sz(fan) > 1) col[adj[fan.back()][u]] = 0;",
      "\t\t\tint i = 0; while (i < N && (use[i] || col[adj[u][i]])) i ++;",
      "\t\t\tif (i < N) fan.pb(i), use[i] = 1;",
      "\t\t\telse break;",
      "\t\t} ",
      "",
      "\t\t// 3/4. choose free cols for endpoints of fan, invert cd_u path",
      "\t\tint c = freeCol(u), d = freeCol(fan.back()); invert(u,d,c); ",
      "\t\t// 5. find i such that d is free on fan[i]",
      "\t\tint i = 0; while (i < sz(fan) && genCol(fan[i])[d] ",
      "\t\t\t&& adj[u][fan[i]] != d) i ++; ",
      "\t\tassert (i != sz(fan));",
      "\t\t// 6. rotate fan from 0 to i",
      "\t\tF0R(j,i) addEdge(u,fan[j],delEdge(u,fan[j+1]));",
      "\t\t// 7. add new edge",
      "\t\taddEdge(u,fan[i],d);",
      "\t}",
      "};"
    ],
    "description": "graph/Misc/EdgeColor.h"
  },
  "content/graph/Misc/LCT.h": {
    "scope": "cpp,c",
    "prefix": "LCT",
    "body": [
      "/**",
      " * Description: Link-Cut Tree, use \\\\texttt{vir} for subtree size queries",
      " * Time: O(\\\\log N)",
      " * Source: Dhruv Rohatgi, Eric Zhang,",
      "\t* https://sites.google.com/site/kc97ble/container/splay-tree/splaytree-cpp-3",
      " * Verification: Balanced Tokens, Dynamic Tree Test (Easy)",
      " */",
      "",
      "typedef struct snode* sn;",
      "",
      "struct snode {",
      "\t//////// VARIABLES",
      "\tsn p, c[2]; // parent, children",
      "\tint val; // value in node ",
      "\tint sum, mn, mx; // sum of values in subtree, min and max prefix sum ",
      "\tbool flip = 0; ",
      "\t// int vir = 0; stores sum of virtual children",
      "\t",
      "\tsnode(int v) {",
      "\t\tp = c[0] = c[1] = NULL;",
      "\t\tval = v; calc();",
      "\t}",
      "\t",
      "\tfriend int getSum(sn x) { return x?x->sum:0; }",
      "\tfriend int getMn(sn x) { return x?x->mn:0; }",
      "\tfriend int getMx(sn x) { return x?x->mx:0; }",
      "\t",
      "\tvoid prop() {",
      "\t\tif (!flip) return;",
      "\t\tswap(c[0],c[1]); tie(mn,mx) = mp(sum-mx,sum-mn);",
      "\t\tF0R(i,2) if (c[i]) c[i]->flip ^= 1;",
      "\t\tflip = 0; ",
      "\t}",
      "\tvoid calc() { ",
      "\t\tF0R(i,2) if (c[i]) c[i]->prop();",
      "\t\tint s0 = getSum(c[0]), s1 = getSum(c[1]); sum = s0+val+s1; // +vir",
      "\t\tmn = min(getMn(c[0]),s0+val+getMn(c[1]));",
      "\t\tmx = max(getMx(c[0]),s0+val+getMx(c[1]));",
      "\t}",
      "\t",
      "\t//////// SPLAY TREE OPERATIONS",
      "\tint dir() {",
      "\t\tif (!p) return -2;",
      "\t\tF0R(i,2) if (p->c[i] == this) return i;",
      "\t\treturn -1; // p is path-parent pointer, not in current splay tree",
      "\t}",
      "\tbool isRoot() { return dir() < 0; }",
      "\t",
      "\tfriend void setLink(sn x, sn y, int d) {",
      "\t\tif (y) y->p = x;",
      "\t\tif (d >= 0) x->c[d] = y;",
      "\t}",
      "\tvoid rot() { // assume p and p->p propagated",
      "\t\tassert(!isRoot()); int x = dir(); sn pa = p;",
      "\t\tsetLink(pa->p, this, pa->dir());",
      "\t\tsetLink(pa, c[x^1], x);",
      "\t\tsetLink(this, pa, x^1);",
      "\t\tpa->calc(); calc();",
      "\t}",
      "\tvoid splay() {",
      "\t\twhile (!isRoot() && !p->isRoot()) {",
      "\t\t\tp->p->prop(), p->prop(), prop();",
      "\t\t\tdir() == p->dir() ? p->rot() : rot();",
      "\t\t\trot();",
      "\t\t}",
      "\t\tif (!isRoot()) p->prop(), prop(), rot();",
      "\t\tprop();",
      "\t}",
      "",
      "\t//////// LINK CUT TREE BASE OPERATIONS",
      "\tvoid access() { // bring this to top of tree",
      "\t\tfor (sn v = this, pre = NULL; v; v = v->p) {",
      "\t\t\tv->splay(); ",
      "\t\t\t// if (pre) v->vir -= pre->sz;",
      "\t\t\t// if (v->c[1]) v->vir += v->c[1]->sz;",
      "\t\t\tv->c[1] = pre; v->calc();",
      "\t\t\tpre = v;",
      "\t\t\t// v->sz should remain the same if using vir",
      "\t\t}",
      "\t\tsplay(); assert(!c[1]); // left subtree of this is now path to root, right subtree is empty",
      "\t}",
      "\tvoid makeRoot() { access(); flip ^= 1; }",
      "\tvoid set(int v) { splay(); val = v; calc(); } // change value in node, splay suffices instead of access because it doesn't affect values in nodes above it",
      "\t",
      "\t//////// LINK CUT TREE QUERIES",
      "\tfriend sn lca(sn x, sn y) {",
      "\t\tif (x == y) return x;",
      "\t\tx->access(), y->access(); if (!x->p) return NULL; // access at y did not affect x, so they must not be connected",
      "\t\tx->splay(); return x->p ? x->p : x;",
      "\t}",
      "\tfriend bool connected(sn x, sn y) { return lca(x,y); }",
      "\tfriend int balanced(sn x, sn y) { ",
      "\t\tx->makeRoot(); y->access(); ",
      "\t\treturn y->sum-2*y->mn;",
      "\t}",
      "\t",
      "\t//////// LINK CUT TREE MODIFICATIONS",
      "\tfriend bool link(sn x, sn y) { // make x parent of y",
      "\t\tif (connected(x,y)) return 0; // don't induce cycle",
      "\t\ty->makeRoot(); y->p = x; ",
      "\t\t// x->access(); x->sz += y->sz; x->vir += y->sz;",
      "\t\treturn 1; // success!",
      "\t}",
      "\tfriend bool cut(sn x, sn y) { // x is originally parent of y",
      "\t\tx->makeRoot(); y->access(); ",
      "\t\tif (y->c[0] != x || x->c[0] || x->c[1]) return 0; // splay tree with y should not contain anything else besides x",
      "\t\tx->p = y->c[0] = NULL; y->calc(); return 1; // calc is redundant as it will be called elsewhere anyways?",
      "\t}",
      "};"
    ],
