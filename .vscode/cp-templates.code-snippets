  "content/num/Polynomials/VecOp.h": {
    "scope": "cpp,c",
    "prefix": "VecOp",
    "body": [
      "/**",
      " * Description: arithmetic + misc polynomial operations with vectors",
      " * Source: Own",
      " * Verification: see FFT",
      " */",
      "",
      "namespace VecOp {",
      "\ttemplate<class T> vector<T> rev(vector<T> v) { reverse(all(v)); return v; }",
      "\ttemplate<class T> vector<T> shift(vector<T> v, int x) { v.insert(v.begin(),x,0); return v; }",
      "\ttemplate<class T> vector<T> integ(const vector<T>& v)  {",
      "\t\tvector<T> res(sz(v)+1);",
      "\t\tF0R(i,sz(v)) res[i+1] = v[i]/(i+1);",
      "\t\treturn res;",
      "\t}",
      "\ttemplate<class T> vector<T> dif(const vector<T>& v)\t {",
      "\t\tif (!sz(v)) return v;",
      "\t\tvector<T> res(sz(v)-1); FOR(i,1,sz(v)) res[i-1] = i*v[i];",
      "\t\treturn res;",
      "\t}",
      "\ttemplate<class T> vector<T>& remLead(vector<T>& v) { ",
      "\t\twhile (sz(v) && v.back() == 0) v.pop_back();",
      "\t\treturn v;",
      "\t}",
      "\ttemplate<class T> T eval(const vector<T>& v, const T& x) {",
      "\t\tT res = 0; R0F(i,sz(v)) res = x*res+v[i];",
      "\t\treturn res;",
      "\t}",
      "\t",
      "\ttemplate<class T> vector<T>& operator+=(vector<T>& l, const vector<T>& r) {",
      "\t\tl.resize(max(sz(l),sz(r))); F0R(i,sz(r)) l[i] += r[i]; return l;",
      "\t}",
      "\ttemplate<class T> vector<T>& operator-=(vector<T>& l, const vector<T>& r) {",
      "\t\tl.resize(max(sz(l),sz(r))); F0R(i,sz(r)) l[i] -= r[i]; return l;",
      "\t}",
      "\ttemplate<class T> vector<T>& operator*=(vector<T>& l, const T& r) { trav(t,l) t *= r; return l;\t }",
      "\ttemplate<class T> vector<T>& operator/=(vector<T>& l, const T& r) { trav(t,l) t /= r; return l; }",
      "",
      "\ttemplate<class T> vector<T> operator+(vector<T> l, const vector<T>& r) { return l += r; }",
      "\ttemplate<class T> vector<T> operator-(vector<T> l, const vector<T>& r) { return l -= r; }",
      "\ttemplate<class T> vector<T> operator*(vector<T> l, const T& r) { return l *= r; }",
      "\ttemplate<class T> vector<T> operator*(const T& r, const vector<T>& l) { return l*r; }",
      "\ttemplate<class T> vector<T> operator/(vector<T> l, const T& r) { return l /= r;\t }",
      "",
      "\ttemplate<class T> vector<T> operator*(const vector<T>& l, const vector<T>& r) {",
      "\t\tif (min(sz(l),sz(r)) == 0) return {};",
      "\t\tvector<T> x(sz(l)+sz(r)-1); F0R(i,sz(l)) F0R(j,sz(r)) x[i+j] += l[i]*r[j];",
      "\t\treturn x;",
      "\t}",
      "\ttemplate<class T> vector<T>& operator*=(vector<T>& l, const vector<T>& r) { return l = l*r; }",
      "\t",
      "\ttemplate<class T> pair<vector<T>,vector<T>> qr(vector<T> a, vector<T> b) { // quotient and remainder",
      "\t\tassert(sz(b)); auto B = b.back(); assert(B != 0);",
      "\t\tB = 1/B; trav(t,b) t *= B;",
      "\t\t",
      "\t\tremLead(a); vector<T> q(max(sz(a)-sz(b)+1,0));",
      "\t\twhile (sz(a) >= sz(b)) {",
      "\t\t\tq[sz(a)-sz(b)] = a.back();",
      "\t\t\ta -= a.back()*shift(b,sz(a)-sz(b));",
      "\t\t\tremLead(a);",
      "\t\t}",
      "\t\t",
      "\t\ttrav(t,q) t *= B;",
      "\t\treturn {q,a};",
      "\t}",
      "\ttemplate<class T> vector<T> quo(const vector<T>& a, const vector<T>& b) { return qr(a,b).f; }",
      "\ttemplate<class T> vector<T> rem(const vector<T>& a, const vector<T>& b) { return qr(a,b).s; }",
      "\t",
      "\ttemplate<class T> vector<T> interpolate(vector<pair<T,T>> v) {",
      "\t\tvector<T> ret, prod = {1};",
      "\t\tF0R(i,sz(v)) prod *= vector<T>({-v[i].f,1});",
      "\t\tF0R(i,sz(v)) {",
      "\t\t\tT todiv = 1; F0R(j,sz(v)) if (i != j) todiv *= v[i].f-v[j].f;",
      "\t\t\tret += qr(prod,{-v[i].f,1}).f*(v[i].s/todiv);",
      "\t\t}",
      "\t\treturn ret;",
      "\t}",
      "}",
      "",
      "using namespace VecOp;"
    ],
    "description": "num/Polynomials/VecOp.h"
  },
