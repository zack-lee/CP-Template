      "/**",
      " * Description: Euclidean Algorithm",
      " * Source: KACTL",
      " */",
      "",
      "pi euclid(int a, int b) { // returns {x,y} such that a*x+b*y=gcd(a,b)",
      "\tif (!b) return {1,0};",
      "\tpi p = euclid(b,a%b);",
      "\treturn {p.s,p.f-a/b*p.s};",
      "}",
      "int invGeneral(int a, int b) {",
      "\tpi p = euclid(a,b); assert(p.f*a+p.s*b == 1);",
      "\treturn p.f+(p.f<0)*b;",
      "}"
