      "/**",
      " * Description: find sqrt of polynomial",
      " * Time: \\$O(N\\\\log N)?\\$",
      " */",
      "",
      "#include \"PolyInv.h\"",
      "",
      "template<class T> vector<T> sqrt(vector<T> v, int p) { // S*S = v mod x^p, p is power of 2",
      "    assert(v[0] == 1); if (p == 1) return {1};",
      "    v.resize(p);",
      "    auto S = sqrt(v,p/2);",
      "    auto ans = S+mult(v,inv(S,p));",
      "    ans.resize(p); ans *= T(1)/T(2);",
      "    return ans;",
      "}"
    ],
