  "content/graph/Flows/Dinic.h": {
    "scope": "cpp,c",
    "prefix": "Dinic",
    "body": [
      "/**",
      " * Description: faster flow",
      " * Time: \\$O(N^2M)\\$ flow, \\$O(M\\\\sqrt N)\\$ bipartite matching",
      " * Source: GeeksForGeeks, Chilli",
      " * Verification: RMI 2017 Day 1 Fashion",
      "\t* https://pastebin.com/VJxTvEg1",
      " */",
      "",
      "template<int SZ> struct Dinic {",
      "\ttypedef int F; // flow type",
      "\tstruct Edge { int to, rev; F flow, cap; };",
      "\t",
      "\tint N,s,t;",
      "\tvector<Edge> adj[SZ];",
      "\ttypename vector<Edge>::iterator cur[SZ];",
      "\tvoid addEdge(int u, int v, F cap) {",
      "\t\tassert(cap >= 0); // don't try smth dumb",
      "\t\tEdge a{v, sz(adj[v]), 0, cap}, b{u, sz(adj[u]), 0, 0};",
      "\t\tadj[u].pb(a), adj[v].pb(b);",
      "\t}",
      "",
      "\tint level[SZ];",
      "\tbool bfs() { // level = shortest distance from source",
      "\t\t// after computing flow, edges {u,v} such that level[u] \\\\neq -1, level[v] = -1 are part of min cut",
      "\t\tM00(i,N) level[i] = -1, cur[i] = begin(adj[i]);",
      "\t\tqueue<int> q({s}); level[s] = 0; ",
      "\t\twhile (sz(q)) {",
      "\t\t\tint u = q.front(); q.pop();",
      "            for(Edge e: adj[u]) if (level[e.to] < 0 && e.flow < e.cap)",
      "\t\t\t\tq.push(e.to), level[e.to] = level[u]+1;",
      "\t\t}",
      "\t\treturn level[t] >= 0;",
      "\t}",
      "\tF sendFlow(int v, F flow) {",
      "\t\tif (v == t) return flow;",
      "\t\tfor (; cur[v] != end(adj[v]); cur[v]++) {",
      "\t\t\tEdge& e = *cur[v];",
      "\t\t\tif (level[e.to] != level[v]+1 || e.flow == e.cap) continue;",
      "\t\t\tauto df = sendFlow(e.to,min(flow,e.cap-e.flow));",
      "\t\t\tif (df) { // saturated at least one edge",
      "\t\t\t\te.flow += df; adj[e.to][e.rev].flow -= df;",
      "\t\t\t\treturn df;",
      "\t\t\t}",
      "\t\t}",
      "\t\treturn 0;",
      "\t}",
      "\tF maxFlow(int _N, int _s, int _t) {",
      "\t\tN = _N, s = _s, t = _t; if (s == t) return -1;",
      "\t\tF tot = 0;",
      "\t\twhile (bfs()) while (auto df = sendFlow(s,numeric_limits<F>::max())) tot += df;",
      "\t\treturn tot;",
      "\t}",
      "};"
    ],
    "description": "graph/Flows/Dinic.h"
  },
  "content/graph/Flows/GomoryHu.h": {
    "scope": "cpp,c",
    "prefix": "GomoryHu",
    "body": [
      "/**",
      " * Description: Compute max flow between every pair of vertices of ",
      " * undirected graph",
      " * Source: Own",
      " * Verification: https://codeforces.com/problemset/problem/343/E",
      " */",
      "",
      "#include \"Dinic.h\"",
      "",
      "template<int SZ> struct GomoryHu {",
      "\tint N;",
      "\tvector<pair<pi,int>> ed;",
      "\tvoid addEdge(int a, int b, int c) { ed.pb({{a,b},c}); }",
      "",
      "\tvector<vi> cor = {{}}; // groups of vertices",
      "\tmap<int,int> adj[2*SZ]; // current edges of tree",
      "\tint side[SZ];",
      "",
      "\tint gen(vector<vi> cc) {",
      "\t\tDinic<SZ> D = Dinic<SZ>();",
      "\t\tvi comp(N+1); F0R(i,sz(cc)) trav(t,cc[i]) comp[t] = i;",
      "\t\ttrav(t,ed) if (comp[t.f.f] != comp[t.f.s]) {",
      "\t\t\tD.addEdge(comp[t.f.f],comp[t.f.s],t.s);",
      "\t\t\tD.addEdge(comp[t.f.s],comp[t.f.f],t.s);",
      "\t\t}",
      "\t\tint f = D.maxFlow(0,1); ",
      "\t\tF0R(i,sz(cc)) trav(j,cc[i]) side[j] = D.level[i] >= 0; // min cut",
      "\t\treturn f;",
      "\t}",
      "",
      "\tvoid fill(vi& v, int a, int b) {",
      "\t\ttrav(t,cor[a]) v.pb(t);",
      "\t\ttrav(t,adj[a]) if (t.f != b) fill(v,t.f,a);",
      "\t}",
      "",
      "\tvoid addTree(int a, int b, int c) { adj[a][b] = c, adj[b][a] = c; }",
      "\tvoid delTree(int a, int b) { adj[a].erase(b), adj[b].erase(a); }",
      "",
      "\tvector<pair<pi,int>> init(int _N) { // returns edges of Gomory-Hu Tree",
      "\t\tN = _N;",
      "\t\tFOR(i,1,N+1) cor[0].pb(i);",
      "\t\tqueue<int> todo; todo.push(0); ",
      "\t\twhile (sz(todo)) {",
      "\t\t\tint x = todo.front(); todo.pop();",
      "\t\t\tvector<vi> cc; trav(t,cor[x]) cc.pb({t});",
      "\t\t\ttrav(t,adj[x]) {",
      "\t\t\t\tcc.pb({});",
      "\t\t\t\tfill(cc.back(),t.f,x);",
      "\t\t\t}",
      "\t\t\tint f = gen(cc); // run max flow",
      "\t\t\tcor.pb({}), cor.pb({});",
      "\t\t\ttrav(t,cor[x]) cor[sz(cor)-2+side[t]].pb(t);",
      "\t\t\tF0R(i,2) if (sz(cor[sz(cor)-2+i]) > 1) todo.push(sz(cor)-2+i);",
      "\t\t\tF0R(i,sz(cor)-2) if (i != x && adj[i].count(x)) {",
      "\t\t\t\taddTree(i,sz(cor)-2+side[cor[i][0]],adj[i][x]);",
      "\t\t\t\tdelTree(i,x);",
      "\t\t\t} // modify tree edges",
      "\t\t\taddTree(sz(cor)-2,sz(cor)-1,f);",
      "\t\t}",
      "\t\tvector<pair<pi,int>> ans;",
      "\t\tF0R(i,sz(cor)) trav(j,adj[i]) if (i < j.f) ",
      "\t\t\tans.pb({{cor[i][0],cor[j.f][0]},j.s});",
      "\t\treturn ans;",
      "\t}",
      "};"
    ],
    "description": "graph/Flows/GomoryHu.h"
  },
  "content/graph/Flows/HLPP.h": {
    "scope": "cpp,c",
    "prefix": "HLPP",
    "body": [
      "/**",
      " * Description: Quickly calculate max flow",
      " * Source: https://gist.github.com/Chillee/ad2110fc17af453fb6fc3357a78cfd28#file-hlpp-cpp",
      " * Verification: https://www.spoj.com/problems/FASTFLOW/",
      " */",
      "",
      "template <int SZ> struct HLPP {",
      "\ttypedef int F; // flow type",
      "\tstruct Edge { int to, rev; F f; };",
      "\tconst F INF = numeric_limits<F>::max();",
      "\t",
      "\tint N,s,t;",
      "\tvector<Edge> adj[SZ];",
      "\tvoid addEdge(int u, int v, F cap) {",
      "\t\tassert(cap >= 0); // don't try smth dumb",
      "\t\tEdge a{v, sz(adj[v]), cap}, b{u, sz(adj[u]), 0};",
      "\t\tadj[u].pb(a), adj[v].pb(b);",
      "\t}",
      "",
      "\tvi lst[SZ], gap[SZ];",
      "\tF excess[SZ];",
      "\tint highest, height[SZ], cnt[SZ], work;",
      "\tvoid updHeight(int v, int nh) {",
      "\t\twork++;",
      "\t\tif (height[v] != N) cnt[height[v]]--;",
      "\t\theight[v] = nh;",
      "\t\tif (nh == N) return;",
      "\t\tcnt[nh]++, highest = nh;",
      "\t\tgap[nh].pb(v);",
      "\t\tif (excess[v] > 0) lst[nh].pb(v);",
      "\t}",
      "\tvoid globalRelabel() {",
      "\t\twork = 0;",
      "\t\tF0R(i,N) height[i] = N, cnt[i] = 0;",
      "\t\tF0R(i,highest) lst[i].clear(), gap[i].clear();",
      "\t\theight[t] = 0;",
      "\t\tqueue<int> q({t});",
      "\t\twhile (sz(q)) {",
      "\t\t\tint v = q.front(); q.pop();",
      "\t\t\ttrav(e,adj[v])",
      "\t\t\t\tif (height[e.to] == N && adj[e.to][e.rev].f > 0)",
      "\t\t\t\t\tq.push(e.to), updHeight(e.to, height[v] + 1);",
      "\t\t\thighest = height[v];",
      "\t\t}",
      "\t}",
      "\tvoid push(int v, Edge& e) {",
      "\t\tif (excess[e.to] == 0) lst[height[e.to]].pb(e.to);",
      "\t\tF df = min(excess[v], e.f);",
      "\t\te.f -= df, adj[e.to][e.rev].f += df;",
      "\t\texcess[v] -= df, excess[e.to] += df;",
      "\t}",
      "\tvoid discharge(int v) {",
      "\t\tint nh = N;",
      "\t\ttrav(e,adj[v]) {",
      "\t\t\tif (e.f > 0) {",
      "\t\t\t\tif (height[v] == height[e.to] + 1) {",
      "\t\t\t\t\tpush(v, e);",
      "\t\t\t\t\tif (excess[v] <= 0) return;",
      "\t\t\t\t} else ckmin(nh,height[e.to]+1);",
      "\t\t\t}",
      "\t\t}",
      "\t\tif (cnt[height[v]] > 1) updHeight(v, nh);",
      "\t\telse {",
      "\t\t\tFOR(i,height[v],highest+1) {",
      "\t\t\t\ttrav(j,gap[i]) updHeight(j, N);",
      "\t\t\t\tgap[i].clear();",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tF maxFlow(int _N, int _s, int _t) {",
      "\t\tN = _N, s = _s, t = _t; if (s == t) return -1;",
      "\t\tF0R(i,N) excess[i] = 0;",
      "\t\texcess[s] = INF, excess[t] = -INF;",
      "\t\tglobalRelabel();",
      "\t\ttrav(e,adj[s]) push(s,e);",
      "\t\tfor (; highest >= 0; highest--) ",
      "\t\t\twhile (sz(lst[highest])) {",
      "\t\t\t\tint v = lst[highest].back();",
      "\t\t\t\tlst[highest].pop_back();",
      "\t\t\t\tdischarge(v);",
      "\t\t\t\tif (work > 4*N) globalRelabel();",
      "\t\t\t}",
      "\t\treturn excess[t]+INF;",
      "\t}",
      "};"
    ],
    "description": "graph/Flows/HLPP.h"
  },
  "content/graph/Flows/MCMF.h": {
    "scope": "cpp,c",
    "prefix": "MCMF",
    "body": [
      "/**",
      " * Description: Min-Cost Max Flow, no negative cycles allowed",
      " * Time: O(NM^2\\\\log M)",
      " * Source: GeeksForGeeks",
      " * Verification: https://codeforces.com/contest/164/problem/C",
      " */",
      "",
      "template<class T> using pqg = priority_queue<T,vector<T>,greater<T>>;",
      "template<class T> T poll(pqg<T>& x) {",
      "\tT y = x.top(); x.pop();",
      "\treturn y;",
      "}",
      "",
      "template<int SZ> struct mcmf { ",
      "\ttypedef int F; typedef int C;",
      "\tstatic const int INF = 1e18;",
      "\tstruct Edge { int to, rev; F flow, cap; C cost; int id; };",
      "\tvector<Edge> adj[SZ];",
      "\tvoid addEdge(int u, int v, F cap, C cost) {",
      "\t\tassert(cap >= 0);",
      "\t\tEdge a{v, sz(adj[v]), 0, cap, cost}, b{u, sz(adj[u]), 0, 0, -cost};",
      "\t\tadj[u].pb(a), adj[v].pb(b);",
      "\t}",
      "",
      "\tint N, s, t;",
      "\tpi pre[SZ]; // previous vertex, edge label on path",
      "\tpair<C,F> cost[SZ]; // tot cost of path, amount of flow",
      "\tC totCost, curCost; F totFlow; ",
      "\tvoid reweight() { // makes all edge costs non-negative",
      "\t\t// all edges on shortest path become 0",
      "\t\tF0R(i,N) trav(p,adj[i]) p.cost += cost[i].f-cost[p.to].f;",
      "\t}",
      "\tbool spfa() { // reweight ensures that there will be negative weights ",
      "\t\t// only during the first time you run this",
      "\t\tF0R(i,N) cost[i] = {INF,0}; cost[s] = {0,INF};",
      "\t\tpqg<pair<C,int>> todo; todo.push({0,s});",
      "\t\twhile (sz(todo)) {",
      "\t\t\tauto x = poll(todo); if (x.f > cost[x.s].f) continue;",
      "\t\t\ttrav(a,adj[x.s]) if (x.f+a.cost < cost[a.to].f && a.flow < a.cap) { ",
      "\t\t\t\t// if costs are doubles, add some EPS to ensure that ",
      "\t\t\t\t// you do not traverse some 0-weight cycle repeatedly",
      "\t\t\t\tpre[a.to] = {x.s,a.rev};",
      "\t\t\t\tcost[a.to] = {x.f+a.cost,min(a.cap-a.flow,cost[x.s].s)};",
      "\t\t\t\ttodo.push({cost[a.to].f,a.to});",
      "\t\t\t}",
      "\t\t}",
      "\t\tcurCost += cost[t].f; return cost[t].s;",
      "\t}",
      "\tvoid backtrack() {",
      "\t\tF df = cost[t].s; totFlow += df, totCost += curCost*df;",
      "\t\tfor (int x = t; x != s; x = pre[x].f) {",
      "\t\t\tadj[x][pre[x].s].flow -= df;",
      "\t\t\tadj[pre[x].f][adj[x][pre[x].s].rev].flow += df;",
      "\t\t}",
      "\t}",
      "\tpair<F,C> calc(int _N, int _s, int _t) {",
      "\t\tN = _N; s = _s, t = _t; totFlow = totCost = curCost = 0;",
      "\t\twhile (spfa()) reweight(), backtrack();",
      "\t\treturn {totFlow, totCost};",
      "\t}",
      "};"
    ],
    "description": "graph/Flows/MCMF.h"
  },
  "content/geo/Misc/ClosestPair.h": {
    "scope": "cpp,c",
    "prefix": "ClosestPair",
    "body": [
      "/**",
      " * Description: line sweep to find two closest points ",
      " * Time: O(N\\\\log N)",
      " * Source: Own",
      " * Verification: https://open.kattis.com/problems/closestpair2",
      " */",
      "",
      "using namespace Point;",
      "const ld INF = 1e18;",
      "",
      "pair<P,P> solve(vP v) {",
      "\tpair<ld,pair<P,P>> bes; bes.f = INF;",
      "\tset<P> S; int ind = 0;",
      "\t",
      "\tsort(all(v));",
      "\tF0R(i,sz(v)) {",
      "\t\tif (i && v[i] == v[i-1]) return {v[i],v[i]};",
      "\t\tfor (; v[i].f-v[ind].f >= bes.f; ++ind) ",
      "\t\t\tS.erase({v[ind].s,v[ind].f});",
      "\t\tfor (auto it = S.upper_bound({v[i].s-bes.f,INF});",
      "\t\t\tit != end(S) && it->f < v[i].s+bes.f; ++it) {",
      "\t\t\tP t = {it->s,it->f};",
      "\t\t\tckmin(bes,{abs(t-v[i]),{t,v[i]}});",
      "\t\t}",
      "\t\tS.insert({v[i].s,v[i].f});",
      "\t}",
      "\t",
      "\treturn bes.s;",
      "}"
    ],
    "description": "geo/Misc/ClosestPair.h"
  },
  "content/geo/Misc/DelaunayFast.h": {
    "scope": "cpp,c",
    "prefix": "DelaunayFast",
    "body": [
      "/**",
      " * Description: Delaunay Triangulation, concyclic points are OK (but not all collinear)",
      " * Time: O(N\\\\log N)",
      " * Source: KACTL",
      " * Verification: CCO 2008 P6 Landing",
      " */",
      "",
      "#include \"Point.h\"",
      "",
      "typedef int T;",
      "",
      "typedef struct Quad* Q;",
      "typedef __int128_t lll; // (can be int if coords are < 2e4)",
      "P arb(LLONG_MAX,LLONG_MAX); // not equal to any other point",
      "",
      "struct Quad {",
      "\tbool mark; Q o, rot; P p;",
      "\tP F() { return r()->p; }",
      "\tQ r() { return rot->rot; }",
      "\tQ prev() { return rot->o->rot; }",
      "\tQ next() { return r()->prev(); }",
      "};",
      "",
      "// test if p is in the circumcircle",
      "bool circ(P p, P a, P b, P c) { ",
      "\tint ar = cross(a,b,c); assert(ar); if (ar < 0) swap(a,b);",
      "\tlll p2 = norm(p), A = norm(a)-p2,",
      "\t\tB = norm(b)-p2, C = norm(c)-p2;",
      "\treturn cross(p,a,b)*C+cross(p,b,c)*A+cross(p,c,a)*B > 0;",
      "}",
      "",
      "Q makeEdge(P orig, P dest) {",
      "\tQ q[] = {new Quad{0,0,0,orig}, new Quad{0,0,0,arb},",
      "\t\t\t new Quad{0,0,0,dest}, new Quad{0,0,0,arb}};",
      "\tF0R(i,4) q[i]->o = q[-i & 3], q[i]->rot = q[(i+1) & 3];",
      "\treturn *q;",
      "}",
      "void splice(Q a, Q b) {",
      "\tswap(a->o->rot->o, b->o->rot->o); swap(a->o, b->o);",
      "}",
      "Q connect(Q a, Q b) {",
      "\tQ q = makeEdge(a->F(), b->p);",
      "\tsplice(q, a->next());",
      "\tsplice(q->r(), b);",
      "\treturn q;",
      "}",
      "",
      "pair<Q,Q> rec(const vector<P>& s) {",
      "\tif (sz(s) <= 3) {",
      "\t\tQ a = makeEdge(s[0], s[1]), b = makeEdge(s[1], s.back());",
      "\t\tif (sz(s) == 2) return { a, a->r() };",
      "\t\tsplice(a->r(), b);",
      "\t\tauto side = cross(s[0], s[1], s[2]);",
      "\t\tQ c = side ? connect(b, a) : 0;",
      "\t\treturn {side < 0 ? c->r() : a, side < 0 ? c : b->r() };",
      "\t}",
      "",
      "#define H(e) e->F(), e->p",
      "#define valid(e) (cross(e->F(),H(base)) > 0)",
      "\tQ A, B, ra, rb;",
      "\tint half = sz(s) / 2;",
      "\ttie(ra, A) = rec({all(s) - half});",
      "\ttie(B, rb) = rec({sz(s) - half + all(s)});",
      "\twhile ((cross(B->p,H(A)) < 0 && (A = A->next())) ||",
      "\t\t   (cross(A->p,H(B)) > 0 && (B = B->r()->o)));",
      "\tQ base = connect(B->r(), A);",
      "\tif (A->p == ra->p) ra = base->r();",
      "\tif (B->p == rb->p) rb = base;",
      "",
      "#define DEL(e, init, dir) Q e = init->dir; if (valid(e)) \\\\",
      "\t\twhile (circ(e->dir->F(), H(base), e->F())) { \\\\",
      "\t\t\tQ t = e->dir; \\\\",
      "\t\t\tsplice(e, e->prev()); \\\\",
      "\t\t\tsplice(e->r(), e->r()->prev()); \\\\",
      "\t\t\te = t; \\\\",
      "\t\t}",
      "\tfor (;;) {",
      "\t\tDEL(LC, base->r(), o);\tDEL(RC, base, prev());",
      "\t\tif (!valid(LC) && !valid(RC)) break;",
      "\t\tif (!valid(LC) || (valid(RC) && circ(H(RC), H(LC))))",
      "\t\t\tbase = connect(RC, base->r());",
      "\t\telse",
      "\t\t\tbase = connect(base->r(), LC->r());",
      "\t}",
      "\treturn {ra, rb};",
      "}",
      "",
      "vector<array<P,3>> triangulate(vector<P> pts) {",
      "\tsort(all(pts)); assert(unique(all(pts)) == pts.end());",
      "\tif (sz(pts) < 2) return {};",
      "",
      "\tQ e = rec(pts).f; vector<Q> q = {e};",
      "\tint qi = 0;",
      "\twhile (cross(e->o->F(), e->F(), e->p) < 0) e = e->o;",
      "#define ADD { Q c = e; do { c->mark = 1; pts.push_back(c->p); \\\\",
      "\tq.push_back(c->r()); c = c->next(); } while (c != e); }",
      "\tADD; pts.clear();",
      "\twhile (qi < sz(q)) if (!(e = q[qi++])->mark) ADD;",
      "\t",
      "\tvector<array<P,3>> ret;",
      "\tF0R(i,sz(pts)/3) ret.pb({pts[3*i],pts[3*i+1],pts[3*i+2]});",
      "\treturn ret;",
      "}"
    ],
    "description": "geo/Misc/DelaunayFast.h"
  },
  "content/geo/Misc/DelaunaySlow.h": {
    "scope": "cpp,c",
    "prefix": "DelaunaySlow",
    "body": [
      "/*",
      " * Description: Delaunay Triangulation w/ Bowyer-Watson in O(n^2logn)",
      " * Source: Own",
      " * Verification: ICPC WF 2018 Panda Preserve",
      " */",
      "",
      "namespace Delaunay {",
      "\t// use __int128 for better precision, if possible",
      "\tld cross(cd b, cd c) { return (conj(b)*c).imag(); }",
      "\tld cross(cd a, cd b, cd c) { return cross(b-a,c-a); }",
      "",
      "\tbool inCircle (cd a, cd b, cd c, cd d) {",
      "\t\ta -= d, b -= d, c -= d;",
      "\t\tld x = norm(a)*cross(b,c)+norm(b)*cross(c,a)",
      "\t\t\t\t+norm(c)*cross(a,b);",
      "\t\tif (cross(a,b,c) < 0) x *= -1;",
      "\t\treturn x > 0;",
      "\t}",
      "",
      "\tvector<array<int,3>> triangulate(vcd v) {",
      "\t\t// works with cyclic quads",
      "\t\t// not when all points are collinear!",
      "\t\t// creates super-triangle, adjusts as necessary",
      "",
      "\t\tv.pb(cd(-1e5,-1e5)); v.pb(cd(1e5,0)); v.pb(cd(0,1e5)); // might not be sufficiently large",
      "",
      "\t\tvector<array<int,3>> ret;",
      "\t\tret.pb({sz(v)-3,sz(v)-2,sz(v)-1});",
      "",
      "\t\tF0R(i,sz(v)-3) {",
      "\t\t\tmap<pi,int> m;",
      "\t\t\tvector<array<int,3>> tmp;",
      "\t\t\ttrav(a,ret) {",
      "\t\t\t\tif (inCircle(v[a[0]],v[a[1]],v[a[2]],v[i]))",
      "\t\t\t\t\tm[{a[0],a[1]}] ++, m[{a[1],a[2]}] ++, m[{a[0],a[2]}] ++;",
      "\t\t\t\telse tmp.pb(a);",
      "\t\t\t}",
      "\t\t\ttrav(a,m) if (a.s == 1) {",
      "\t\t\t\tarray<int,3> x = {a.f.f,a.f.s,i}; sort(all(x));",
      "\t\t\t\ttmp.pb(x);",
      "\t\t\t}",
      "\t\t\tret = tmp;",
      "\t\t}",
      "\t\tvector<array<int,3>> tmp;",
      "\t\ttrav(a,ret) if (a[2] < sz(v)-3) tmp.pb(a);",
      "\t\treturn tmp;",
      "\t}",
      "",
      "\tvoid print(vcd x) { // produces asymptote code",
      "\t\tcout << \"[asy]\\\\n\";",
      "\t\tcout << \"pair[] A = {\";",
      "\t\tbool done = 0;",
      "\t\ttrav(a,x) {",
      "\t\t\tif (done) cout << \",\";",
      "\t\t\tcout << a; done = 1;",
      "\t\t}",
      "\t\tcout << \"};\\\\n\";",
      "",
      "\t\tcout << \"for (int i = 0; i < \" << sz(x) << \"; ++i) {\\\\n\\\\tdot(A[i]);\\\\n}\\\\n\";",
      "",
      "\t\ttrav(b,triangulate(x)) cout << \"draw(A[\" << b[0] << \"]--A[\" << b[1] << \"]--A[\" << b[2] << \"]--cycle);\\\\n\";",
      "\t\tcout << \"[/asy]\\\\n\";",
      "\t}",
      "};"
    ],
    "description": "geo/Misc/DelaunaySlow.h"
  },
  "content/geo/Misc/MaxCollinear.h": {
    "scope": "cpp,c",
    "prefix": "MaxCollinear",
    "body": [
      "/**",
      " * Description: Compute the maximum number of points which lie on the same line in O(n^2logn)",
      " * Source: own",
      " * Verification: https://open.kattis.com/problems/maxcolinear",
      " */",
      "",
      "pair<pi,int> getline(pi a, pi b) {",
      "\tpi z = {b.f-a.f,b.s-a.s};",
      "\tswap(z.f,z.s); z.f *= -1;",
      "\tint g = __gcd(z.f,z.s); z.f /= g, z.s /= g;",
      "\tckmin(z,{-z.f,-z.s});",
      "\treturn {z,z.f*a.f+z.s*a.s};",
      "}",
      "",
      "int solve(vpi p) {",
      "\tint n = sz(p);",
      "\tmap<pair<pi,int>,int> m;",
      "\tF0R(i,n) FOR(j,i+1,n) m[getline(p[i],p[j])] ++;",
      "",
      "\tint mx = 0; trav(a,m) ckmax(mx,a.s);",
      "\tint ans = 0; FOR(i,1,n+1) if (i*(i-1)/2 <= mx) ans = i;",
      "\treturn ans;",
      "}"
    ],
    "description": "geo/Misc/MaxCollinear.h"
  },
  "content/geo/3D/Hull3D.h": {
    "scope": "cpp,c",
    "prefix": "Hull3D",
    "body": [
      "/**",
      " * Description: 3D Convex Hull + Polyedron Volume",
      " * Time: O(N^2)",
      " * Source: KACTL",
      " * Verification: https://open.kattis.com/problems/starsinacan",
      " */",
      "",
      "#include \"Point3D.h\"",
      "",
      "struct ED {",
      "\tvoid ins(int x) { (a == -1 ? a : b) = x; }",
      "\tvoid rem(int x) { (a == x ? a : b) = -1; }",
      "\tint cnt() { return (a != -1) + (b != -1); }",
      "\tint a, b;",
      "};",
      "",
      "struct F { P3 q; int a, b, c; };",
      "",
      "vector<F> hull3d(const vP3& A) { ",
      "\tassert(sz(A) >= 4);",
      "\tvector<vector<ED>> E(sz(A), vector<ED>(sz(A), {-1, -1}));",
      "\t#define E(x,y) E[f.x][f.y]",
      "\tvector<F> FS; // faces",
      "\tauto mf = [&](int i, int j, int k, int l) { // make face",
      "\t\tP3 q = cross(A[j]-A[i],A[k]-A[i]);",
      "\t\tif (dot(q,A[l]) > dot(q,A[i])) q *= -1; // make sure q points outward",
      "\t\tF f{q, i, j, k};",
      "\t\tE(a,b).ins(k); E(a,c).ins(j); E(b,c).ins(i);",
      "\t\tFS.pb(f);",
      "\t};",
      "\tF0R(i,4) FOR(j,i+1,4) FOR(k,j+1,4) mf(i, j, k, 6-i-j-k);",
      "",
      "\tFOR(i,4,sz(A)) {",
      "\t\tF0R(j,sz(FS)) {",
      "\t\t\tF f = FS[j];",
      "\t\t\tif (dot(f.q,A[i]) > dot(f.q,A[f.a])) { // face is visible, remove edges",
      "\t\t\t\tE(a,b).rem(f.c), E(a,c).rem(f.b), E(b,c).rem(f.a);",
      "\t\t\t\tswap(FS[j--], FS.back());",
      "\t\t\t\tFS.pop_back();",
      "\t\t\t}",
      "\t\t}",
      "\t\tF0R(j,sz(FS)) { // add faces with new point",
      "\t\t\tF f = FS[j];",
      "\t\t\t#define C(a, b, c) if (E(a,b).cnt() != 2) mf(f.a, f.b, i, f.c);",
      "\t\t\tC(a, b, c); C(a, c, b); C(b, c, a);",
      "\t\t}",
      "\t}",
      "\ttrav(it, FS) if (dot(cross(A[it.b]-A[it.a],A[it.c]-A[it.a]),it.q) <= 0) ",
      "\t\tswap(it.c, it.b);",
      "\treturn FS;",
      "} // computes hull where no four are coplanar",
      "",
      "T signedPolyVolume(const vP3& p, const vector<F>& trilist) {",
      "\tT v = 0;",
      "\ttrav(i,trilist) v += dot(cross(p[i.a],p[i.b]),p[i.c]);",
      "\treturn v/6;",
      "}"
    ],
    "description": "geo/3D/Hull3D.h"
  },
  "content/geo/3D/Point3D.h": {
    "scope": "cpp,c",
    "prefix": "Point3D",
    "body": [
      "/**",
      " * Description: Basic 3D Geometry",
      " * Source: Own",
      " * Verification: ",
      "\t* AMPPZ 2011 Cross Spider",
      "\t* https://atcoder.jp/contests/JAG2013Spring/tasks/icpc2013spring_h",
      " */",
      "",
      "typedef ld T;",
      "",
      "namespace Point3D {",
      "\ttypedef array<T,3> P3;",
      "\ttypedef vector<P3> vP3;",
      "\t",
      "\tT norm(const P3& x) { ",
      "\t\tT sum = 0; F0R(i,sz(x)) sum += x[i]*x[i];",
      "\t\treturn sum;",
      "\t}",
      "\tT abs(const P3& x) { return sqrt(norm(x)); }",
      "\t",
      "\tP3& operator+=(P3& l, const P3& r) { F0R(i,3) l[i] += r[i]; return l; }",
      "\tP3& operator-=(P3& l, const P3& r) { F0R(i,3) l[i] -= r[i]; return l; }",
      "\tP3& operator*=(P3& l, const T& r) { F0R(i,3) l[i] *= r; return l; }",
      "\tP3& operator/=(P3& l, const T& r) { F0R(i,3) l[i] /= r; return l; }",
      "\t",
      "\tP3 operator+(P3 l, const P3& r) { return l += r; }",
      "\tP3 operator-(P3 l, const P3& r) { return l -= r; }",
      "\tP3 operator*(P3 l, const T& r) { return l *= r; }",
      "\tP3 operator*(const T& r, const P3& l) { return l*r; }",
      "\tP3 operator/(P3 l, const T& r) { return l /= r; }",
      "\t",
      "\tT dot(const P3& a, const P3& b) { ",
      "\t\tT sum = 0; F0R(i,3) sum += a[i]*b[i];",
      "\t\treturn sum;",
      "\t}",
      "\tP3 cross(const P3& a, const P3& b) {",
      "\t\treturn {a[1]*b[2]-a[2]*b[1],",
      "\t\t\t\ta[2]*b[0]-a[0]*b[2],",
      "\t\t\t\ta[0]*b[1]-a[1]*b[0]};",
      "\t}",
      "\t",
      "\tbool isMult(const P3& a, const P3& b) {",
      "\t\tauto c = cross(a,b); ",
      "\t\tF0R(i,sz(c)) if (c[i] != 0) return 0; ",
      "\t\treturn 1;",
      "\t}",
      "\tbool collinear(const P3& a, const P3& b, const P3& c) { return isMult(b-a,c-a); }",
      "\tbool coplanar(const P3& a, const P3& b, const P3& c, const P3& d) { ",
      "\t\treturn isMult(cross(b-a,c-a),cross(b-a,d-a)); ",
      "\t}",
      "}",
      "",
      "using namespace Point3D;"
    ],
    "description": "geo/3D/Point3D.h"
