      "\tauto X = smart(vcd(all(a)),vcd(all(b)));",
      "\tvi x(sz(X)); F0R(i,sz(X)) x[i] = round(X[i].real());",
      "\treturn x;",
      "}",
      "template<class T> vector<T> conv(const vector<T>& a, const vector<T>& b) {",
