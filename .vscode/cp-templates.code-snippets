      "/**",
      " * Description: divide two polynomials",
      " * Time: \\$O(N\\\\log N)?\\$",
      " */",
      "",
      "#include \"PolyInv.h\"",
      "",
      "template<class T> pair<vector<T>,vector<T>> divi(const vector<T>& f, const vector<T>& g) { // f = q*g+r",
      "\tif (sz(f) < sz(g)) return {{},f};",
      "\tauto q = mult(inv(rev(g),sz(f)-sz(g)+1),rev(f));",
      "\tq.resize(sz(f)-sz(g)+1); q = rev(q);",
      "\tauto r = f-mult(q,g); r.resize(sz(g)-1);",
      "\treturn {q,r};",
      "}"
