  "content/nt/Primality/FactorBasic.h": {
    "scope": "cpp,c",
    "prefix": "FactorBasic",
    "body": [
      "/**",
      " * Description: factors N in O(sqrtN) time",
      " * Source: Own",
      " * Verification: https://csacademy.com/contest/ceoi-2018-day-2/task/toys-big/",
      " */",
      "",
      "namespace factorBasic {",
      "\ttemplate<class T> vector<pair<T,int>> factor(T x) { // x <= 10^{14} is fine",
      "\t\tvector<pair<T,int>> pri;",
      "",
      "\t\tfor (T i = 2; i*i <= x; ++i) if (x % i == 0) {",
      "\t\t\tint t = 0;",
      "\t\t\twhile (x % i == 0) x /= i, t ++;",
      "\t\t\tpri.pb({i,t});",
      "\t\t}",
      "",
      "\t\tif (x > 1) pri.pb({x,1});",
      "\t\treturn pri;",
      "\t}",
      "",
      "\t/* Note:",
      "\t * number of operations needed s.t.",
      "\t *\t\t\t\t  phi(phi(...phi(n)...))=1",
      "\t * is O(log n).",
      "\t * Euler's theorem: a^{\\\\phi(p)}\\\\equiv 1 (mod p), gcd(a,p)=1",
      "\t */",
      "",
      "\tint phi(int x) {",
      "\t\ttrav(a,factor(x)) x -= x/a.f;",
      "\t\treturn x;",
      "\t}",
      "",
      "\ttemplate<class T> void tour(vector<pair<T,int>>& v, vector<T>& V, int ind, T cur) {",
      "\t\tif (ind == sz(v)) V.pb(cur);",
      "\t\telse {",
      "\t\t\tT mul = 1;",
      "\t\t\tF0R(i,v[ind].s+1) {",
      "\t\t\t\ttour(v,V,ind+1,cur*mul);",
      "\t\t\t\tmul *= v[ind].f;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "",
      "\ttemplate<class T> vector<T> getDivi(T x) {",
      "\t\tauto v = factor(x);",
      "\t\tvector<T> V; tour(v,V,0,(T)1); sort(all(V));",
      "\t\treturn V;",
      "\t}",
      "}",
      "",
      "using namespace factorBasic;"
    ],
    "description": "nt/Primality/FactorBasic.h"
  },
  "content/nt/Primality/FactorFast.h": {
    "scope": "cpp,c",
    "prefix": "FactorFast",
    "body": [
      "/**",
      " * Description: Factors integers up to \\$2^{60}\\$",
      " * Time: ?",
      " * Source: KACTL",
      "\t* https://en.wikipedia.org/wiki/Miller%E2%80%93Rabin_primality_test",
      "\t* https://en.wikipedia.org/wiki/Pollard%27s_rho_algorithm",
      "\t* https://codeforces.com/contest/1033/submission/44009089 is faster",
      " * Verification: https://www.spoj.com/problems/FACT0/",
      " */",
      "",
      "#include \"PrimeSieve.h\"",
      "",
      "Sieve<1<<20> S = Sieve<1<<20>(); // should take care of all primes up to n^(1/3)",
      "",
      "bool millerRabin(int p) { // test primality",
      "\tif (p == 2) return true;",
      "\tif (p == 1 || p % 2 == 0) return false;",
      "\tint s = p - 1; while (s % 2 == 0) s /= 2;",
      "\tF0R(i,30) { // strong liar with probability <= 1/4",
      "\t\tint a = rand() % (p - 1) + 1, tmp = s;",
      "\t\tint mod = mod_pow(a, tmp, p);",
      "\t\twhile (tmp != p - 1 && mod != 1 && mod != p - 1) {",
      "\t\t\tmod = mod_mul(mod, mod, p);",
      "\t\t\ttmp *= 2;",
      "\t\t}",
      "\t\tif (mod != p - 1 && tmp % 2 == 0) return false;",
      "\t}",
      "\treturn true;",
      "}",
      "",
      "int f(int a, int n, int &has) { return (mod_mul(a, a, n) + has) % n; }",
      "",
      "vpi pollardsRho(int d) {",
      "\tvpi res;",
      "\tauto& pr = S.pr;",
      "\tfor (int i = 0; i < sz(pr) && pr[i]*pr[i] <= d; i++) if (d % pr[i] == 0) {",
      "\t\tint co = 0; while (d % pr[i] == 0) d /= pr[i], co ++;",
      "\t\tres.pb({pr[i],co});",
      "\t}",
      "\tif (d > 1) { // d is now a product of at most 2 primes.",
      "\t\tif (millerRabin(d)) res.pb({d,1});",
      "\t\telse while (1) {",
      "\t\t\tint has = rand() % 2321 + 47;",
      "\t\t\tint x = 2, y = 2, c = 1;",
      "\t\t\tfor (; c == 1; c = __gcd(abs(x-y), d)) {",
      "\t\t\t\tx = f(x, d, has);",
      "\t\t\t\ty = f(f(y, d, has), d, has);",
      "\t\t\t} // should cycle in ~sqrt(smallest nontrivial divisor) turns ",
      "\t\t\tif (c != d) {",
      "\t\t\t\td /= c; if (d > c) swap(d,c);",
      "\t\t\t\tif (c == d) res.pb({c,2});",
      "\t\t\t\telse res.pb({c,1}), res.pb({d,1});",
      "\t\t\t\tbreak;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn res;",
      "}"
    ],
    "description": "nt/Primality/FactorFast.h"
  },
