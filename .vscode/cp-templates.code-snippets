  "content/ds/1D_Range/SegTree.h": {
    "scope": "cpp,c",
    "prefix": "SegTree",
    "body": [
      "/**",
      " * Description: 1D point update, range query",
      " * Time: O(\\\\log N)",
      " * Source: ",
      "\t* http://codeforces.com/blog/entry/18051",
      "\t* KACTL",
      " * Verification: SPOJ Fenwick",
      " */",
      "",
      "template<class T> struct segtree {",
      "    T identity = 0;",
      "\tint SZ = 0;",
      "    T comb(T l, T r) {",
      "        return gcd(l,r);",
      "    }",
      "    void updLeaf(T& l, T val) {",
      "        l = val;",
      "    }",
      "    vector<T> tree;",
      "    segtree(int _SZ) {",
      "\t\tSZ = _SZ;",
      "\t\ttree.resize(2*SZ + 1);",
      "        M00(i, 2*SZ+1) tree[i] = identity;",
      "    }",
      "    void upd(int pos, T val) {",
      "        pos += SZ+1;",
      "        updLeaf(tree[pos], val);",
      "        for(pos >>= 1; pos >= 1; pos >>= 1) {",
      "            tree[pos] = comb(tree[2*pos], tree[2*pos+1]);",
      "        }",
      "    }",
      "    T query(int l, int r) {",
      "        l += SZ+1;",
      "        r += SZ+1;",
      "        T res = identity;",
      "        while(l <= r) {",
      "            if(l&1) res = comb(res, tree[l++]);",
      "            if(!(r&1)) res = comb(res, tree[r--]);",
      "            l >>= 1; r >>= 1;",
      "        }",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "ds/1D_Range/SegTree.h"
  },
  "content/ds/1D_Range/SegTreeBeats.h": {
    "scope": "cpp,c",
    "prefix": "SegTreeBeats",
    "body": [
      "/**",
      " * Description: supports modifications in the form \\\\texttt{ckmin(a\\\\_i,t)} ",
      " \t* for all \\$l\\\\le i\\\\le r\\$, range max and sum queries",
      " * Time: O(\\\\log N)",
      " * Source: http://codeforces.com/blog/entry/57319",
      " * Verification: http://acm.hdu.edu.cn/showproblem.php?pid=5306",
      " */",
      "",
      "template<int SZ> struct SegTreeBeats {",
      "\tint N;",
      "\tint sum[2*SZ];",
      "\tint mx[2*SZ][2], maxCnt[2*SZ];",
      "",
      "\tvoid pull(int ind) {",
      "\t\tF0R(i,2) mx[ind][i] = max(mx[2*ind][i],mx[2*ind+1][i]);",
      "\t\tmaxCnt[ind] = 0;",
      "\t\tF0R(i,2) {",
      "\t\t\tif (mx[2*ind+i][0] == mx[ind][0]) ",
      "\t\t\t\tmaxCnt[ind] += maxCnt[2*ind+i];",
      "\t\t\telse ckmax(mx[ind][1],mx[2*ind+i][0]);",
      "\t\t}",
      "\t\tsum[ind] = sum[2*ind]+sum[2*ind+1];",
      "\t}",
      "\tvoid build(vi& a, int ind = 1, int L = 0, int R = -1) {",
      "\t\tif (R == -1) { R = (N = sz(a))-1; }",
      "\t\tif (L == R) {",
      "\t\t\tmx[ind][0] = sum[ind] = a[L];",
      "\t\t\tmaxCnt[ind] = 1; mx[ind][1] = -1;",
      "\t\t\treturn;",
      "\t\t} ",
      "\t\tint M = (L+R)/2;",
      "\t\tbuild(a,2*ind,L,M); build(a,2*ind+1,M+1,R); pull(ind);",
      "\t}",
      "\t",
      "\tvoid push(int ind, int L, int R) {",
      "\t\tif (L == R) return;",
      "\t\tF0R(i,2) ",
      "\t\t\tif (mx[2*ind^i][0] > mx[ind][0]) {",
      "\t\t\t\tsum[2*ind^i] -= (int)maxCnt[2*ind^i]*",
      "\t\t\t\t\t\t\t\t(mx[2*ind^i][0]-mx[ind][0]);",
      "\t\t\t\tmx[2*ind^i][0] = mx[ind][0];",
      "\t\t\t}",
      "\t}",
      "\tvoid upd(int x, int y, int t, int ind = 1, int L = 0, int R = -1) { ",
      "\t\tif (R == -1) R += N;",
      "\t\tif (R < x || y < L || mx[ind][0] <= t) return;",
      "\t\tpush(ind,L,R);",
      "\t\tif (x <= L && R <= y && mx[ind][1] < t) {",
      "\t\t\tsum[ind] -= (int)maxCnt[ind]*(mx[ind][0]-t);",
      "\t\t\tmx[ind][0] = t;",
      "\t\t\treturn;",
      "\t\t}",
      "\t\tif (L == R) return;",
      "\t\tint M = (L+R)/2;",
      "\t\tupd(x,y,t,2*ind,L,M); upd(x,y,t,2*ind+1,M+1,R); pull(ind);",
      "\t}",
      "\tint qsum(int x, int y, int ind = 1, int L = 0, int R = -1) {",
      "\t\tif (R == -1) R += N;",
      "\t\tif (R < x || y < L) return 0;",
      "\t\tpush(ind,L,R);",
      "\t\tif (x <= L && R <= y) return sum[ind];",
      "\t\tint M = (L+R)/2;",
      "\t\treturn qsum(x,y,2*ind,L,M)+qsum(x,y,2*ind+1,M+1,R);",
      "\t}",
      "\tint qmax(int x, int y, int ind = 1, int L = 0, int R = -1) {",
      "\t\tif (R == -1) R += N;",
      "\t\tif (R < x || y < L) return -1;",
      "\t\tpush(ind,L,R);",
      "\t\tif (x <= L && R <= y) return mx[ind][0];",
      "\t\tint M = (L+R)/2;",
      "\t\treturn max(qmax(x,y,2*ind,L,M), qmax(x,y,2*ind+1,M+1,R));",
      "\t}",
      "};"
    ],
    "description": "ds/1D_Range/SegTreeBeats.h"
  },
  "content/ds/1D_Range/SparseSegTree.h": {
    "scope": "cpp,c",
    "prefix": "SparseSegTree",
    "body": [
      "/**",
      " * Description: Does not allocate storage for nodes with no data",
      " * Source: USACO Mowing the Field",
      " * Verification: ~",
      " */ ",
      "",
      "template<class T> struct node {",
      "    T val;",
      "    int l, r;",
      "    node* left;",
      "    node* right;",
      "    node(int l, int r) {",
      "        this -> l = l;",
      "        this -> r = r;",
      "        this -> left = nullptr;",
      "        this -> right = nullptr;",
      "    }",
      "};",
      "",
      "template<class T, int SZ> struct segtree {",
      "    // modify these",
      "    T identity = 0;",
      "    T comb(T l, T r) {",
      "        return l + r;",
      "    }",
      "    void updLeaf(T& l, T val) {",
      "        l = val;",
      "    }",
      "    ",
      "    node<T>* root;",
      "    segtree() {",
      "        int ub = 1;",
      "        while(ub < SZ) ub *= 2;",
      "        root = new node<T>(0, ub-1);",
      "        root->val = identity;",
      "    }",
      "    void updN(node<T>* n, int pos, T val) {",
      "        if(pos < n->l || pos > n->r) return;",
      "        if(n->l == n->r) {",
      "            updLeaf(n->val, val);",
      "            return;",
      "        }",
      "        ",
      "        int mid = (n->l + n->r)/2;",
      "        if(pos > mid) {",
      "            if(n->right == nullptr) {",
      "                n->right = new node<T>(mid+1, n->r);",
      "                n->right->val = identity;",
      "            }",
      "            updN(n->right, pos, val);",
      "        }",
      "        else {",
      "            if(n->left == nullptr) {",
      "                n->left = new node<T>(n->l, mid);",
      "                n->left->val = identity;",
      "            }",
      "            updN(n->left, pos, val);",
      "        }",
      "        ",
      "        T lv = (n->left == nullptr) ? identity : n->left->val;",
      "        T rv = (n->right == nullptr) ? identity : n->right->val;",
      "        n->val = comb(lv, rv);",
      "    }",
      "    void upd(int pos, T val) {",
      "        updN(root, pos, val);",
      "    }",
      "    T queryN(node<T>* n, int i1, int i2) {",
      "        if(i2 < n->l || i1 > n->r) return identity;",
      "        if(n->l == n->r) return n->val;",
      "        if(n->l >= i1 && n->r <= i2) return n->val;",
      "        ",
      "        T a = identity;",
      "        if(n->left != nullptr) a = comb(a, queryN(n->left, i1, i2));",
      "        if(n->right != nullptr) a = comb(a, queryN(n->right, i1, i2));",
      "        ",
      "        return a;",
      "    }",
      "    T query(int i1, int i2) {",
      "        return queryN(root, i1, i2);",
      "    }",
      "};"
    ],
    "description": "ds/1D_Range/SparseSegTree.h"
  },
  "content/ds/1D_Range/SqrtDecomp.h": {
    "scope": "cpp,c",
    "prefix": "SqrtDecomp",
    "body": [
      "/**",
      " * Description: 1D point update, range query",
      " * Time: O(\\\\sqrt{N})",
      " * Source: imagine",
      " * Verification: imagine",
      " */",
      "",
      "struct sqrtDecomp {",
      "    const static int blockSZ = 10; //change this",
      "    int val[blockSZ*blockSZ];",
      "    int lazy[blockSZ];",
      "    ",
      "    sqrtDecomp() {",
      "        M00(i, blockSZ*blockSZ) val[i] = 0;",
      "        M00(i, blockSZ) lazy[i] = 0;",
      "    }",
      "    void upd(int l, int r, int v) {",
      "        int ind = l;",
      "        while(ind%blockSZ && ind <= r) {",
      "            val[ind] += v;",
      "            lazy[ind/blockSZ] += v;",
      "            ind++;",
      "        }",
      "        while(ind + blockSZ <= r) {",
      "            lazy[ind/blockSZ] += v*blockSZ;",
      "            ind += blockSZ;",
      "        }",
      "        while(ind <= r) {",
      "            val[ind] += v;",
      "            lazy[ind/blockSZ] += v;",
      "            ind++;",
      "        }",
      "    }",
      "    int query(int l, int r) {",
      "        int res = 0;",
      "        int ind = l;",
      "        while(ind%blockSZ && ind <= r) {",
      "            res += val[ind];",
      "            ind++;",
      "        }",
      "        while(ind + blockSZ <= r) {",
      "            res += lazy[ind/blockSZ];",
      "            ind += blockSZ;",
      "        }",
      "        while(ind <= r) {",
      "            res += val[ind];",
      "            ind++;",
      "        }",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "ds/1D_Range/SqrtDecomp.h"
  },
  "content/ds/1D_Range/Treap.h": {
    "scope": "cpp,c",
    "prefix": "Treap",
    "body": [
      "/**",
      " * Description: easy BBST, use split and merge to implement insert and delete",
      " * Time: O(\\\\log N)",
      " * Source: https://cp-algorithms.com/data_structures/treap.html + others",
      " * Verification: http://www.spoj.com/problems/ORDERSET/",
      " */",
      "",
      "typedef struct tnode* pt;",
      "",
      "struct tnode {",
      "\tint pri, val; pt c[2]; // essential",
      "\tint sz; int sum; // for range queries",
      "\tbool flip; // lazy update",
      "",
      "\ttnode (int _val) {",
      "\t\tpri = rand()+(rand()<<15); val = _val; c[0] = c[1] = NULL;",
      "\t\tsz = 1; sum = val;",
      "\t\tflip = 0;",
      "\t}",
      "};",
      "",
      "int getsz(pt x) { return x?x->sz:0; }",
      "int getsum(pt x) { return x?x->sum:0; }",
      "",
      "pt prop(pt x) {",
      "\tif (!x || !x->flip) return x;\t",
      "\tswap(x->c[0],x->c[1]);",
      "\tx->flip = 0;",
      "\tF0R(i,2) if (x->c[i]) x->c[i]->flip ^= 1;",
      "\treturn x;",
      "}",
      "",
      "pt calc(pt x) {",
      "\tassert(!x->flip);",
      "\tprop(x->c[0]), prop(x->c[1]);",
      "\tx->sz = 1+getsz(x->c[0])+getsz(x->c[1]);",
      "\tx->sum = x->val+getsum(x->c[0])+getsum(x->c[1]);",
      "\treturn x;",
      "}",
      "void tour(pt x, vi& v) {",
      "\tif (!x) return;",
      "\tprop(x);",
      "\ttour(x->c[0],v); v.pb(x->val); tour(x->c[1],v);",
      "}",
      "",
      "pair<pt,pt> split(pt t, int v) { // >= v goes to the right",
      "\tif (!t) return {t,t};",
      "\tprop(t);",
      "\tif (t->val >= v) {",
      "\t\tauto p = split(t->c[0], v); t->c[0] = p.s;",
      "\t\treturn {p.f, calc(t)};",
      "\t} else {",
      "\t\tauto p = split(t->c[1], v); t->c[1] = p.f;",
      "\t\treturn {calc(t), p.s};",
      "\t}",
      "}",
      "pair<pt,pt> splitsz(pt t, int sz) { // leftmost sz nodes go to left",
      "\tif (!t) return {t,t};",
      "\tprop(t);",
      "\tif (getsz(t->c[0]) >= sz) {",
      "\t\tauto p = splitsz(t->c[0], sz); t->c[0] = p.s;",
      "\t\treturn {p.f, calc(t)};",
      "\t} else {",
      "\t\tauto p = splitsz(t->c[1], sz-getsz(t->c[0])-1); t->c[1] = p.f;",
      "\t\treturn {calc(t), p.s};",
      "\t}",
      "}",
      "\t",
      "pt merge(pt l, pt r) {",
      "\tif (!l || !r) return l ? l : r;",
      "\tprop(l), prop(r);",
      "\tpt t;",
      "\tif (l->pri > r->pri) l->c[1] = merge(l->c[1],r), t = l;",
      "\telse r->c[0] = merge(l,r->c[0]), t = r;",
      "\treturn calc(t);",
      "}",
      "pt ins(pt x, int v) { // insert v",
      "\tauto a = split(x,v), b = split(a.s,v+1);",
      "\treturn merge(a.f,merge(new tnode(v),b.s));",
      "}",
      "pt del(pt x, int v) { // delete v",
      "\tauto a = split(x,v), b = split(a.s,v+1);",
      "\treturn merge(a.f,b.s);",
      "}"
    ],
    "description": "ds/1D_Range/Treap.h"
  },
  "content/ds/1D_Range/WaveletTree.h": {
    "scope": "cpp,c",
    "prefix": "WaveletTree",
    "body": [
      "/**",
      "* Description: Segment tree on values instead of indices",
      "* Source: http://rachitiitr.blogspot.com/2017/06",
      "\t/wavelet-trees-wavelet-trees-editorial.html",
      "* Verification: http://www.spoj.com/problems/MKTHNUM/",
      "*/",
      "",
      "template<int SZ> struct Wavelet {",
      "\tvi mapl[2*SZ], mapr[2*SZ], val[2*SZ];",
      "\tvoid build(int ind = 1, int L = 0, int R = SZ-1) { // build a wavelet tree",
      "\t\tif (ind == 1) { F0R(i,N) val[ind].pb(i); }",
      "\t\tif (L == R) return;",
      "\t\tint M = (L+R)/2;",
      "\t\ttrav(i,val[ind]) {",
      "\t\t\tval[2*ind+(A[i] > M)].pb(i);",
      "\t\t\tmapl[ind].pb(sz(val[2*ind])-1);",
      "\t\t\tmapr[ind].pb(sz(val[2*ind+1])-1);",
      "\t\t}",
      "\t\tbuild(2*ind,L,M);",
      "\t\tbuild(2*ind+1,M+1,R);",
      "\t}",
      "",
      "\tint getl(int ind, int x) { return x < 0 ? -1 : mapl[ind][x]; }",
      "\tint getr(int ind, int x) { return x < 0 ? -1 : mapr[ind][x]; }",
      "\tint query(int lind, int rind, int k, int ind = 1, int L = 0, int R = SZ-1) { // get k-th largest number in interval",
      "\t\tif (L == R) return L;",
      "",
      "\t\tint M = (L+R)/2;",
      "\t\tint t = getl(ind,rind)-getl(ind,lind-1);",
      "\t\tif (t >= k) return query(getl(ind,lind-1)+1,",
      "\t\t\t\t\t\t\t\tgetl(ind,rind),k,2*ind,L,M);",
      "\t\treturn query(getr(ind,lind-1)+1,",
      "\t\t\t\t\tgetr(ind,rind),k-t,2*ind+1,M+1,R);",
      "\t}",
      "};"
    ],
    "description": "ds/1D_Range/WaveletTree.h"
  },
  "content/ds/Static_Range/RMQ.h": {
    "scope": "cpp,c",
    "prefix": "RMQ",
    "body": [
      "/**",
      " * Description: 1D range minimum query",
      " * Source: KACTL",
      " * Verification: ",
      "\t* https://cses.fi/problemset/stats/1647/",
      "\t* http://wcipeg.com/problem/ioi1223",
      "\t* https://pastebin.com/ChpniVZL",
      " * Time: \\$O(N\\\\log N)\\$ build, \\$O(1)\\$ query",
      " */",
      "",
      "template<class T> struct RMQ {",
      "\tconstexpr static int level(int x) { ",
      "\t\treturn 31-__builtin_clz(x); ",
      "\t} // floor(log_2(x))",
      "\tvector<vi> jmp;",
      "\tvector<T> v;\t",
      "\tint comb(int a, int b) { ",
      "\t\treturn v[a] == v[b] ? min(a,b) : (v[a] < v[b] ? a : b); ",
      "\t} // index of minimum",
      "",
      "\tvoid init(const vector<T>& _v) {",
      "\t\tv = _v; jmp = {vi(sz(v))}; iota(all(jmp[0]),0);",
      "\t\tfor (int j = 1; 1<<j <= sz(v); ++j) {",
      "\t\t\tjmp.pb(vi(sz(v)-(1<<j)+1));",
      "\t\t\tF0R(i,sz(jmp[j])) jmp[j][i] = comb(jmp[j-1][i],",
      "\t\t\t\t\t\t\t\t\tjmp[j-1][i+(1<<(j-1))]);",
      "\t\t}",
      "\t}",
      "\t",
      "\tint index(int l, int r) { // get index of min element",
      "\t\tint d = level(r-l+1);",
      "\t\treturn comb(jmp[d][l],jmp[d][r-(1<<d)+1]);",
      "\t}",
      "\tT query(int l, int r) { return v[index(l,r)]; }",
      "};"
    ],
    "description": "ds/Static_Range/RMQ.h"
  },
  "content/ds/Static_Range/StaticRangeQuery.h": {
    "scope": "cpp,c",
    "prefix": "StaticRangeQuery",
    "body": [
      "/**",
      " * Description: constructs in O(nlogn) and queries a range in O(1)",
      " * Source: own",
      " * Verification: https://www.codechef.com/problems/SEGPROD",
      " */ ",
      " ",
      "template<class T, int SZ> struct RangeQuery {",
      "\tint n;",
      "\tT stor[SZ][32-__builtin_clz(SZ)], id = 1;",
      "\tvector<T> a;",
      "\t",
      "\tT comb (T a, T b) { return mul(a,b); } // associative operation",
      "\t",
      "\tvoid fill(int l, int r, int ind) {",
      "\t\tif (ind < 0) return;",
      "\t\tint m = (l+r)/2;",
      "\t\tT prod = id; FORd(i,l,m) stor[i][ind] = prod = comb(a[i],prod);",
      "\t\tprod = id; FOR(i,m,r) stor[i][ind] = prod = comb(prod,a[i]);",
      "\t\tfill(l,m,ind-1); fill(m,r,ind-1);",
      "\t}",
      "\t",
      "\tvoid init() {",
      "\t\tn = 1; while ((1<<n) < sz(a)) n ++;",
      "\t\ta.resize(1<<n); fill(0,(1<<n),n-1);",
      "\t}",
      "\t",
      "\tT query(int l, int r) {",
      "\t\tif (l == r) return a[l];",
      "\t\tint t = 31-__builtin_clz(r^l);",
      "\t\treturn comb(stor[l][t],stor[r][t]);",
      "\t}",
      "};"
    ],
    "description": "ds/Static_Range/StaticRangeQuery.h"
  },
  "content/graph/Matching/DFSmatch.h": {
    "scope": "cpp,c",
    "prefix": "DFSmatch",
    "body": [
      "/**",
      " * Description: naive bipartite matching",
      " * Time: O(NM)",
      " * Source: own",
      " * Verification: USACO Training unmatch",
      " */",
      "",
      "template<int SZ> struct MaxMatch {",
      "\tint N, flow = 0, match[SZ], rmatch[SZ];",
      "\tbitset<SZ> vis;",
      "\tvi adj[SZ];",
      "\tMaxMatch() { ",
      "\t\tmemset(match,0,sizeof match); ",
      "\t\tmemset(rmatch,0,sizeof rmatch); ",
      "\t}",
      "\t",
      "\tvoid connect(int a, int b, bool c = 1) {",
      "\t\tif (c) match[a] = b, rmatch[b] = a;",
      "\t\telse match[a] = rmatch[b] = 0;",
      "\t}",
      "\tbool dfs(int x) {",
      "\t\tif (!x) return 1;",
      "\t\tif (vis[x]) return 0;",
      "\t\tvis[x] = 1;",
      "\t\ttrav(t,adj[x]) if (t != match[x] && dfs(rmatch[t])) ",
      "\t\t\treturn connect(x,t),1;",
      "\t\treturn 0;",
      "\t}",
      "\tvoid tri(int x) { vis.reset(); flow += dfs(x); }",
      "\tvoid init(int _N) { ",
      "\t\tN = _N; FOR(i,1,N+1) if (!match[i]) tri(i); ",
      "\t}",
      "};"
    ],
    "description": "graph/Matching/DFSmatch.h"
