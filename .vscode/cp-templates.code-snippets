  },
  "content/nt/ModularArithmetic/ModMulLL.h": {
    "scope": "cpp,c",
    "prefix": "ModMulLL",
    "body": [
      "/**",
      " * Description: multiply two 64-bit integers mod another if 128-bit is not available",
      "\t* works for \\$0\\\\le a,b<mod<2^{63}\\$",
      " * Source: KACTL",
      " * Verification: see \"Faster Factoring\"",
      " */",
      "",
      "typedef unsigned long long ul;",
      "",
      "// equivalent to (ul)(__int128(a)*b%mod)",
      "ul modMul(ul a, ul b, const ul mod) {",
      "\tint ret = a*b-mod*(ul)((ld)a*b/mod);",
      "\treturn ret+((ret<0)-(ret>=(int)mod))*mod;",
      "}",
      "ul modPow(ul a, ul b, const ul mod) {",
      "\tif (b == 0) return 1;",
      "\tul res = modPow(a,b/2,mod);",
      "\tres = modMul(res,res,mod);",
      "\tif (b&1) return modMul(res,a,mod);",
      "\treturn res;",
      "}"
    ],
    "description": "nt/ModularArithmetic/ModMulLL.h"
  },
  "content/nt/ModularArithmetic/ModSqrt.h": {
    "scope": "cpp,c",
    "prefix": "ModSqrt",
    "body": [
      "/**",
      " * Description: find sqrt of integer mod a prime",
      " * Time: ?",
      " * Source: http://www.math.vt.edu/people/brown/class_homepages/shanks_tonelli.pdf",
      " * Verification: https://www.spoj.com/problems/CRYPTO1",
      " */",
      "",
      "#include \"Modular.h\"",
      "",
      "template<class T> T sqrt(modular<T> a) { ",
      "\tauto p = pow(a,(MOD-1)/2); if (p != 1) return p == 0 ? 0 : -1; // check if zero or does not have sqrt",
      "\tT s = MOD-1, e = 0; while (s % 2 == 0) s /= 2, e ++;",
      "\tmodular<T> n = 1; while (pow(n,(MOD-1)/2) == 1) n = (T)(n)+1; // find non-square residue",
      "",
      "\tauto x = pow(a,(s+1)/2), b = pow(a,s), g = pow(n,s);",
      "\tint r = e;",
      "\twhile (1) {",
      "\t\tauto B = b; int m = 0; while (B != 1) B *= B, m ++;",
      "\t\tif (m == 0) return min((T)x,MOD-(T)x);",
      "\t\tF0R(i,r-m-1) g *= g;",
      "\t\tx *= g; g *= g; b *= g; r = m;",
      "\t}",
      "}",
      "",
      "/* Explanation:",
      " * Initially, x^2=ab, ord(b) = 2^m, ord(g) = 2^r where m<r",
      " * g = g^{2^{r-m-1}} -> ord(g) = 2^{m+1}",
      " * if x'=x*g, then b' = b*g^2",
      "\t\t(b')^{2^{m-1}} = (b*g^2)^{2^{m-1}}",
      "\t\t\t\t\t   = b^{2^{m-1}}*g^{2^m}",
      "\t\t\t\t\t   = -1*-1",
      "\t\t\t\t\t   = 1",
      "\t-> ord(b')|ord(b)/2",
      " * m decreases by at least one each iteration",
      " */"
    ],
    "description": "nt/ModularArithmetic/ModSqrt.h"
  },
  "content/nt/ModularArithmetic/ModSum.h": {
    "scope": "cpp,c",
    "prefix": "ModSum",
    "body": [
      "/**",
      " * Description: Sums of mod'ed arithmetic progressions",
      " * Source: KACTL",
      " * Verification: ?",
      " */",
      "",
      "typedef unsigned long long ul;",
      "",
      "ul sumsq(ul to) { return (to-1)*to/2; } // sum of 0..to-1",
      "",
      "ul divsum(ul to, ul c, ul k, ul m) { // sum_{i=0}^{to-1}floor((ki+c)/m)",
      "\tul res = k/m*sumsq(to)+c/m*to;",
      "\tk %= m; c %= m; if (!k) return res;",
      "\tul to2 = (to*k+c)/m;",
      "\treturn res+(to-1)*to2-divsum(to2,m-1-c,m,k); ",
      "}",
      "",
      "int modsum(ul to, int c, int k, int m) {",
      "\tc = (c%m+m)%m, k = (k%m+m)%m;",
      "\treturn to*c+k*sumsq(to)-m*divsum(to,c,k,m);",
      "}"
    ],
    "description": "nt/ModularArithmetic/ModSum.h"
  },
