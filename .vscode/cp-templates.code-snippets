    "body": [
      "/**",
      " * Description: LiChao Segment Tree",
      " * Source: atatomir, misc",
      " * Verification: CSA Squared Ends",
      " */",
      "",
      "const int INF = 1e18;",
      "",
      "struct Line {",
      "\tint k,m;",
      "\tLine(int _k, int _m) { k = _k, m = _m; }",
      "\tLine() : Line(0,-INF) { }",
      "\tint get(int x) { return k*x+m; }",
      "\tbool majorize(Line X, int L, int R) { ",
      "\t\treturn get(L) >= X.get(L) && get(R) >= X.get(R); ",
      "\t}",
      "};",
      "",
      "struct lc {",
      "\tlc* c[2];",
      "\tLine S;",
      "\t",
      "\tlc() {",
      "\t\tc[0] = c[1] = NULL;",
      "\t\tS = Line();",
      "\t}",
      "\t",
      "\tvoid rm() {",
      "\t\tif (c[0]) c[0]->rm();",
      "\t\tif (c[1]) c[1]->rm();",
      "\t\tdelete this;",
      "\t}",
      "\t",
      "\tvoid mc(int i) {",
      "\t\tif (!c[i]) c[i] = new lc();",
      "\t}",
      "\t",
      "\tint query(int X, int L, int R) {",
      "\t\tint ans = S.get(X), M = (L+R)/2;",
      "\t\tif (X <= M) return max(ans, c[0] ? c[0]->query(X,L,M): -INF);",
      "\t\treturn max(ans, c[1] ? c[1]->query(X,M+1,R): -INF);",
      "\t}",
      "\t",
      "\tvoid modify(Line X, int L, int R) {",
      "\t\tif (X.majorize(S,L,R)) swap(X,S);",
      "\t\tif (S.majorize(X,L,R)) return;",
      "\t\tif (S.get(L) < X.get(L)) swap(X,S);",
      "\t\t",
      "\t\tint M = (L+R)/2;",
      "\t\tif (X.get(M) >= S.get(M)) swap(X,S), mc(0), c[0]->modify(X,L,M);",
      "\t\telse mc(1), c[1]->modify(X,M+1,R);",
      "\t}",
      "\t",
      "\tvoid upd(Line X, int lo, int hi, int L, int R) { // untested",
      "\t\tif (R < hi || L < lo) return;",
      "\t\tif (lo <= L && R <= hi) { modify(X,L,R); return; }",
      "\t\tint M = (L+R)/2;",
      "\t\tmc(0), c[0]->upd(X,lo,hi,L,M);",
      "\t\tmc(1), c[1]->upd(X,lo,hi,M+1,R);",
      "\t}",
      "};"
    ],
    "description": "ds/LichaoSegTree.h"
  },
  "content/ds/LineContainer.h": {
    "scope": "cpp,c",
    "prefix": "LineContainer",
    "body": [
      "/**",
      " * Description: Given set of lines, computes greatest \\$y\\$-coordinate for any \\$x\\$",
      " * Time: O(\\\\log N)",
      " * Source: KACTL",
      "   * https://codeforces.com/blog/entry/63823?#comment-477568",
      " * Verification: ",
      "   * CSA Squared Ends not working :(",
      "   * https://codeforces.com/contest/1083/problem/E",
      "   * https://atcoder.jp/contests/arc066/tasks/arc066_d",
      " */",
      "",
      "struct Line {",
      "\tmutable int k, m, p; // slope, y-intercept, last optimal x",
      "\tint eval (int x) { return k*x+m; }",
      "\tbool operator<(const Line& o) const { return k < o.k; }",
      "\tbool operator<(int x) const { return p < x; }",
      "};",
      "",
      "struct LC : multiset<Line,less<>> { ",
      "\t// for doubles, use inf = 1/.0, div(a,b) = a/b",
      "\tconst int inf = LLONG_MAX;",
      "\tint div(int a, int b) { return a/b-((a^b) < 0 && a%b); } // floored division",
      "\tint bet(const Line& x, const Line& y) { // last x such that first line is better",
      "\t\tif (x.k == y.k) return x.m >= y.m ? inf : -inf;",
      "\t\treturn div(y.m-x.m,x.k-y.k);",
      "\t}",
      "\tbool isect(iterator x, iterator y) { // updates x->p, determines if y is unneeded",
      "\t\tif (y == end()) { x->p = inf; return 0; }",
      "\t\tx->p = bet(*x,*y); return x->p >= y->p;",
      "\t}",
      "\tvoid add(int k, int m) {",
      "\t\tauto z = insert({k,m,0}), y = z++, x = y;",
      "\t\twhile (isect(y, z)) z = erase(z);",
      "\t\tif (x != begin() && isect(--x, y)) isect(x, y = erase(y));",
      "\t\twhile ((y = x) != begin() && (--x)->p >= y->p) isect(x, erase(y));",
      "\t}",
      "\tint query(int x) {",
      "\t\tassert(!empty());",
      "\t\tauto l = *lower_bound(x);",
      "\t\treturn l.k*x+l.m;",
      "\t}",
      "};"
    ],
    "description": "ds/LineContainer.h"
  },
  "content/ds/LineContainerDeque.h": {
    "scope": "cpp,c",
