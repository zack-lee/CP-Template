  "content/strings/Misc/Hashing.h": {
    "scope": "cpp,c",
    "prefix": "Hashing",
    "body": [
      "/**",
      " * Description: polynomial double-hash substrings",
      " * Sources:",
      "\t* KACTL",
      "\t* https://codeforces.com/contest/1207/submission/59309672",
      " * Verification: ",
      "\t* USACO Dec 17 Plat 1",
      "\t* CF Check Transcription",
      " */",
      "",
      "#include \"Modular.h\"",
      "",
      "namespace pairOp {",
      "\ttemplate<class A, class B> pair<A,B> operator+(const pair<A,B>& l, const pair<A,B>& r) { return {l.f+r.f,l.s+r.s}; }",
      "\ttemplate<class A, class B> pair<A,B> operator-(const pair<A,B>& l, const pair<A,B>& r) { return {l.f-r.f,l.s-r.s}; }",
      "\ttemplate<class A, class B> pair<A,B> operator*(const pair<A,B>& l, const pair<A,B>& r) { return {l.f*r.f,l.s*r.s}; }",
      "\ttemplate<class A, class B, class C> pair<A,B> operator*(const pair<A,B>& l, const C& r) { return {l.f*r,l.s*r}; }",
      "\ttemplate<class A, class B, class C> pair<A,B> operator*(const C& r, const pair<A,B>& l) { return l*r; }",
      "\ttemplate<class A, class B, class C> pair<A,B> operator/(const pair<A,B>& l, const C& r) { return {l.f/r,l.s/r}; }",
      "\t",
      "\ttemplate<class A, class B> pair<A,B>& operator+=(pair<A,B>& l, const pair<A,B>& r) { return l = l+r; }",
      "\ttemplate<class A, class B> pair<A,B>& operator-=(pair<A,B>& l, const pair<A,B>& r) { return l = l-r; }",
      "\ttemplate<class A, class B> pair<A,B>& operator*=(pair<A,B>& l, const pair<A,B>& r) { return l = l*r; }",
      "\ttemplate<class A, class B, class C> pair<A,B>& operator*=(pair<A,B>& l, const C& r) { return l = {l.f*r,l.s*r}; }",
      "\ttemplate<class A, class B, class C> pair<A,B>& operator/=(pair<A,B>& l, const C& r) { return l = {l.f/r,l.s/r}; }",
      "}",
      "",
      "using namespace pairOp;",
      "",
      "uniform_int_distribution<int> MULT_DIST(0.1 * MOD, 0.9 * MOD); // not too close to ends",
      "const pmi base = {MULT_DIST(rng),MULT_DIST(rng)};",
      "",
      "struct hsh {",
      "\tstring S; ",
      "\tvpmi pows, cum;",
      "\t",
      "\tvoid init(string _S) {",
      "\t\tS = _S; pows.resize(sz(S)), cum.resize(sz(S)+1);",
      "\t\tpows[0] = {1,1}; FOR(i,1,sz(S)) pows[i] = pows[i-1]*base;",
      "\t\tF0R(i,sz(S)) {",
      "\t\t\tint c = S[i]-'a'+1;",
      "\t\t\tcum[i+1] = base*cum[i]+pmi(c,c);",
      "\t\t}",
      "\t}",
      "\t",
      "\tpmi get(int l, int r) {\t return cum[r+1]-pows[r+1-l]*cum[l]; }",
      "\t",
      "\tint lcp(hsh& b) {",
      "\t\tint lo = 0, hi = min(sz(S),sz(b.S));",
      "\t\twhile (lo < hi) {",
      "\t\t\tint mid = (lo+hi+1)/2;",
      "\t\t\tif (cum[mid] == b.cum[mid]) lo = mid;",
      "\t\t\telse hi = mid-1;",
      "\t\t}",
      "\t\treturn lo;",
      "\t}",
      "};",
      "",
      "// hsh H; H.init(\"ababab\"); F0R(i,6) FOR(j,i,6) ps(i,j,H.get(i,j));"
    ],
    "description": "strings/Misc/Hashing.h"
  },
  "content/strings/Misc/TandemRepeats.h": {
    "scope": "cpp,c",
    "prefix": "TandemRepeats",
    "body": [
      "/**",
      " * Description: Main-Lorentz algorithm,",
      "\t* finds all \\$(x,y)\\$ such that \\\\texttt{s.substr(x,y-1) == s.substr(x+y,y-1)}",
      " * Time: O(N\\\\log N)",
      " * Source: https://cp-algorithms.com/string/main_lorentz.html",
      " * Verification: http://codeforces.com/contest/1043/problem/G",
      " */",
      "",
      "#include \"Z.h\"",
      "",
      "struct StringRepeat {",
      "\tstring S;",
      "\tvector<array<int,3>> al; ",
      "\t// (t[0],t[1],t[2]) -> there is a repeating substring starting at x ",
      "\t// with length t[0]/2 for all t[1] <= x <= t[2]",
      "",
      "\tvector<array<int,3>> solveLeft(string s, int m) {",
      "\t\tvector<array<int,3>> v;",
      "",
      "\t\tvi v2 = getPrefix(string(s.begin()+m+1,s.end()),string(s.begin(),s.begin()+m+1));",
      "\t\tstring V = string(s.begin(),s.begin()+m+2); reverse(all(V)); vi v1 = z(V); reverse(all(v1));",
      "",
      "\t\tF0R(i,m+1) if (v1[i]+v2[i] >= m+2-i) {",
      "\t\t\tint lo = max(1,m+2-i-v2[i]), hi = min(v1[i],m+1-i);",
      "\t\t\tlo = i-lo+1, hi = i-hi+1; swap(lo,hi);",
      "\t\t\tv.pb({2*(m+1-i),lo,hi});",
      "\t\t}",
      "",
      "\t\treturn v;",
      "\t}",
      "",
      "\tvoid divi(int l, int r) {",
      "\t\tif (l == r) return;",
      "\t\tint m = (l+r)/2; divi(l,m); divi(m+1,r);",
      "",
      "\t\tstring t = string(S.begin()+l,S.begin()+r+1);",
      "\t\tm = (sz(t)-1)/2;",
      "\t\tauto a = solveLeft(t,m);",
      "\t\treverse(all(t));",
      "\t\tauto b = solveLeft(t,sz(t)-2-m);",
      "",
      "\t\ttrav(x,a) al.pb({x[0],x[1]+l,x[2]+l});",
      "\t\ttrav(x,b) {",
      "\t\t\tint ad = r-x[0]+1;",
      "\t\t\tal.pb({x[0],ad-x[2],ad-x[1]});",
      "\t\t}",
      "\t}",
      "",
      "\tvoid init(string _S) {",
      "\t\tS = _S; divi(0,sz(S)-1);",
      "\t}",
      "",
      "\tvi genLen() { // min length of repeating substring starting at each index",
      "\t\tpriority_queue<pi,vpi,greater<pi>> m; m.push({MOD,MOD});",
      "\t\tvpi ins[sz(S)]; trav(a,al) ins[a[1]].pb({a[0],a[2]});",
      "\t\tvi len(sz(S));",
      "\t\tF0R(i,sz(S)) {",
      "\t\t\ttrav(j,ins[i]) m.push(j);",
      "\t\t\twhile (m.top().s < i) m.pop();",
      "\t\t\tlen[i] = m.top().f;",
      "\t\t}",
      "\t\treturn len;",
      "\t}",
      "};"
    ],
    "description": "strings/Misc/TandemRepeats.h"
  },
  "content/strings/SuffixStructures/ACfixed.h": {
    "scope": "cpp,c",
    "prefix": "ACfixed",
    "body": [
      "/**",
      " * Description: for each prefix, stores link to max length suffix which is also a prefix",
      " * Time: O(N\\\\sum)",
      " * Source: https://ideone.com/0cMjZJ",
      "\t* https://codeforces.com/contest/710/problem/F",
      "\t* https://codeforces.com/contest/1207/problem/G",
      " */",
      "",
      "struct ACfixed { // fixed alphabet",
      "\tstruct node {",
      "\t\tarray<int,26> to;",
      "\t\tint link;",
      "\t};",
      "\tvector<node> d;",
      "\tACfixed() { d.eb(); }",
      "",
      "\tint add(string s) { // add word",
      "\t\tint v = 0;",
      "\t\ttrav(C,s) {",
      "\t\t\tint c = C-'a';",
      "\t\t\tif (!d[v].to[c]) {",
      "\t\t\t\td[v].to[c] = sz(d);",
      "\t\t\t\td.eb();",
      "\t\t\t}",
      "\t\t\tv = d[v].to[c];",
      "\t\t}",
      "\t\treturn v;",
      "\t}",
      "\t",
      "\tvoid init() { // generate links",
      "\t\td[0].link = -1; ",
      "\t\tqueue<int> q; q.push(0);",
      "\t\twhile (sz(q)) {",
      "\t\t\tint v = q.front(); q.pop();",
      "\t\t\tF0R(c,26) {",
      "\t\t\t\tint u = d[v].to[c]; if (!u) continue;",
      "\t\t\t\td[u].link = d[v].link == -1 ? 0 : d[d[v].link].to[c];",
      "\t\t\t\tq.push(u); ",
      "\t\t\t}",
      "\t\t\tif (v) F0R(c,26) if (!d[v].to[c]) ",
      "\t\t\t\td[v].to[c] = d[d[v].link].to[c];",
      "\t\t}",
      "\t}",
      "};"
    ],
    "description": "strings/SuffixStructures/ACfixed.h"
  },
  "content/strings/SuffixStructures/ACunfixed.h": {
    "scope": "cpp,c",
    "prefix": "ACunfixed",
    "body": [
      "/**",
      " * Description: for each prefix, stores link to max length suffix which is also a prefix",
      " * Source: https://ideone.com/0cMjZJ",
      " * Verification: ",
      "\t* Kattis stringmultimatching",
      " */",
      "",
      "struct ACunfixed { ",
      "\tstruct node {",
      "\t\tmap<char,int> to;",
      "\t\tint link;",
      "\t};",
      "\tvector<node> d;",
      "\tACunfixed() { d.emplace_back(); }",
      "\t",
      "\tint add(string s) { // add word",
      "\t\tint v = 0;",
      "\t\ttrav(c,s) {",
      "\t\t\tif (!d[v].to.count(c)) {",
      "\t\t\t\td[v].to[c] = sz(d);",
      "\t\t\t\td.emplace_back();",
      "\t\t\t}",
      "\t\t\tv = d[v].to[c];",
      "\t\t}",
      "\t\treturn v;",
      "\t}",
      "",
      "\tint nex(int j, char c) { // state after adding character",
      "\t\twhile (j != -1 && !d[j].to.count(c)) j = d[j].link;",
      "\t\treturn j == -1 ? 0 : d[j].to[c]; ",
      "\t}",
      "\tvoid init() { // generate links",
      "\t\td[0].link = -1;",
      "\t\tqueue<int> q; q.push(0);",
      "\t\twhile (sz(q)) {",
      "\t\t\tint v = q.front(); q.pop();",
      "\t\t\ttrav(it,d[v].to) {",
      "\t\t\t\tchar c = it.f; int u = it.s;",
      "\t\t\t\td[u].link = nex(d[v].link,c); ",
      "\t\t\t\tq.push(u); ",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "};"
    ],
    "description": "strings/SuffixStructures/ACunfixed.h"
  },
  "content/strings/SuffixStructures/PalTree.h": {
    "scope": "cpp,c",
    "prefix": "PalTree",
    "body": [
      "/**",
      " * Description: palindromic tree, computes number of occurrences ",
      " \t* of each palindrome within string",
      " * Time: O(N\\\\sum)",
      " * Source: http://codeforces.com/blog/entry/13959",
      " * Verification: https://oj.uz/problem/view/APIO14_palindrome",
      " */",
      "",
      "template<int SZ> struct PalTree {",
      "\tstatic const int sigma = 26;",
      "\tint s[SZ], len[SZ], link[SZ], to[SZ][sigma], oc[SZ];",
      "\tint n, last, sz;",
      "\tPalTree() { s[n++] = -1; link[0] = 1; len[1] = -1; sz = 2; }",
      "\t",
      "\tint getLink(int v) {",
      "\t\twhile (s[n-len[v]-2] != s[n-1]) v = link[v];",
      "\t\treturn v;",
      "\t}",
      "\tvoid addChar(int c) {",
      "\t\ts[n++] = c;",
      "\t\tlast = getLink(last);",
      "\t\tif (!to[last][c]) {",
      "\t\t\tlen[sz] = len[last]+2;",
      "\t\t\tlink[sz] = to[getLink(link[last])][c];",
      "\t\t\tto[last][c] = sz++;",
      "\t\t}",
      "\t\tlast = to[last][c]; oc[last] ++;",
      "\t}",
      "\tvoid numOc() { ",
      "\t\tvpi v; FOR(i,2,sz) v.pb({len[i],i});",
      "\t\tsort(v.rbegin(), v.rend()); trav(a,v) oc[link[a.s]] += oc[a.s];",
      "\t}",
      "};"
    ],
    "description": "strings/SuffixStructures/PalTree.h"
  },
  "content/strings/SuffixStructures/ReverseBW.h": {
    "scope": "cpp,c",
    "prefix": "ReverseBW",
    "body": [
      "/**",
      " * Description: The Burrows-Wheeler Transform appends \\\\# to a string, ",
      "\t * sorts the rotations of the string in increasing order, ",
      "\t * and constructs a new string that contains the last character ",
      "\t * of each rotation. This function reverses the transform.",
      " * Time: O(N\\\\log N)",
      " * Source: ?",
      " * Verification: https://cses.fi/problemset/task/1113/",
      " */",
      "",
      "string reverseBW(string s) {",
      "\tvi nex(sz(s));",
      "\tvector<pair<char,int>> v; F0R(i,sz(s)) v.pb({s[i],i});",
      "\tsort(all(v)); F0R(i,sz(v)) nex[i] = v[i].s;",
      "\tint cur = nex[0]; string ret;",
      "\tfor (; cur;cur = nex[cur]) ret += v[cur].f;",
      "\treturn ret;",
      "}"
    ],
    "description": "strings/SuffixStructures/ReverseBW.h"
  },
  "content/strings/SuffixStructures/SuffixArray.h": {
    "scope": "cpp,c",
    "prefix": "SuffixArray",
    "body": [
      "/**",
      "* Description: ?",
      "* Time: O(N\\\\log N)",
      "* Source: SuprDewd, KACTL, majk, ekzhang",
      "* Verification: ",
      "\t* http://usaco.org/index.php?page=viewproblem2&cpid=768",
      "\t\t* https://pastebin.com/y2Z9FYr6",
      "\t* https://open.kattis.com/problems/suffixsorting",
      "\t* https://codeforces.com/contest/1090/problem/J",
      "*/",
      "",
      "template<int SZ> struct suffixArray {",
      "    const static int LGSZ = 33-__builtin_clz(SZ-1);",
      "    pair<pi, int> tup[SZ];",
      "    int sortIndex[LGSZ][SZ];",
      "    int res[SZ];",
      "    int len;",
      "    suffixArray(string s) {",
      "        this->len = (int)s.length();",
      "        M00(i, len) tup[i] = MP(MP((int)s[i], -1), i);",
      "        sort(tup, tup+len);",
      "        int temp = 0;",
      "        tup[0].F.F = 0;",
      "        MOO(i, 1, len) {",
      "            if(s[tup[i].S] != s[tup[i-1].S]) temp++;",
      "            tup[i].F.F = temp;",
      "        }",
      "        M00(i, len) sortIndex[0][tup[i].S] = tup[i].F.F;",
      "        MOO(i, 1, LGSZ) {",
      "            M00(j, len) tup[j] = MP(MP(sortIndex[i-1][j], (j+(1<<(i-1))<len)?sortIndex[i-1][j+(1<<(i-1))]:-1), j);",
      "            sort(tup, tup+len);",
      "            int temp2 = 0;",
      "            sortIndex[i][tup[0].S] = 0;",
      "            MOO(j, 1, len) {",
      "                if(tup[j-1].F != tup[j].F) temp2++;",
      "                sortIndex[i][tup[j].S] = temp2;",
      "            }",
      "        }",
      "        M00(i, len) res[sortIndex[LGSZ-1][i]] = i;",
      "    }",
      "    int LCP(int x, int y) {",
      "        if(x == y) return len - x;",
      "        int ans = 0;",
      "        M00d(i, LGSZ) {",
      "            if(x >= len || y >= len) break;",
      "            if(sortIndex[i][x] == sortIndex[i][y]) {",
      "                x += (1<<i);",
      "                y += (1<<i);",
      "                ans += (1<<i);",
      "            }",
      "        }",
      "        return ans;",
      "    }",
      "};"
    ],
    "description": "strings/SuffixStructures/SuffixArray.h"
  },
  "content/strings/SuffixStructures/SuffixAutomaton.h": {
    "scope": "cpp,c",
    "prefix": "SuffixAutomaton",
    "body": [
      "/**",
      " * Description: constructs minimal DFA that recognizes all suffixes of a string",
      " * Time: O(N\\\\log \\\\sum)",
      " * Source: https://cp-algorithms.com/string/suffix-automaton.html",
      " * Verification: ",
      "\t* https://www.spoj.com/problems/SUBLEX/",
      "\t* https://open.kattis.com/problems/stringmultimatching",
      " */",
      " ",
      "struct SuffixAutomaton {",
      "\tstruct state {",
      "\t\tint len = 0, firstPos = -1, link = -1;",
      "\t\tbool isClone = 0;",
      "\t\tmap<char, int> next;",
      "\t\tvi invLink;",
      "\t};",
      "\t",
      "\tvector<state> st;",
      "\tint last = 0;",
      "\tvoid extend(char c) {",
      "\t\tint cur = sz(st); st.eb();",
      "\t\tst[cur].len = st[last].len+1, st[cur].firstPos = st[cur].len-1;",
      "\t\tint p = last;",
      "\t\twhile (p != -1 && !st[p].next.count(c)) {",
      "\t\t\tst[p].next[c] = cur;",
      "\t\t\tp = st[p].link;",
      "\t\t}",
      "\t\tif (p == -1) {",
      "\t\t\tst[cur].link = 0;",
      "\t\t} else {",
      "\t\t\tint q = st[p].next[c];",
      "\t\t\tif (st[p].len+1 == st[q].len) {",
      "\t\t\t\tst[cur].link = q;",
      "\t\t\t} else {",
      "\t\t\t\tint clone = sz(st); st.pb(st[q]);",
      "\t\t\t\tst[clone].len = st[p].len+1, st[clone].isClone = 1;",
      "\t\t\t\twhile (p != -1 && st[p].next[c] == q) {",
      "\t\t\t\t\tst[p].next[c] = clone;",
      "\t\t\t\t\tp = st[p].link;",
      "\t\t\t\t}",
      "\t\t\t\tst[q].link = st[cur].link = clone;",
      "\t\t\t}",
      "\t\t}",
      "\t\tlast = cur;",
      "\t}",
      "\tvoid init(string s) { ",
      "\t\tst.eb(); trav(x,s) extend(x); ",
      "\t\tFOR(v,1,sz(st)) st[st[v].link].invLink.pb(v);",
      "\t}",
      "\t",
      "\t// APPLICATIONS",
      "\tvoid getAllOccur(vi& oc, int v) {",
      "\t\tif (!st[v].isClone) oc.pb(st[v].firstPos);",
      "\t\ttrav(u,st[v].invLink) getAllOccur(oc,u);",
      "\t}",
      "\tvi allOccur(string s) {",
      "\t\tint cur = 0;",
      "\t\ttrav(x,s) {",
      "\t\t\tif (!st[cur].next.count(x)) return {};",
      "\t\t\tcur = st[cur].next[x];",
      "\t\t}",
      "\t\tvi oc; getAllOccur(oc,cur); trav(t,oc) t += 1-sz(s);",
      "\t\tsort(all(oc)); return oc;",
      "\t}",
      "\t",
      "\tvi distinct;",
      "\tint getDistinct(int x) {",
      "\t\tif (distinct[x]) return distinct[x];",
      "\t\tdistinct[x] = 1; ",
      "\t\ttrav(y,st[x].next) distinct[x] += getDistinct(y.s);",
      "\t\treturn distinct[x];",
      "\t}",
      "\tint numDistinct() { // # of distinct substrings, including empty",
      "\t\tdistinct.resize(sz(st));",
      "\t\treturn getDistinct(0);",
      "\t}",
      "\tint numDistinct2() { // another way to get # of distinct substrings",
      "\t\tint ans = 1;",
      "\t\tFOR(i,1,sz(st)) ans += st[i].len-st[st[i].link].len;",
      "\t\treturn ans;",
      "\t}",
      "};"
    ],
    "description": "strings/SuffixStructures/SuffixAutomaton.h"
  },
  "content/strings/SuffixStructures/SuffixTree.h": {
    "scope": "cpp,c",
    "prefix": "SuffixTree",
    "body": [
      "/**",
      " * Description: Ukkonen's algorithm for suffix tree",
      " * Time: O(N\\\\log \\\\sum)",
      " * Source: ",
      " \t* https://codeforces.com/blog/entry/16780",
      " \t* https://stackoverflow.com/questions/9452701/ukkonens-suffix-tree-algorithm-in-plain-english?rq=1",
      " * Verification: https://onlinejudge.org/index.php?option=com_onlinejudge&Itemid=8&category=18&page=show_problem&problem=1620",
      " */",
      "",
      " struct SuffixTree {",
      "\tstring s; int node, pos;",
      "\tstruct state {",
      "\t\tint fpos, len, link = -1;",
      "\t\tmap<char,int> to;",
      "\t\tstate(int fpos, int len) : fpos(fpos), len(len) {}",
      "\t};",
      "\tvector<state> st;",
      "\tint makeNode(int pos, int len) { ",
      "\t\tst.pb(state(pos,len)); return sz(st)-1;",
      "\t}",
      "\tvoid goEdge() {",
      "\t\twhile (pos > 1 && pos > st[st[node].to[s[sz(s)-pos]]].len) {",
      "\t\t\tnode = st[node].to[s[sz(s)-pos]];",
      "\t\t\tpos -= st[node].len;",
      "\t\t}",
      "\t}",
      "\tvoid extend(char c) {",
      "\t\ts += c; pos ++; int last = 0;",
      "\t\twhile (pos) {",
      "\t\t\tgoEdge();",
      "\t\t\tchar edge = s[sz(s)-pos];",
      "\t\t\tint& v = st[node].to[edge];",
      "\t\t\tchar t = s[st[v].fpos+pos-1];",
      "\t\t\tif (v == 0) {",
      "\t\t\t\tv = makeNode(sz(s)-pos,MOD);",
      "\t\t\t\tst[last].link = node; last = 0;",
      "\t\t\t} else if (t == c) {",
      "\t\t\t\tst[last].link = node;",
      "\t\t\t\treturn;",
      "\t\t\t} else {",
      "\t\t\t\tint u = makeNode(st[v].fpos,pos-1);",
      "\t\t\t\tst[u].to[c] = makeNode(sz(s)-1,MOD); st[u].to[t] = v;",
      "\t\t\t\tst[v].fpos += pos-1; st[v].len -= pos-1;",
      "\t\t\t\tv = u; st[last].link = u; last = u;",
      "\t\t\t}",
      "\t\t\tif (node == 0) pos --;",
      "\t\t\telse node = st[node].link;",
      "\t\t}",
      "\t}",
      "\tvoid init(string _s) {",
      "\t\tmakeNode(0,MOD); node = pos = 0;",
      "\t\ttrav(c,_s) extend(c);",
      "\t}",
      "\tbool isSubstr(string _x) {",
      "\t\tstring x; int node = 0, pos = 0;",
      "\t\ttrav(c,_x) {",
      "\t\t\tx += c; pos ++; ",
      "\t\t\twhile (pos > 1 && pos > st[st[node].to[x[sz(x)-pos]]].len) {",
      "\t\t\t\tnode = st[node].to[x[sz(x)-pos]];",
      "\t\t\t\tpos -= st[node].len;",
      "\t\t\t}",
      "\t\t\tchar edge = x[sz(x)-pos];",
      "\t\t\tif (pos == 1 && !st[node].to.count(edge)) return 0;",
      "\t\t\tint& v = st[node].to[edge];",
      "\t\t\tchar t = s[st[v].fpos+pos-1];",
      "\t\t\tif (c != t) return 0;",
      "\t\t}",
      "\t\treturn 1;",
      "\t}",
