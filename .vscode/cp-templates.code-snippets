      "/**",
      " * Description: modular arithmetic operations ",
      " * Source: ",
      "\t* KACTL",
      "\t* https://codeforces.com/blog/entry/63903",
      "\t* https://community.topcoder.com/stat?c=problem_solution&rm=332132&rd=17420&pm=15327&cr=22263204",
      " * Verification: ",
      "\t* https://open.kattis.com/problems/modulararithmetic",
      "\t* also see Combinations",
      " */",
      "",
      "template<class T> struct modular {",
      "\tT val; ",
      "\texplicit operator T() const { return val; }",
      "\tmodular() { val = 0; }",
      "\tmodular(const int& v) {",
      "\t\tval = (-MOD <= v && v <= MOD) ? v : v % MOD;",
      "\t\tif (val < 0) val += MOD;",
      "\t}",
      "\t",
      "\t// friend ostream& operator<<(ostream& os, const modular& a) { return os << a.val; }",
      "\tfriend void pr(const modular& a) { pr(a.val); }",
      "\tfriend void re(modular& a) { int x; re(x); a = modular(x); }",
      "   ",
      "\tfriend bool operator==(const modular& a, const modular& b) { return a.val == b.val; }",
      "\tfriend bool operator!=(const modular& a, const modular& b) { return !(a == b); }",
      "\tfriend bool operator<(const modular& a, const modular& b) { return a.val < b.val; }",
      "",
      "\tmodular operator-() const { return modular(-val); }",
      "\tmodular& operator+=(const modular& m) { if ((val += m.val) >= MOD) val -= MOD; return *this; }",
      "\tmodular& operator-=(const modular& m) { if ((val -= m.val) < 0) val += MOD; return *this; }",
      "\tmodular& operator*=(const modular& m) { val = (int)val*m.val%MOD; return *this; }",
      "\tfriend modular pow(modular a, int p) {",
      "\t\tmodular ans = 1; for (; p; p /= 2, a *= a) if (p&1) ans *= a;",
      "\t\treturn ans;",
      "\t}",
      "\tfriend modular inv(const modular& a) { ",
      "\t\tassert(a != 0); return exp(a,MOD-2); ",
      "\t}",
      "\tmodular& operator/=(const modular& m) { return (*this) *= inv(m); }",
      "\t",
      "\tfriend modular operator+(modular a, const modular& b) { return a += b; }",
      "\tfriend modular operator-(modular a, const modular& b) { return a -= b; }",
      "\tfriend modular operator*(modular a, const modular& b) { return a *= b; }",
      "\t",
      "\tfriend modular operator/(modular a, const modular& b) { return a /= b; }",
      "};",
      "",
      "typedef modular<int> mi;",
      "typedef pair<mi,mi> pmi;",
      "typedef vector<mi> vmi;",
      "typedef vector<pmi> vpmi;"
