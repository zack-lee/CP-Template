  "content/graph/Fundamentals/ManhattanMST.h": {
    "scope": "cpp,c",
    "prefix": "ManhattanMST",
    "body": [
      "/**",
      " * Description: Compute minimum spanning tree of points where edges are manhattan distances ",
      " * Time: O(N\\\\log N)",
      " * Source: Rezwan Arefin",
      " * Verification: ",
      "\t* https://open.kattis.com/problems/gridmst",
      "\t* CSA 84 The Sprawl",
      "\t* TC 760 ComponentsForever",
      " */",
      "",
      "#include \"MST.h\"",
      "",
      "int N;",
      "vector<array<int,3>> cur;",
      "vector<pair<int,pi>> ed;",
      "vi ind;",
      "",
      "struct {",
      "\tmap<int,pi> m;",
      "\tvoid upd(int a, pi b) { ",
      "\t\tauto it = m.lower_bound(a);",
      "\t\tif (it != m.end() && it->s <= b) return;",
      "\t\tm[a] = b; it = m.find(a);",
      "\t\twhile (it != m.begin() && prev(it)->s >= b) m.erase(prev(it));",
      "\t}",
      "\tpi query(int y) { // for all a > y find min possible value of b ",
      "\t\tauto it = m.upper_bound(y);",
      "\t\tif (it == m.end()) return {2*MOD,2*MOD};",
      "\t\treturn it->s;",
      "\t}",
      "} S;",
      "",
      "void solve() {",
      "\tsort(all(ind),[](int a, int b) { return cur[a][0] > cur[b][0]; });",
      "\tS.m.clear();",
      "\tint nex = 0;",
      "\ttrav(x,ind) { // cur[x][0] <= ?, cur[x][1] < ? ",
      "\t\twhile (nex < N && cur[ind[nex]][0] >= cur[x][0]) {",
      "\t\t\tint b = ind[nex++]; ",
      "\t\t\tS.upd(cur[b][1],{cur[b][2],b});",
      "\t\t}",
      "\t\tpi t = S.query(cur[x][1]);",
      "\t\tif (t.s != 2*MOD) ed.pb({(int)t.f-cur[x][2],{x,t.s}});",
      "\t}",
      "}",
      "",
      "int mst(vpi v) {",
      "\tN = sz(v); cur.resize(N); ed.clear(); ",
      "\tind.clear(); F0R(i,N) ind.pb(i);",
      "\tsort(all(ind),[&v](int a, int b) { return v[a] < v[b]; });",
      "\tF0R(i,N-1) if (v[ind[i]] == v[ind[i+1]]) ed.pb({0,{ind[i],ind[i+1]}});",
      "\tF0R(i,2) { // it's probably ok to consider just two quadrants?",
      "\t\tF0R(i,N) {",
      "\t\t\tauto a = v[i];",
      "\t\t\tcur[i][2] = a.f+a.s;",
      "\t\t}",
      "\t\tF0R(i,N) { // first octant",
      "\t\t\tauto a = v[i];",
      "\t\t\tcur[i][0] = a.f-a.s;",
      "\t\t\tcur[i][1] = a.s;",
      "\t\t}",
      "\t\tsolve();",
      "\t\tF0R(i,N) { // second octant",
      "\t\t\tauto a = v[i];",
      "\t\t\tcur[i][0] = a.f;",
      "\t\t\tcur[i][1] = a.s-a.f;",
      "\t\t}",
      "\t\tsolve();",
      "\t\ttrav(a,v) a = {a.s,-a.f}; // rotate 90 degrees, repeat",
      "\t}",
      "\treturn kruskal(ed);",
      "}"
    ],
    "description": "graph/Fundamentals/ManhattanMST.h"
  },
  "content/graph/Trees/CentroidDecomp.h": {
    "scope": "cpp,c",
    "prefix": "CentroidDecomp",
    "body": [
      "/**",
      " * Description: can support tree path queries and updates",
      " * Time: \\$O(N\\\\log N)\\$",
      " * Source: own",
      " * Verification: ",
      "\t* https://codeforces.com/contest/342/problem/E",
      "\t* Triway Cup 2019 G",
      " */",
      "",
      "template<int SZ> struct centroidDecomp {",
      "    vi neighbor[SZ];",
      "    int subsize[SZ];",
      "    bool vis[SZ];",
      "    int p[SZ];",
      "    int par[SZ];",
      "    vi child[SZ];",
      "    int numNodes;",
      "    ",
      "    centroidDecomp(int num) {",
      "        this->numNodes = num;",
      "    }",
      "    void addEdge(int u, int v) {",
      "        neighbor[u].PB(v);",
      "        neighbor[v].PB(u);",
      "    }",
      "    void build() {",
      "        M00(i, numNodes) vis[i] = 0, par[i] = -1;",
      "        solve(0);",
      "        M00(i, numNodes) if(par[i] != -1) child[par[i]].PB(i);",
      "    }",
      "    void getSizes(int node) {",
      "        subsize[node] = 1;",
      "        for(int ch: neighbor[node]) if(!vis[ch] && ch != p[node]) {",
      "            p[ch] = node;",
      "            getSizes(ch);",
      "            subsize[node] += subsize[ch];",
      "        }",
      "    }",
      "    int getCentroid(int root) {",
      "        p[root] = -1;",
      "        getSizes(root);",
      "        int cur = root;",
      "        while(1) {",
      "            pi hi = MP(subsize[root]-subsize[cur], cur);",
      "            for(int v: neighbor[cur]) if(!vis[v] && v != p[cur]) hi = max(hi, MP(subsize[v], v));",
      "            if(hi.F <= subsize[root]/2) return cur;",
      "            cur = hi.S;",
      "        }",
      "    }",
      "    int solve(int node) {",
      "        node = getCentroid(node);",
      "        vis[node] = 1;",
      "        for(int ch: neighbor[node]) if(!vis[ch]) par[solve(ch)] = node;",
      "        return node;",
      "    }",
      "};"
    ],
    "description": "graph/Trees/CentroidDecomp.h"
  },
  "content/graph/Trees/HLD.h": {
    "scope": "cpp,c",
    "prefix": "HLD",
    "body": [
      "/**",
      " * Description: Heavy Light Decomposition",
      " * Time: \\$O(\\\\log^2 N)\\$ per path operations",
      " * Source: http://codeforces.com/blog/entry/22072, https://codeforces.com/blog/entry/53170",
      " * Verification: USACO Grass Planting, https://www.hackerrank.com/challenges/subtrees-and-paths",
      " */",
      "",
      "template<int SZ, bool VALUES_IN_EDGES> struct HLD { ",
      "\tint N; vi adj[SZ];",
      "\tint par[SZ], sz[SZ], depth[SZ];",
      "\tint root[SZ], pos[SZ];",
      "\tLazySegTree<int,SZ> tree;",
      "\tvoid addEdge(int a, int b) { adj[a].pb(b), adj[b].pb(a); }",
      "\t",
      "\tvoid dfs_sz(int v = 1) {",
      "\t\tif (par[v]) adj[v].erase(find(all(adj[v]),par[v]));",
      "\t\tsz[v] = 1;",
      "\t\ttrav(u,adj[v]) {",
      "\t\t\tpar[u] = v; depth[u] = depth[v]+1;",
      "\t\t\tdfs_sz(u); sz[v] += sz[u];",
      "\t\t\tif (sz[u] > sz[adj[v][0]]) swap(u, adj[v][0]);",
      "\t\t}",
      "\t}",
      "\tvoid dfs_hld(int v = 1) {",
      "\t\tstatic int t = 0;",
      "\t\tpos[v] = t++;",
      "\t\ttrav(u,adj[v]) {",
      "\t\t\troot[u] = (u == adj[v][0] ? root[v] : u);",
      "\t\t\tdfs_hld(u);",
      "\t\t}",
      "\t}",
      "\tvoid init(int _N) {",
      "\t\tN = _N; par[1] = depth[1] = 0; root[1] = 1; ",
      "\t\tdfs_sz(); dfs_hld();",
      "\t}",
      "",
      "\ttemplate <class BinaryOperation>",
      "\tvoid processPath(int u, int v, BinaryOperation op) {",
      "\t\tfor (; root[u] != root[v]; v = par[root[v]]) {",
      "\t\t\tif (depth[root[u]] > depth[root[v]]) swap(u, v);",
      "\t\t\top(pos[root[v]], pos[v]);",
      "\t\t}",
      "\t\tif (depth[u] > depth[v]) swap(u, v);",
      "\t\top(pos[u]+VALUES_IN_EDGES, pos[v]); ",
      "\t}",
      "",
      "\tvoid modifyPath(int u, int v, int val) { // add val to vertices/edges along path",
      "\t\tprocessPath(u, v, [this, &val](int l, int r) { tree.upd(l, r, val); });",
      "\t}",
      "\tvoid modifySubtree(int v, int val) { // add val to vertices/edges in subtree",
      "\t\ttree.upd(pos[v]+VALUES_IN_EDGES,pos[v]+sz[v]-1,val);",
      "\t}",
      "\tint queryPath(int u, int v) { // query sum of path",
      "\t\tint res = 0; processPath(u, v, [this, &res](int l, int r) { res += tree.qsum(l, r); });",
      "\t\treturn res;",
      "\t}",
      "};"
    ],
    "description": "graph/Trees/HLD.h"
  },
  "content/graph/Trees/LCAjumps.h": {
    "scope": "cpp,c",
    "prefix": "LCAjumps",
    "body": [
      "/**",
      " * Description: calculates least common ancestor in tree with binary jumping",
      " * Time: O(N\\\\log N)",
      " * Source: USACO Camp",
      " * Verification: Debug the Bugs",
      " */",
      "",
      "template<int SZ> struct tree {",
      "    vector<pair<int, int>> adj[SZ];",
      "    const static int LGSZ = 32-__builtin_clz(SZ-1);",
      "    pair<int, int> ppar[SZ][LGSZ];",
      "    int depth[SZ];",
      "    int distfromroot[SZ];",
      "    ",
      "    void addEdge(int u, int v, int d) {",
      "        adj[u].PB(MP(v, d));",
      "        adj[v].PB(MP(u, d));",
      "    }",
      "    void dfs(int u, int dep, int dis) {",
      "        depth[u] = dep;",
      "        distfromroot[u] = dis;",
      "        for(auto& v: adj[u]) if(ppar[u][0].F != v.F) {",
      "            ppar[v.F][0] = MP(u, v.S);",
      "            dfs(v.F, dep + 1, dis + v.S);",
      "        }",
      "    }",
      "    void build() {",
      "        ppar[0][0] = MP(0, 0);",
      "        M00(i, SZ) depth[i] = 0;",
      "        dfs(0, 0, 0);",
      "        MOO(i, 1, LGSZ) M00(j, SZ) {",
      "            ppar[j][i].F = ppar[ppar[j][i-1].F][i-1].F;",
      "            ppar[j][i].S = ppar[j][i-1].S + ppar[ppar[j][i-1].F][i-1].S;",
      "        }",
      "    }",
      "    int lca(int u, int v) {",
      "        if(depth[u] < depth[v]) swap(u, v);",
      "        M00d(i, LGSZ) if(depth[ppar[u][i].F] >= depth[v]) u = ppar[u][i].F;",
      "        if(u == v) return u;",
      "        M00d(i, LGSZ) {",
      "            if(ppar[u][i].F != ppar[v][i].F) {",
      "                u = ppar[u][i].F;",
      "                v = ppar[v][i].F;",
      "            }",
      "        }",
      "        return ppar[u][0].F;",
      "    }",
      "    int dist(int u, int v) {",
      "        return distfromroot[u] + distfromroot[v] - 2*distfromroot[lca(u, v)];",
      "    }",
      "};"
    ],
    "description": "graph/Trees/LCAjumps.h"
  },
  "content/graph/Trees/LCArmq.h": {
    "scope": "cpp,c",
    "prefix": "LCArmq",
    "body": [
      "/**",
      " * Description: Euler Tour LCA w/ O(1) query",
      " * Source: own",
      " * Verification: USACO Debug the Bugs",
      " */",
      "",
      "template<int SZ> struct tree {",
      "    vector<pair<int, int>> adj[SZ];",
      "    pair<int, int> par[SZ];",
      "    const static int LGSZ = 33-__builtin_clz(SZ-1);",
      "    int distfromroot[SZ];",
      "    int depth[SZ], t, tin[SZ], RMQ[2*SZ-1][LGSZ], oldToNew[SZ], newToOld[SZ], numNodes;",
      "    ",
      "    void addEdge(int u, int v, int d) {",
      "        adj[u].PB(MP(v, d));",
      "        adj[v].PB(MP(u, d));",
      "    }",
      "    void dfs(int u, int dep, int dis) {",
      "        depth[u] = dep;",
      "        distfromroot[u] = dis;",
      "        for(auto& v: adj[u]) if(par[u].F != v.F) {",
      "            par[v.F] = MP(u, v.S);",
      "            dfs(v.F, dep + 1, dis + v.S);",
      "        }",
      "    }",
      "    void buildtarr(int u) {",
      "        RMQ[t][0] = oldToNew[u], tin[oldToNew[u]] = t++;",
      "        for(auto& v: adj[u]) if(par[u].F != v.F) {",
      "            buildtarr(v.F);",
      "            RMQ[t++][0] = oldToNew[u];",
      "        }",
      "    }",
      "    void build(int n) {",
      "        this->numNodes = n;",
      "        par[0] = MP(0, 0);",
      "        M00(i, numNodes) depth[i] = 0;",
      "        dfs(0, 0, 0);",
      "        t = 0;",
      "        queue<int> q;",
      "        q.push(0);",
      "        while(!q.empty()) {",
      "            int u = q.front(); q.pop();",
      "            oldToNew[u] = t++;",
      "            for(auto& v: adj[u]) if(par[u].F != v.F) q.push(v.F);",
      "        }",
      "        M00(i, numNodes) newToOld[oldToNew[i]] = i;",
      "        t = 0;",
      "        buildtarr(0);",
      "        MOO(j, 1, LGSZ) M00(i, 2*numNodes-1) if(i+(1<<(j-1)) < 2*numNodes-1)",
      "            RMQ[i][j] = min(RMQ[i][j-1], RMQ[i+(1<<(j-1))][j-1]);",
      "    }",
      "    int lca(int u, int v) {",
      "        u = oldToNew[u], v = oldToNew[v];",
      "        if(tin[u] > tin[v]) swap(u, v);",
      "        int l = tin[u];",
      "        int r = tin[v];",
      "        int len = r-l+1;",
      "        int hl = 31-__builtin_clz(len-1);",
      "        return newToOld[min(RMQ[l][hl], RMQ[r-(1<<hl)+1][hl])];",
      "    }",
      "    int dist(int u, int v) {",
      "        return distfromroot[u]+distfromroot[v]-2*distfromroot[lca(u, v)];",
      "    }",
      "};"
    ],
    "description": "graph/Trees/LCArmq.h"
  },
