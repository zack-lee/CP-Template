  "content/graph/DFS/BCC.h": {
    "scope": "cpp,c",
    "prefix": "BCC",
    "body": [
      "/**",
      " * Description: computes biconnected components",
      " * Time: O(N+M)",
      " * Source: GeeksForGeeks (corrected)",
      " * Verification: USACO December 2017, Push a Box",
      "\t* https://pastebin.com/yUWuzTH8",
      " */",
      "",
      "template<int SZ> struct BCC {",
      "\tint N;",
      "\tvpi adj[SZ], ed;",
      "\tvoid addEdge(int u, int v) { ",
      "\t\tadj[u].pb({v,sz(ed)}), adj[v].pb({u,sz(ed)}); ",
      "\t\ted.pb({u,v});",
      "\t}",
      "",
      "\tint disc[SZ];",
      "\tvi st; vector<vi> fin;",
      "\tint bcc(int u, int p = -1) { // return lowest disc",
      "\t\tstatic int ti = 0;",
      "\t\tdisc[u] = ++ti; int low = disc[u];",
      "\t\tint child = 0;",
      "\t\ttrav(i,adj[u]) if (i.s != p)",
      "\t\t\tif (!disc[i.f]) {",
      "\t\t\t\tchild ++; st.pb(i.s);",
      "\t\t\t\tint LOW = bcc(i.f,i.s); ckmin(low,LOW);",
      "\t\t\t\t// disc[u] < LOW -> bridge",
      "\t\t\t\tif (disc[u] <= LOW) { ",
      "\t\t\t\t\t// if (p != -1 || child > 1) -> u is articulation point",
      "\t\t\t\t\tvi tmp; while (st.back() != i.s) tmp.pb(st.back()), st.pop_back();",
      "\t\t\t\t\ttmp.pb(st.back()), st.pop_back();",
      "\t\t\t\t\tfin.pb(tmp); ",
      "\t\t\t\t}",
      "\t\t\t} else if (disc[i.f] < disc[u]) {",
      "\t\t\t\tckmin(low,disc[i.f]);",
      "\t\t\t\tst.pb(i.s);",
      "\t\t\t}",
      "\t\treturn low;",
      "\t}",
      "",
      "\tvoid init(int _N) {",
      "\t\tN = _N; F0R(i,N) disc[i] = 0;",
      "\t\tF0R(i,N) if (!disc[i]) bcc(i); // st should be empty after each iteration",
      "\t}",
      "};"
    ],
    "description": "graph/DFS/BCC.h"
  },
  "content/graph/DFS/EulerPath.h": {
    "scope": "cpp,c",
    "prefix": "EulerPath",
    "body": [
      "/**",
      " * Description: Eulerian Path for both directed and undirected graphs",
      " * Time: \\$O(N+M)\\$ ",
      " * Source: ",
      "\t* USACO Training",
      "\t* MIT ICPC Notebook",
      " * Verification:",
      "\t* directed -> https://open.kattis.com/problems/eulerianpath",
      "\t* undirected -> USACO Training 3.3, Riding the Fences",
      " */",
      "",
      "template<int SZ, bool directed> struct Euler {",
      "\tint N, M = 0;",
      "\tvpi adj[SZ];",
      "\tvpi::iterator its[SZ];",
      "\tvector<bool> used;",
      "",
      "\tvoid addEdge(int a, int b) {",
      "\t\tif (directed) adj[a].pb({b,M});",
      "\t\telse adj[a].pb({b,M}), adj[b].pb({a,M});",
      "\t\tused.pb(0); M ++;",
      "\t}",
      "",
      "\tvpi solve(int _N, int src = 1) {",
      "\t\tN = _N; ",
      "\t\tFOR(i,1,N+1) its[i] = begin(adj[i]);",
      "\t\tvector<pair<pi,int>> ret, s = {{{src,-1},-1}};",
      "\t\twhile (sz(s)) {",
      "\t\t\tint x = s.back().f.f;",
      "\t\t\tauto& it = its[x], end = adj[x].end();",
      "\t\t\twhile (it != end && used[it->s]) it ++;",
      "\t\t\tif (it == end) { ",
      "\t\t\t\tif (sz(ret) && ret.back().f.s != s.back().f.f) return {}; // path isn't valid",
      "\t\t\t\tret.pb(s.back()), s.pop_back(); ",
      "\t\t\t} else { s.pb({{it->f,x},it->s}); used[it->s] = 1; }",
      "\t\t}",
      "\t\tif (sz(ret) != M+1) return {};",
      "\t\tvpi ans; trav(t,ret) ans.pb({t.f.f,t.s});",
      "\t\treverse(all(ans)); return ans;",
      "\t}",
      "};"
    ],
    "description": "graph/DFS/EulerPath.h"
  },
  "content/graph/DFS/SCC.h": {
    "scope": "cpp,c",
    "prefix": "SCC",
    "body": [
      "/**",
      " * Description: Kosaraju's Algorithm:",
      "\t* DFS two times to generate SCCs in topological order",
      " * Time: \\$O(N+M)\\$",
      " * Source: Wikipedia",
      " * Verification: POI 8 peaceful commission",
      " */",
      "",
      "template<int SZ> struct SCC {",
      "\tint N, comp[SZ];",
      "\tvi adj[SZ], radj[SZ], todo, allComp;",
      "\tbitset<SZ> visit;",
      "\tvoid addEdge(int a, int b) { adj[a].pb(b), radj[b].pb(a); }",
      "",
      "\tvoid dfs(int v) {",
      "\t\tvisit[v] = 1;",
      "\t\ttrav(w,adj[v]) if (!visit[w]) dfs(w);",
      "\t\ttodo.pb(v);",
      "\t}",
      "\tvoid dfs2(int v, int val) {",
      "\t\tcomp[v] = val;",
      "\t\ttrav(w,radj[v]) if (comp[w] == -1) dfs2(w,val);",
      "\t}",
      "",
      "\tvoid init(int _N) { // fills allComp",
      "\t\tN = _N;",
      "\t\tF0R(i,N) comp[i] = -1, visit[i] = 0;",
      "\t\tF0R(i,N) if (!visit[i]) dfs(i);",
      "\t\treverse(all(todo)); // now todo stores vertices in order of topological sort",
      "\t\ttrav(i,todo) if (comp[i] == -1) dfs2(i,i), allComp.pb(i);",
      "\t}",
      "};"
    ],
    "description": "graph/DFS/SCC.h"
  },
