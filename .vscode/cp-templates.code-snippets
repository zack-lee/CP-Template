  "content/graph/DFS/2SAT.h": {
    "scope": "cpp,c",
    "prefix": "2SAT",
    "body": [
      "/**",
      " * Description: ?",
      " * Source: KACTL",
      " * Verification: https://codeforces.com/contest/1007/problem/D",
      " */",
      "",
      "#include \"SCC.h\"",
      "",
      "template<int SZ> struct TwoSat {",
      "\tSCC<2*SZ> S;",
      "\tbitset<SZ> ans;",
      "\tint N = 0;",
      "\tint addVar() { return N++; }",
      "",
      "\tvoid either(int x, int y) { ",
      "\t\tx = max(2*x,-1-2*x), y = max(2*y,-1-2*y);",
      "\t\tS.addEdge(x^1,y); S.addEdge(y^1,x); ",
      "\t}",
      "\tvoid implies(int x, int y) { either(~x,y); }",
      "\tvoid setVal(int x) { either(x,x); }",
      "\tvoid atMostOne(const vi& li) {",
      "\t\tif (sz(li) <= 1) return;",
      "\t\tint cur = ~li[0];",
      "\t\tFOR(i,2,sz(li)) {",
      "\t\t\tint next = addVar();",
      "\t\t\teither(cur,~li[i]);",
      "\t\t\teither(cur,next);",
      "\t\t\teither(~li[i],next);",
      "\t\t\tcur = ~next;",
      "\t\t}",
      "\t\teither(cur,~li[1]);",
      "\t}",
      "",
      "\tbool solve(int _N) {",
      "\t\tif (_N != -1) N = _N; ",
      "\t\tS.init(2*N);",
      "\t\tfor (int i = 0; i < 2*N; i += 2) ",
      "\t\t\tif (S.comp[i] == S.comp[i^1]) return 0;",
      "\t\treverse(all(S.allComp));",
      "\t\tvi tmp(2*N);",
      "\t\ttrav(i,S.allComp) if (tmp[i] == 0) ",
      "\t\t\ttmp[i] = 1, tmp[S.comp[i^1]] = -1;",
      "\t\tF0R(i,N) if (tmp[S.comp[2*i]] == 1) ans[i] = 1;",
      "\t\treturn 1;",
      "\t}",
      "};"
    ],
    "description": "graph/DFS/2SAT.h"
