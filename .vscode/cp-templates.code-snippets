    "scope": "cpp,c",
    "prefix": "TreeDiameter",
    "body": [
      "/**",
      " * Description: Calculates longest path in tree",
      " * Source: own",
      " * Verification: ",
      "   * http://www.spoj.com/problems/PT07Z/",
      "   * https://codeforces.com/contest/1182/problem/D",
      " */",
      "",
      "template<int SZ> struct TreeDiameter {",
      "\tint n; ",
      "\tvi adj[SZ];",
      "\tvoid addEdge(int a, int b) { adj[a].pb(b), adj[b].pb(a); }",
      "",
      "\tint par[SZ], dist[SZ];",
      "\tvoid dfs(int x) {",
      "\t\ttrav(y,adj[x]) if (y != par[x]) {",
      "\t\t\tpar[y] = x; dist[y] = dist[x]+1;",
      "\t\t\tdfs(y);",
      "\t\t}",
      "\t}",
      "\tvoid genDist(int x) { par[x] = -1; dist[x] = 0; dfs(x); }",
      "",
      "\tint diaLength;",
      "\tvi center, dia = {1,1}; ",
      "\tvoid init(int _n) {",
      "\t\tn = _n; ",
      "\t\tgenDist(1); FOR(i,1,n+1) if (dist[i] > dist[dia[0]]) dia[0] = i; // find one endpoint of a diameter",
      "\t\tgenDist(dia[0]); FOR(i,1,n+1) if (dist[i] > dist[dia[1]]) dia[1] = i;",
      "\t\tdiaLength = dist[dia[1]];",
      "\t\t",
      "\t\tint cen = dia[1]; F0R(i,diaLength/2) cen = par[cen];",
      "\t\tif (diaLength&1) center = {cen,par[cen]};",
      "\t\telse center = {cen};",
      "\t}",
      "};"
