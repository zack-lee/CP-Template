  "content/num/Misc/IntegrateAdaptive.h": {
    "scope": "cpp,c",
    "prefix": "IntegrateAdaptive",
    "body": [
      "/**",
      " * Description: ?",
      " * Source: KACTL",
      "\t* https://en.wikipedia.org/wiki/Adaptive_Simpson%27s_method",
      " * Verification: ?",
      " */",
      "",
      "// db f(db x) { return x*x+3*x+1; }",
      "",
      "db simpson(db (*f)(db), db a, db b) {",
      "\tdb c = (a+b) / 2;",
      "\treturn (f(a) + 4*f(c) + f(b)) * (b-a) / 6;",
      "}",
      "",
      "db rec(db (*f)(db), db a, db b, db eps, db S) {",
      "\tdb c = (a+b) / 2;",
      "\tdb S1 = simpson(f, a, c);",
      "\tdb S2 = simpson(f, c, b), T = S1 + S2;",
      "\tif (abs(T - S) <= 15*eps || b-a < 1e-10)",
      "\t\treturn T + (T - S) / 15;",
      "\treturn rec(f, a, c, eps/2, S1) + rec(f, c, b, eps/2, S2);",
      "}",
      "",
      "db quad(db (*f)(db), db a, db b, db eps = 1e-8) {",
      "\treturn rec(f, a, b, eps, simpson(f, a, b));",
      "}"
    ],
    "description": "num/Misc/IntegrateAdaptive.h"
  },
  "content/num/Misc/LinRec.h": {
    "scope": "cpp,c",
    "prefix": "LinRec",
    "body": [
      "/**",
      " * Description: Berlekamp-Massey: computes linear recurrence of ",
      " * order \\$n\\$ for sequence of \\$2n\\$ terms",
      " * Time: ?",
      " * Source: ",
      "\t* https://en.wikipedia.org/wiki/Berlekamp%E2%80%93Massey_algorithm",
      "\t* http://codeforces.com/blog/entry/61306",
      "\t* MIT ICPC notebook",
      " * Verification: http://codeforces.com/contest/506/problem/E",
      " */",
      "",
      "using namespace vecOp;",
      "",
      "struct LinRec {",
      "\tvmi x; // original sequence",
      "\tvmi C, rC;",
      "\tvoid init(const vmi& _x) {",
      "\t\tx = _x; int n = sz(x), m = 0;",
      "\t\tvmi B; B = C = {1}; // B is fail vector",
      "\t",
      "\t\tmi b = 1; // B gives 0,0,0,...,b",
      "\t\tF0R(i,n) {",
      "\t\t\tm ++;",
      "\t\t\tmi d = x[i]; FOR(j,1,sz(C)) d += C[j]*x[i-j];",
      "\t\t\tif (d == 0) continue; // recurrence still works",
      "\t\t\tauto _B = C; C.resize(max(sz(C),m+sz(B)));",
      "\t\t\tmi coef = d/b; FOR(j,m,m+sz(B)) C[j] -= coef*B[j-m]; // recurrence that gives 0,0,0,...,d",
      "\t\t\tif (sz(_B) < m+sz(B)) { B = _B; b = d; m = 0; }",
      "\t\t}",
      "\t",
      "\t\trC = C; reverse(all(rC)); // polynomial for getPo",
      "\t\tC.erase(begin(C)); trav(t,C) t *= -1; // x[i]=sum_{j=0}^{sz(C)-1}C[j]*x[i-j-1]",
      "\t}",
      "\t",
      "\tvmi getPo(int n) {",
      "\t\tif (n == 0) return {1};",
      "\t\tvmi x = getPo(n/2); x = rem(x*x,rC);",
      "\t\tif (n&1) { vmi v = {0,1}; x = rem(x*v,rC); }",
      "\t\treturn x;",
      "\t}",
      "\tmi eval(int n) {",
      "\t\tvmi t = getPo(n);",
      "\t\tmi ans = 0; F0R(i,sz(t)) ans += t[i]*x[i];",
      "\t\treturn ans;",
      "\t}",
      "};"
    ],
    "description": "num/Misc/LinRec.h"
  },
  "content/num/Misc/Simplex.h": {
    "scope": "cpp,c",
    "prefix": "Simplex",
    "body": [
      "/**",
      " * Description: Simplex algorithm for linear programming,",
      "\t* maximize \\$c^Tx\\$ subject to \\$Ax \\\\le b, x \\\\ge 0\\$",
      " * Time: ?",
      " * Source: KACTL, Stanford",
      "\t* https://cs.stanford.edu/group/acm/SLPC/notebook.pdf",
      "\t* https://www.utdallas.edu/~scniu/OPRE-6201/documents/LP06-Simplex-Tableau.pdf",
      "\t* http://www.columbia.edu/~cs2035/courses/ieor3608.F05/bigm1.pdf",
      " * Verification:",
      "\t* https://open.kattis.com/contests/fvfhq4/problems/goatropes",
      "\t* http://codeforces.com/contest/375/problem/E",
      "\t* USACO Training cowwars",
      " */",
      " ",
      "typedef double T;",
      "typedef vector<T> vd;",
      "typedef vector<vd> vvd;",
      "const T eps = 1e-8, inf = 1/.0;",
      "",
      "#define ltj(X) if (s == -1 || mp(X[j],N[j]) < mp(X[s],N[s])) s=j",
      "",
      "struct LPSolver {",
      "\tint m, n;",
      "\tvi N, B;",
      "\tvvd D;",
      "",
      "\tLPSolver(const vvd& A, const vd& b, const vd& c) :",
      "\t\tm(sz(b)), n(sz(c)), N(n+1), B(m), D(m+2, vd(n+2)) {",
      "\t\t\tF0R(i,m) F0R(j,n) D[i][j] = A[i][j];",
      "\t\t\tF0R(i,m) { B[i] = n+i; D[i][n] = -1; D[i][n+1] = b[i]; } // B[i] -> basic variables, col n+1 is for constants, why D[i][n]=-1?",
      "\t\t\tF0R(j,n) { N[j] = j; D[m][j] = -c[j]; } // N[j] -> non-basic variables, all zero",
      "\t\t\tN[n] = -1; D[m+1][n] = 1;",
      "\t\t}",
      "",
      "\tvoid print() {",
      "\t\tps(\"D\");",
      "\t\ttrav(t,D) ps(t);",
      "\t\tps();",
      "\t\tps(\"B\",B); ",
      "\t\tps(\"N\",N);",
      "\t\tps();",
      "\t}",
      "\t",
      "\tvoid pivot(int r, int s) { // row, column",
      "\t\tT *a = D[r].data(), inv = 1/a[s]; // eliminate col s from consideration",
      "\t\tF0R(i,m+2) if (i != r && abs(D[i][s]) > eps) {",
      "\t\t\tT *b = D[i].data(), inv2 = b[s]*inv;",
      "\t\t\tF0R(j,n+2) b[j] -= a[j]*inv2;",
      "\t\t\tb[s] = a[s]*inv2;",
      "\t\t}",
      "\t\tF0R(j,n+2) if (j != s) D[r][j] *= inv;",
      "\t\tF0R(i,m+2) if (i != r) D[i][s] *= -inv;",
      "\t\tD[r][s] = inv; swap(B[r], N[s]); // swap a basic and non-basic variable",
      "\t}",
      "",
      "\tbool simplex(int phase) {",
      "\t\tint x = m+phase-1;",
      "\t\tfor (;;) {",
      "\t\t\tint s = -1; F0R(j,n+1) if (N[j] != -phase) ltj(D[x]); // find most negative col",
      "\t\t\tif (D[x][s] >= -eps) return true; // have best solution",
      "\t\t\tint r = -1;",
      "\t\t\tF0R(i,m) {",
      "\t\t\t\tif (D[i][s] <= eps) continue;",
      "\t\t\t\tif (r == -1 || mp(D[i][n+1] / D[i][s], B[i])",
      "\t\t\t\t\t\t\t < mp(D[r][n+1] / D[r][s], B[r])) r = i; // find smallest positive ratio",
      "\t\t\t}",
      "\t\t\tif (r == -1) return false; // unbounded",
      "\t\t\tpivot(r, s);",
      "\t\t}",
      "\t}",
      "",
      "\tT solve(vd &x) {",
      "\t\tint r = 0; FOR(i,1,m) if (D[i][n+1] < D[r][n+1]) r = i;",
      "\t\tif (D[r][n+1] < -eps) { // x=0 is not a solution",
      "\t\t\tpivot(r, n); // -1 is artificial variable, initially set to smth large but want to get to 0 ",
      "\t\t\tif (!simplex(2) || D[m+1][n+1] < -eps) return -inf; // no solution",
      "\t\t\t// D[m+1][n+1] is max possible value of the negation of artificial variable, starts negative but should get to zero",
      "\t\t\tF0R(i,m) if (B[i] == -1) {",
      "\t\t\t\tint s = 0; FOR(j,1,n+1) ltj(D[i]);",
      "\t\t\t\tpivot(i,s);",
      "\t\t\t}",
      "\t\t}",
      "\t\tbool ok = simplex(1); x = vd(n);",
      "\t\tF0R(i,m) if (B[i] < n) x[B[i]] = D[i][n+1];",
      "\t\treturn ok ? D[m][n+1] : inf;",
      "\t}",
      "};"
    ],
    "description": "num/Misc/Simplex.h"
  },
  "content/num/Arithmetic/BigInt.h": {
    "scope": "cpp,c",
    "prefix": "BigInt",
    "body": [
      "/**",
      " * Description: Big Integer",
      " * Source: https://github.com/indy256/codelibrary/",
      "\t\t\tblob/master/cpp/numbertheory/bigint.cpp",
      " * Verification: https://oj.uz/problem/view/IOI11_parrots",
      " */",
      "",
      "// base and base_digits must be consistent",
      "constexpr int base = 1000000000;",
      "constexpr int base_digits = 9;",
      "",
      "struct bigint {",
      "\t// value == 0 is represented by empty z",
      "\tvector<int> z; // digits",
      "",
      "\t// sign == 1 <==> value >= 0",
      "\t// sign == -1 <==> value < 0",
      "\tint sign;",
      "",
      "\tbigint() : sign(1) {}",
      "\tbigint(long long v) { *this = v; }",
      "",
      "\tbigint &operator=(long long v) {",
      "\t\tsign = v < 0 ? -1 : 1; v *= sign;",
      "\t\tz.clear(); for (; v > 0; v = v / base) z.push_back((int) (v % base));",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tbigint(const string &s) { read(s); }",
      "",
      "\tbigint &operator+=(const bigint &other) {",
      "\t\tif (sign == other.sign) {",
      "\t\t\tfor (int i = 0, carry = 0; i < other.z.size() || carry; ++i) {",
      "\t\t\t\tif (i == z.size())",
      "\t\t\t\t\tz.push_back(0);",
      "\t\t\t\tz[i] += carry + (i < other.z.size() ? other.z[i] : 0);",
      "\t\t\t\tcarry = z[i] >= base;",
      "\t\t\t\tif (carry)",
      "\t\t\t\t\tz[i] -= base;",
      "\t\t\t}",
      "\t\t} else if (other != 0 /* prevent infinite loop */) {",
      "\t\t\t*this -= -other;",
      "\t\t}",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tfriend bigint operator+(bigint a, const bigint &b) { return a += b; }",
      "",
      "\tbigint &operator-=(const bigint &other) {",
      "\t\tif (sign == other.sign) {",
      "\t\t\tif (sign == 1 && *this >= other || sign == -1 && *this <= other) {",
      "\t\t\t\tfor (int i = 0, carry = 0; i < other.z.size() || carry; ++i) {",
      "\t\t\t\t\tz[i] -= carry + (i < other.z.size() ? other.z[i] : 0);",
      "\t\t\t\t\tcarry = z[i] < 0;",
      "\t\t\t\t\tif (carry)",
      "\t\t\t\t\t\tz[i] += base;",
      "\t\t\t\t}",
      "\t\t\t\ttrim();",
      "\t\t\t} else {",
      "\t\t\t\t*this = other - *this;",
      "\t\t\t\tthis->sign = -this->sign;",
      "\t\t\t}",
      "\t\t} else {",
      "\t\t\t*this += -other;",
      "\t\t}",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tfriend bigint operator-(bigint a, const bigint &b) { return a -= b; }",
      "",
      "\tbigint &operator*=(int v) {",
      "\t\tif (v < 0) sign = -sign, v = -v;",
      "\t\tfor (int i = 0, carry = 0; i < z.size() || carry; ++i) {",
      "\t\t\tif (i == z.size())",
      "\t\t\t\tz.push_back(0);",
      "\t\t\tlong long cur = (long long) z[i] * v + carry;",
      "\t\t\tcarry = (int) (cur / base);",
      "\t\t\tz[i] = (int) (cur % base);",
      "\t\t}",
      "\t\ttrim();",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tbigint operator*(int v) const { return bigint(*this) *= v; }",
      "",
      "\tfriend pair<bigint, bigint> divmod(const bigint &a1, const bigint &b1) {",
      "\t\tint norm = base / (b1.z.back() + 1);",
      "\t\tbigint a = a1.abs() * norm;",
      "\t\tbigint b = b1.abs() * norm;",
      "\t\tbigint q, r;",
      "\t\tq.z.resize(a.z.size());",
      "",
      "\t\tfor (int i = (int) a.z.size() - 1; i >= 0; i--) {",
      "\t\t\tr *= base;",
      "\t\t\tr += a.z[i];",
      "\t\t\tint s1 = b.z.size() < r.z.size() ? r.z[b.z.size()] : 0;",
      "\t\t\tint s2 = b.z.size() - 1 < r.z.size() ? r.z[b.z.size() - 1] : 0;",
      "\t\t\tint d = (int) (((long long) s1 * base + s2) / b.z.back());",
      "\t\t\tr -= b * d;",
      "\t\t\twhile (r < 0)",
      "\t\t\t\tr += b, --d;",
      "\t\t\tq.z[i] = d;",
      "\t\t}",
      "",
      "\t\tq.sign = a1.sign * b1.sign;",
      "\t\tr.sign = a1.sign;",
      "\t\tq.trim();",
      "\t\tr.trim();",
      "\t\treturn {q, r / norm};",
      "\t}",
      "",
