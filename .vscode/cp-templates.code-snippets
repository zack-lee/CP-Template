      "",
      "struct SmallToLarge {",
      "\tint val[MX];",
      "\tvi child[MX];",
      "\tmap<int,int> dat[MX];",
      "\t",
      "\tvoid comb(int a, int b) {",
      "\t\tbool swa = 0;",
      "\t\tif (sz(dat[a]) < sz(dat[b])) swap(a,b), swa = 1; // swapping doesn't seem to work for indexed set",
      "\t\ttrav(x,dat[b]) dat[a][x.f] += x.s;",
      "\t\tdat[b].clear();",
      "\t\tif (swa) swap(dat[a],dat[b]);",
      "\t}",
      "\t",
      "\tvoid process(int ind) {",
      "\t\tdat[ind][val[ind]] ++;",
      "\t\ttrav(i,child[ind]) {",
      "\t\t\tprocess(i); ",
      "\t\t\tcomb(ind,i);",
      "\t\t}",
      "\t\t// now do stuff with values",
