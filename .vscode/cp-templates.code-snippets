      "        res = a / b;",
      "        xx = res * b;",
      "        yy = b * (res + 1);",
      "",
      "        if (xx > a || yy <= a) {",
      "            cout << i << endl;",
      "            cout << a << \" \" << b << \" \" << res << endl;",
      "            break;",
      "        }",
      "    }",
      "",
      "    bigint a = random_bigint(10000);",
      "    bigint b = random_bigint(2000);",
      "    clock_t start = clock();",
      "    bigint c = a / b;",
      "    printf(\"time=%.3lfsec\\\\n\", (clock() - start) * 1. / CLOCKS_PER_SEC);",
