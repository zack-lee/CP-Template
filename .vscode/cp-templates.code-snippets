      "/** ",
      " * Description: tests whether a point is inside, on, or outside the perimeter of any polygon",
      " * Time: O(N)",
      " * Verification: https://open.kattis.com/problems/pointinpolygon",
      " */",
      "",
      "#include \"Point.h\"",
      "",
      "string inPoly(const vP& p, P z) {",
      "\tint n = sz(p), ans = 0;",
      "\tF0R(i,n) {",
      "\t\tP x = p[i], y = p[(i+1)%n];",
      "\t\tif (onSeg(z,x,y)) return \"on\";",
      "\t\tif (x.s > y.s) swap(x,y);",
      "\t\tif (x.s <= z.s && y.s > z.s && cross(z,x,y) > 0) ans ^= 1;",
      "\t}",
      "\treturn ans ? \"in\" : \"out\";",
      "}"
