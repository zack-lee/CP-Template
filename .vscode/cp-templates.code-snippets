      "",
      "\tint eval(char c, int x, int y) {",
      "\t\tswitch(c) {",
      "\t\t\tcase '+': return (x+y)%MOD;",
      "\t\t\tcase '-': return (x-y+MOD)%MOD;",
      "\t\t\tcase '*': return (int)x*y%MOD;",
      "\t\t\tdefault: exit(5);",
      "\t\t}",
      "\t}",
      "",
      "\tint pri(char c) {",
      "\t\tswitch (c) {",
      "\t\t\tcase '+': return 0;",
      "\t\t\tcase '-': return 0;",
      "\t\t\tcase '*': return 1;",
      "\t\t\tdefault: exit(5);",
      "\t\t}",
      "\t}",
      "",
