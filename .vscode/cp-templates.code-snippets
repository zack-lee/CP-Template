      "        component, stack = [], [start]",
      "",
      "        while stack:",
      "            start = stack[-1]",
      "",
      "            if visited[start]:",
      "                stack.pop()",
      "                continue",
      "            else:",
      "                visited[start] = True",
      "                component.append(start)",
      "",
      "            for i in graph[start]:",
      "                if not visited[i]:",
      "                    stack.append(i)",
      "",
      "        return component",
      "",
      "    for i in range(n):",
