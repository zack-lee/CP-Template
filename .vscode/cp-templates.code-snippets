    "body": [
      "/**",
      " * Description: same as linecontainer but linear time given assumptions",
      " */",
      "",
      "#include \"LineContainer.h\"",
      "",
      "struct LC0 : deque<Line> { // linear time w/ additional assumptions",
      "\t// for doubles, use inf = 1/.0, div(a,b) = a/b",
      "\tconst int inf = LLONG_MAX;",
      "\tint div(int a, int b) { return a/b-((a^b) < 0 && a%b); } // floored division",
      "\tint bet(const Line& x, const Line& y) { // last x such that first line is better",
      "\t\tif (x.k == y.k) return x.m >= y.m ? inf : -inf;",
      "\t\treturn div(y.m-x.m,x.k-y.k);",
      "\t}",
      "\t",
      "\tvoid addBack(Line L) { // assume nonempty",
      "\t\twhile (1) {",
      "\t\t\tauto a = back(); pop_back(); a.p = bet(a,L);",
      "\t\t\tif (size() && back().p >= a.p) continue;",
      "\t\t\tpb(a); break;",
      "\t\t}",
      "\t\tL.p = inf; pb(L);",
      "\t}",
      "\tvoid addFront(Line L) {",
      "\t\twhile (1) {",
      "\t\t\tif (!size()) { L.p = inf; break; }",
      "\t\t\tif ((L.p = bet(L,front())) >= front().p) pop_front();",
      "\t\t\telse break;",
      "\t\t}",
      "\t\tpush_front(L);",
      "\t}",
      "\tvoid add(int k, int m) { // assume line goes to one end of deque",
      "\t\tif (!size() || k <= front().k) addFront({k,m,0});",
      "\t\telse assert(k >= back().k), addBack({k,m,0});",
      "\t}",
      "\t",
      "\tint ord = 0; // 1 = increasing, -1 = decreasing",
      "\tint query(int x) { ",
      "\t\tassert(ord);",
      "\t\tif (ord == 1) { ",
      "\t\t\twhile (front().p < x) pop_front();",
      "\t\t\treturn front().eval(x);",
      "\t\t} else {",
      "\t\t\twhile (size() > 1 && prev(prev(end()))->p >= x) pop_back();",
      "\t\t\treturn back().eval(x);",
      "\t\t}",
      "\t}\t",
      "};"
    ],
    "description": "ds/LineContainerDeque.h"
