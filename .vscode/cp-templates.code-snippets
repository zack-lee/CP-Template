      "",
      "struct mint {",
      "\tint val;",
      "\tmint() { val = 0; }",
      "\tmint(const int& v) {",
      "\t\tval = (-mod <= v && v < mod) ? v : v % mod;",
      "\t\tif (val < 0) val += mod;",
      "\t}",
      "",
      "\tfriend ostream& operator<<(ostream& os, const mint& a) { return os << a.val; }",
      "\tfriend bool operator==(const mint& a, const mint& b) { return a.val == b.val; }",
      "\tfriend bool operator!=(const mint& a, const mint& b) { return !(a == b); }",
      "\tfriend bool operator<(const mint& a, const mint& b) { return a.val < b.val; }",
      "",
      "\tmint operator-() const { return mint(-val); }",
      "\tmint& operator+=(const mint& m) { if ((val += m.val) >= mod) val -= mod; return *this; }",
      "\tmint& operator-=(const mint& m) { if ((val -= m.val) < 0) val += mod; return *this; }",
      "\tmint& operator*=(const mint& m) { val = (int)val*m.val%mod; return *this; }",
      "\tfriend mint mpow(mint a, int p) {",
      "\t\tmint ans = 1; for (; p; p /= 2, a *= a) if (p&1) ans *= a;",
      "\t\treturn ans;",
      "\t}",
      "\tfriend mint inv(const mint& a) { assert(a.val); return ipow(a, mod - 2); }",
      "\tmint& operator/=(const mint& m) { return (*this) *= inv(m); }",
      "",
      "\tfriend mint operator+(mint a, const mint& b) { return a += b; }",
      "\tfriend mint operator-(mint a, const mint& b) { return a -= b; }",
      "\tfriend mint operator*(mint a, const mint& b) { return a *= b; }",
      "\tfriend mint operator/(mint a, const mint& b) { return a /= b; }",
      "\toperator int64_t() const {return val; }",
      "};",
      "",
      "namespace fft{",
      "\tusing base = complex<double>;",
      "",
      "\tvoid fft(vector<base> &a, bool inv){",
      "\t\tint n = a.size(), j = 0;",
      "\t\tvector<base> roots(n/2);",
      "\t\tfor(int i=1; i<n; i++){",
      "\t\t\tint bit = (n >> 1);",
      "\t\t\twhile(j >= bit){",
      "\t\t\t\tj -= bit;",
      "\t\t\t\tbit >>= 1;",
      "\t\t\t}",
      "\t\t\tj += bit;",
      "\t\t\tif(i < j) swap(a[i], a[j]);",
      "\t\t}",
      "\t\tdouble ang = 2 * acos(-1) / n * (inv ? -1 : 1);",
      "\t\tfor(int i=0; i<n/2; i++){",
      "\t\t\troots[i] = base(cos(ang * i), sin(ang * i));",
      "\t\t}",
      "\t\t/*",
      "\t\t   XOR Convolution : set roots[*] = 1.",
      "\t\t   OR Convolution : set roots[*] = 1, and do following:",
      "\t\t   if (!inv) {",
      "\t\t   a[j + k] = u + v;",
      "\t\t   a[j + k + i/2] = u;",
      "\t\t   } else {",
      "\t\t   a[j + k] = v;",
      "\t\t   a[j + k + i/2] = u - v;",
      "\t\t   }",
      "\t\t */",
      "\t\tfor(int i=2; i<=n; i<<=1){",
      "\t\t\tint step = n / i;",
      "\t\t\tfor(int j=0; j<n; j+=i){",
      "\t\t\t\tfor(int k=0; k<i/2; k++){",
      "\t\t\t\t\tbase u = a[j+k], v = a[j+k+i/2] * roots[step * k];",
      "\t\t\t\t\ta[j+k] = u+v;",
      "\t\t\t\t\ta[j+k+i/2] = u-v;",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t\tif(inv) for(int i=0; i<n; i++) a[i] /= n; // skip for OR convolution.",
      "\t}",
      "\ttemplate<typename T>",
      "\tvoid ntt(vector<T> &a, bool inv){",
      "\t\tconst int prr = 3; // primitive root",
      "\t\tint n = a.size(), j = 0;",
      "\t\tvector<T> roots(n/2);",
      "\t\tfor(int i=1; i<n; i++){",
      "\t\t\tint bit = (n >> 1);",
      "\t\t\twhile(j >= bit){",
      "\t\t\t\tj -= bit;",
      "\t\t\t\tbit >>= 1;",
      "\t\t\t}",
      "\t\t\tj += bit;",
      "\t\t\tif(i < j) swap(a[i], a[j]);",
      "\t\t}",
      "\t\tT ang = ipow(T(prr), (mod - 1) / n);",
      "\t\tif(inv) ang = T(1) / ang;",
      "\t\tfor(int i=0; i<n/2; i++){",
      "\t\t\troots[i] = (i ? (roots[i-1] * ang) : T(1));",
      "\t\t}",
      "\t\tfor(int i=2; i<=n; i<<=1){",
      "\t\t\tint step = n / i;",
      "\t\t\tfor(int j=0; j<n; j+=i){",
      "\t\t\t\tfor(int k=0; k<i/2; k++){",
      "\t\t\t\t\tT u = a[j+k], v = a[j+k+i/2] * roots[step * k];",
      "\t\t\t\t\ta[j+k] = u+v;",
      "\t\t\t\t\ta[j+k+i/2] = u-v;",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t\tif(inv){",
      "\t\t\tT rev = T(1) / T(n);",
      "\t\t\tfor(int i=0; i<n; i++) a[i] *= rev;",
      "\t\t}",
      "\t}",
      "\ttemplate<typename T>",
      "\tvector<T> multiply_ntt(vector<T> &v, const vector<T> &w){",
      "\t\tvector<T> fv(all(v)), fw(all(w));",
      "\t\tint n = 2;",
      "\t\twhile(n < sz(v) + sz(w)) n <<= 1;",
      "\t\tfv.resize(n); fw.resize(n);",
      "\t\tntt(fv, 0); ntt(fw, 0);",
      "\t\tfor(int i=0; i<n; i++) fv[i] *= fw[i];",
      "\t\tntt(fv, 1);",
      "\t\tvector<T> ret(n);",
      "\t\tfor(int i=0; i<n; i++) ret[i] = fv[i];",
      "\t\treturn ret;",
      "\t}",
      "\ttemplate<typename T>",
      "\tvector<T> multiply(vector<T> &v, const vector<T> &w){",
      "\t\tvector<base> fv(all(v)), fw(all(w));",
      "\t\tint n = 2;",
      "\t\twhile(n < sz(v) + sz(w)) n <<= 1;",
      "\t\tfv.resize(n); fw.resize(n);",
      "\t\tfft(fv, 0); fft(fw, 0);",
      "\t\tfor(int i=0; i<n; i++) fv[i] *= fw[i];",
      "\t\tfft(fv, 1);",
      "\t\tvector<T> ret(n);",
      "\t\tfor(int i=0; i<n; i++) ret[i] = (T)llround(fv[i].real());",
      "\t\treturn ret;",
      "\t}",
      "\ttemplate<typename T>",
      "\tvector<T> multiply_mod(vector<T> v, const vector<T> &w){",
      "\t\tint n = 2;",
      "\t\twhile(n < sz(v) + sz(w)) n <<= 1;",
      "\t\tvector<base> v1(n), v2(n), r1(n), r2(n);",
      "\t\tfor(int i=0; i<v.size(); i++){",
      "\t\t\tv1[i] = base(v[i] >> 15, v[i] & 32767);",
      "\t\t}",
      "\t\tfor(int i=0; i<w.size(); i++){",
      "\t\t\tv2[i] = base(w[i] >> 15, w[i] & 32767);",
      "\t\t}",
      "\t\tfft(v1, 0);",
      "\t\tfft(v2, 0);",
      "\t\tfor(int i=0; i<n; i++){",
      "\t\t\tint j = (i ? (n - i) : i);",
      "\t\t\tbase ans1 = (v1[i] + conj(v1[j])) * base(0.5, 0);",
      "\t\t\tbase ans2 = (v1[i] - conj(v1[j])) * base(0, -0.5);",
      "\t\t\tbase ans3 = (v2[i] + conj(v2[j])) * base(0.5, 0);",
      "\t\t\tbase ans4 = (v2[i] - conj(v2[j])) * base(0, -0.5);",
      "\t\t\tr1[i] = (ans1 * ans3) + (ans1 * ans4) * base(0, 1);",
      "\t\t\tr2[i] = (ans2 * ans3) + (ans2 * ans4) * base(0, 1);",
      "\t\t}",
      "\t\tfft(r1, 1);",
      "\t\tfft(r2, 1);",
      "\t\tvector<T> ret(n);",
      "\t\tfor(int i=0; i<n; i++){",
      "\t\t\tT av = llround(r1[i].real());",
      "\t\t\tT bv = llround(r1[i].imag()) + llround(r2[i].real());",
      "\t\t\tT cv = llround(r2[i].imag());",
      "\t\t\tav = av << 30;",
      "\t\t\tbv = bv << 15;",
      "\t\t\tret[i] = av + bv + cv;",
      "\t\t}",
      "\t\treturn ret;",
      "\t}",
      "}",
      "",
      "template<typename T>",
      "struct poly {",
      "\tvector<T> a;",
      "",
      "\tvoid normalize() { // get rid of leading zeroes",
      "\t\twhile(!a.empty() && a.back() == T(0)) {",
      "\t\t\ta.pop_back();",
      "\t\t}",
      "\t}",
      "",
      "\tpoly(){}",
      "\tpoly(T a0){ a = {a0}; normalize(); }",
      "\tpoly(vector<T> t) : a(t){ normalize(); }",
      "",
      "\tint deg() const{ return sz(a) - 1; } // -1 if empty",
      "\tmint lead() const{ return sz(a) ? a.back() : mint(0); }",
      "",
      "\tT operator [](int idx) const {",
      "\t\treturn idx >= (int)a.size() || idx < 0 ? T(0) : a[idx];",
      "\t}",
      "",
      "\tpoly reversed() const{",
      "\t\tvector<T> b = a;",
      "\t\treverse(all(b));",
      "\t\treturn poly(b);",
      "\t}",
      "\tpoly trim(int n) const{",
      "\t\tn = min(n, sz(a));",
      "\t\tvector<T> b(a.begin(), a.begin() + n);",
      "\t\treturn poly(b);",
      "\t}",
      "",
      "\tpoly operator *= (const T &x) {",
      "\t\tfor(auto &it: a) {",
      "\t\t\tit *= x;",
      "\t\t}",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "\tpoly operator /= (const T &x) {",
      "\t\treturn *this *= (T(1)/ T(x));",
      "\t}",
      "\tpoly operator * (const T &x) const {return poly(*this) *= x;}",
      "\tpoly operator / (const T &x) const {return poly(*this) /= x;}",
      "",
      "\tpoly operator+=(const poly &p){",
      "\t\ta.resize(max(sz(a), sz(p.a)));",
      "\t\tfor(int i=0; i<sz(p.a); i++){",
      "\t\t\ta[i] += p.a[i];",
      "\t\t}",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "\tpoly operator-=(const poly &p){",
      "\t\ta.resize(max(sz(a), sz(p.a)));",
      "\t\tfor(int i=0; i<sz(p.a); i++){",
      "\t\t\ta[i] -= p.a[i];",
      "\t\t}",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "\tpoly operator*=(const poly &p){",
      "\t\t// change multiplication method if needed",
      "\t\t*this = poly(fft::multiply_ntt(a, p.a));",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "\tpoly inv(int n){",
      "\t\tpoly q(T(1) / a[0]);",
      "\t\tfor(int i=1; i<n; i<<=1){",
      "\t\t\tpoly p = poly(2) - q * trim(i * 2);",
      "\t\t\tq = (p * q).trim(i * 2);",
      "\t\t}",
      "\t\treturn q.trim(n);",
      "\t}",
      "\tpair<poly, poly> divmod_slow(const poly &b) const { // when divisor or quotient is small",
      "\t\tvector<T> A(a);",
      "\t\tvector<T> res;",
      "\t\twhile(A.size() >= b.a.size()) {",
      "\t\t\tres.push_back(A.back() / b.a.back());",
      "\t\t\tif(res.back() != T(0)) {",
      "\t\t\t\tfor(size_t i = 0; i < b.a.size(); i++) {",
      "\t\t\t\t\tA[A.size() - i - 1] -= res.back() * b.a[b.a.size() - i - 1];",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t\tA.pop_back();",
      "\t\t}",
      "\t\treverse(all(res));",
      "\t\treturn {res, A};",
      "\t}",
      "",
      "\tpoly operator/=(const poly &b){",
      "\t\tif(deg() < b.deg()) return *this = poly();",
      "\t\tif(min(deg(), b.deg()) < 256) return *this = divmod_slow(b).first;",
      "\t\tint k = deg() - b.deg() + 1;",
      "\t\tpoly ra = reversed().trim(k);",
      "\t\tpoly rb = b.reversed().trim(k).inv();",
      "\t\t*this = (ra * rb).trim(k);",
      "\t\twhile(sz(a) < k) a.push_back(T(0));",
      "\t\treverse(all(a));",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "\tpoly operator%=(const poly &b){",
      "\t\tif(deg() < b.deg()) return *this;",
      "\t\tif(min(deg(), b.deg()) < 256) return *this = divmod_slow(b).second;",
      "\t\tpoly foo = poly(a); foo /= b; foo *= b;",
      "\t\t*this = poly(*this) -= foo;",
      "\t\tnormalize();",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tpoly operator+(const poly &p)const{ return poly(*this) += p; }",
      "\tpoly operator-(const poly &p)const{ return poly(*this) -= p; }",
      "\tpoly operator*(const poly &p)const{ return poly(*this) *= p; }",
      "\tpoly operator/(const poly &p)const{ return poly(*this) /= p; }",
      "\tpoly operator%(const poly &p)const{ return poly(*this) %= p; }",
      "",
      "\tpoly deriv() { // calculate derivative",
      "\t\tvector<T> res;",
      "\t\tfor(int i = 1; i <= deg(); i++) {",
      "\t\t\tres.push_back(T(i) * a[i]);",
      "\t\t}",
      "\t\treturn res;",
      "\t}",
      "\tpoly integr() { // calculate integral with C = 0",
      "\t\tvector<T> res = {0};",
      "\t\tfor(int i = 0; i <= deg(); i++) {",
      "\t\t\tres.push_back(a[i] / T(i + 1));",
      "\t\t}",
      "\t\treturn res;",
      "\t}",
      "\tpoly ln(int n){",
      "\t\t// NOT TESTED",
      "\t\tassert(sz(a) > 0 && a[0] == 1);",
      "\t\treturn (deriv() * inv(n)).integ().trim(n);",
      "\t}",
      "\tpoly exp(int n){",
      "\t\t// NOT TESTED",
      "\t\tassert(sz(a) > 0 && a[0] == 1);",
      "\t\tpoly q(1);",
      "\t\tfor(int i=1; i<n; i<<=1){",
      "\t\t\tpoly p = poly(1) + trim(2 * i) - q.ln(2 * i);",
      "\t\t\tq = (q * p).trim(2 * i);",
      "\t\t}",
      "\t\treturn q.trim(n);",
      "\t}",
      "\tpoly power(poly x, int y, int n){",
      "\t\t// NOT TESTED",
      "\t\tpoly ret(1), piv = x.trim(n);",
      "\t\twhile(y){",
      "\t\t\tif(y & 1) ret = (ret * piv).trim(n);",
      "\t\t\tpiv = (piv * piv).trim(n);",
      "\t\t}",
      "\t\treturn ret;",
      "\t}",
      "\tpoly root(int n, int k = 2){",
      "\t\t// NOT TESTED in K > 2",
      "\t\tassert(sz(a) > 0 && a[0] == T(1) && k >= 2);",
      "\t\tpoly q(1);",
      "\t\tfor(int i=1; i<n; i<<=1){",
      "\t\t\tif(k == 2) q += trim(2 * i) * q.inv(2 * i);",
      "\t\t\telse q = q * T(k - 1) + trim(2 * i) * power(q.inv(2 * i), k - 1, 2 * i);",
      "\t\t\tq = q.trim(2 * i) / T(k);",
      "\t\t}",
      "\t\treturn q.trim(n);",
      "\t}",
      "};"
    ],
    "description": "num/Polynomial.h"
  },
