      "/**",
      " * Description: multiply two polynomials",
      " * Time: O(N\\\\log N)",
      " * Source: KACTL, https://cp-algorithms.com/algebra/fft.html",
      " * Verification: ",
      "\t* SPOJ polymul, CSA manhattan, CF Perfect Encoding",
      "\t* http://codeforces.com/contest/632/problem/E",
      " */",
      "",
      "#include \"Modular.h\"",
      "",
      "typedef complex<db> cd;",
      "const int MOD = (119 << 23) + 1, root = 3; // = 998244353",
      "// NTT: For p < 2^30 there is also e.g. (5 << 25, 3), (7 << 26, 3),",
      "// (479 << 21, 3) and (483 << 21, 5). The last two are > 10^9.",
      "",
      "constexpr int size(int s) { return s > 1 ? 32-__builtin_clz(s-1) : 0; }",
      "void genRoots(vmi& roots) { // primitive n-th roots of unity",
      "\tint n = sz(roots); mi r = pow(mi(root),(MOD-1)/n);",
      "\troots[0] = 1; FOR(i,1,n) roots[i] = roots[i-1]*r;",
      "}",
      "void genRoots(vcd& roots) { // change cd to complex<double> instead?",
      "\tint n = sz(roots); double ang = 2*PI/n;",
      "\tF0R(i,n) roots[i] = cd(cos(ang*i),sin(ang*i)); // is there a way to do this more quickly?",
      "}",
      "",
      "template<class T> void fft(vector<T>& a, const vector<T>& roots, bool inv = 0) {",
      "\tint n = sz(a);",
      "\tfor (int i = 1, j = 0; i < n; i++) { // sort by reverse bit representation",
      "\t\tint bit = n >> 1;",
      "\t\tfor (; j&bit; bit >>= 1) j ^= bit;",
      "\t\tj ^= bit; if (i < j) swap(a[i], a[j]);",
      "\t}",
      "\tfor (int len = 2; len <= n; len <<= 1) ",
      "\t\tfor (int i = 0; i < n; i += len) ",
      "\t\t\tF0R(j,len/2) {",
      "\t\t\t\tint ind = n/len*j; if (inv && ind) ind = n-ind;",
      "\t\t\t\tauto u = a[i+j], v = a[i+j+len/2]*roots[ind];",
      "\t\t\t\ta[i+j] = u+v, a[i+j+len/2] = u-v;",
      "\t\t\t}",
      "\tif (inv) { T i = T(1)/T(n); trav(x,a) x *= i; }",
      "}",
      "",
      "template<class T> vector<T> mult(vector<T> a, vector<T> b) {",
      "\tint s = sz(a)+sz(b)-1, n = 1<<size(s);",
      "\tvector<T> roots(n); genRoots(roots);",
      "\ta.resize(n), fft(a,roots); ",
      "\tb.resize(n), fft(b,roots);",
      "\tF0R(i,n) a[i] *= b[i];",
      "\tfft(a,roots,1); return a;",
      "}"
    ],
    "description": "num/Polynomials/FFT.h"
  },
  "content/num/Polynomials/FFTEcnerwala.h": {
    "scope": "cpp,c",
    "prefix": "FFTEcnerwala",
    "body": [
      "/**",
      " * Author: Andrew He",
      " * Description: FFT/NTT, polynomial mod/log/exp",
      " * Source: http://neerc.ifmo.ru/trains/toulouse/2017/fft2.pdf",
      " * Papers about accuracy: http://www.daemonology.net/papers/fft.pdf, http://www.cs.berkeley.edu/~fateman/papers/fftvsothers.pdf",
      " * For integers rounding works if \\$(|a| + |b|)\\\\max(a, b) < \\\\mathtt{\\\\sim} 10^9\\$, or in theory maybe \\$10^6\\$.",
      " */",
      "",
      "namespace fft {",
      "#if FFT",
      "// FFT",
      "using dbl = double;",
      "struct num { /// start-hash",
      "\tdbl x, y;",
      "\tnum(dbl x_ = 0, dbl y_ = 0) : x(x_), y(y_) { }",
      "};",
      "inline num operator+(num a, num b) { return num(a.x + b.x, a.y + b.y); }",
      "inline num operator-(num a, num b) { return num(a.x - b.x, a.y - b.y); }",
      "inline num operator*(num a, num b) { return num(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }",
      "inline num conj(num a) { return num(a.x, -a.y); }",
      "inline num inv(num a) { dbl n = (a.x*a.x+a.y*a.y); return num(a.x/n,-a.y/n); }",
      "/// end-hash",
      "#else",
      "// NTT",
      "const int mod = 998244353, g = 3;",
      "// For p < 2^30 there is also (5 << 25, 3), (7 << 26, 3),",
      "// (479 << 21, 3) and (483 << 21, 5). Last two are > 10^9.",
      "struct num { /// start-hash",
      "\tint v;",
      "\tnum(int v_ = 0) : v(int(v_ % mod)) { if (v<0) v+=mod; }",
      "\texplicit operator int() const { return v; }",
      "};",
      "inline num operator+(num a,num b){return num(a.v+b.v);}",
      "inline num operator-(num a,num b){return num(a.v+mod-b.v);}",
      "inline num operator*(num a,num b){return num(1ll*a.v*b.v);}",
      "inline num pow(num a, int b) {",
      "\tnum r = 1;",
      "\tdo{if(b&1)r=r*a;a=a*a;}while(b>>=1);",
      "\treturn r;",
      "}",
      "inline num inv(num a) { return pow(a, mod-2); }",
      "/// end-hash",
      "#endif",
      "",
      "using vn = vector<num>;",
      "vi rev({0, 1});",
      "vn rt(2, num(1)), fa, fb;",
      "",
      "inline void init(int n) { /// start-hash",
      "\tif (n <= sz(rt)) return;",
      "\trev.resize(n);",
      "\trep(i,0,n) rev[i] = (rev[i>>1] | ((i&1)*n)) >> 1;",
      "\trt.reserve(n);",
      "\tfor (int k = sz(rt); k < n; k *= 2) {",
      "\t\trt.resize(2*k);",
      "#if FFT",
      "\t\tdouble a=M_PI/k; num z(cos(a),sin(a)); // FFT",
      "#else",
      "\t\tnum z = pow(num(g), (mod-1)/(2*k)); // NTT",
      "#endif",
      "\t\trep(i,k/2,k) rt[2*i] = rt[i], rt[2*i+1] = rt[i]*z;",
      "\t}",
      "} /// end-hash",
      "",
      "inline void fft(vector<num> &a, int n) { /// start-hash",
      "\tinit(n);",
      "\tint s = __builtin_ctz(sz(rev)/n);",
      "\trep(i,0,n) if (i < rev[i]>>s) swap(a[i], a[rev[i]>>s]);",
      "\tfor (int k = 1; k < n; k *= 2)",
      "\t\tfor (int i = 0; i < n; i += 2 * k) rep(j,0,k) {",
      "\t\t\tnum t = rt[j+k] * a[i+j+k];",
      "\t\t\ta[i+j+k] = a[i+j] - t;",
      "\t\t\ta[i+j] = a[i+j] + t;",
      "\t\t}",
      "} /// end-hash",
      "",
      "// Complex/NTT",
      "vn multiply(vn a, vn b) { /// start-hash",
      "\tint s = sz(a) + sz(b) - 1;",
      "\tif (s <= 0) return {};",
      "\tint L = s > 1 ? 32 - __builtin_clz(s-1) : 0, n = 1 << L;",
      "\ta.resize(n), b.resize(n);",
      "\tfft(a, n);",
      "\tfft(b, n);",
      "\tnum d = inv(num(n));",
      "\trep(i,0,n) a[i] = a[i] * b[i] * d;",
      "\treverse(a.begin()+1, a.end());",
      "\tfft(a, n);",
      "\ta.resize(s);",
      "\treturn a;",
      "} /// end-hash",
      "",
      "// Complex/NTT power-series inverse",
      "// Doubles b as b[:n] = (2 - a[:n] * b[:n/2]) * b[:n/2]",
      "vn inverse(const vn& a) { /// start-hash",
      "\tif (a.empty()) return {};",
      "\tvn b({inv(a[0])});",
      "\tb.reserve(2*a.size());",
      "\twhile (sz(b) < sz(a)) {",
      "\t\tint n = 2*sz(b);",
      "\t\tb.resize(2*n, 0);",
      "\t\tif (sz(fa) < 2*n) fa.resize(2*n);",
      "\t\tfill(fa.begin(), fa.begin()+2*n, 0);",
      "\t\tcopy(a.begin(), a.begin()+min(n,sz(a)), fa.begin());",
      "\t\tfft(b, 2*n);",
      "\t\tfft(fa, 2*n);",
      "\t\tnum d = inv(num(2*n));",
      "\t\trep(i, 0, 2*n) b[i] = b[i] * (2 - fa[i] * b[i]) * d;",
      "\t\treverse(b.begin()+1, b.end());",
      "\t\tfft(b, 2*n);",
      "\t\tb.resize(n);",
      "\t}",
      "\tb.resize(a.size());",
      "\treturn b;",
      "} /// end-hash",
      "",
      "#if FFT",
      "// Double multiply (num = complex)",
      "using vd = vector<double>;",
      "vd multiply(const vd& a, const vd& b) { /// start-hash",
      "\tint s = sz(a) + sz(b) - 1;",
      "\tif (s <= 0) return {};",
      "\tint L = s > 1 ? 32 - __builtin_clz(s-1) : 0, n = 1 << L;",
      "\tif (sz(fa) < n) fa.resize(n);",
      "\tif (sz(fb) < n) fb.resize(n);",
      "",
      "\tfill(fa.begin(), fa.begin() + n, 0);",
      "\trep(i,0,sz(a)) fa[i].x = a[i];",
      "\trep(i,0,sz(b)) fa[i].y = b[i];",
      "\tfft(fa, n);",
      "\ttrav(x, fa) x = x * x;",
      "\trep(i,0,n) fb[i] = fa[(n-i)&(n-1)] - conj(fa[i]);",
      "\tfft(fb, n);",
      "\tvd r(s);",
      "\trep(i,0,s) r[i] = fb[i].y / (4*n);",
      "\treturn r;",
      "} /// end-hash",
      "",
      "// Integer multiply mod m (num = complex) /// start-hash",
      "vi multiply_mod(const vi& a, const vi& b, int m) {",
      "\tint s = sz(a) + sz(b) - 1;",
      "\tif (s <= 0) return {};",
      "\tint L = s > 1 ? 32 - __builtin_clz(s-1) : 0, n = 1 << L;",
      "\tif (sz(fa) < n) fa.resize(n);",
      "\tif (sz(fb) < n) fb.resize(n);",
      "",
      "\trep(i,0,sz(a)) fa[i] = num(a[i] & ((1<<15)-1), a[i] >> 15);",
      "\tfill(fa.begin()+sz(a), fa.begin() + n, 0);",
      "\trep(i,0,sz(b)) fb[i] = num(b[i] & ((1<<15)-1), b[i] >> 15);",
      "\tfill(fb.begin()+sz(b), fb.begin() + n, 0);",
      "",
      "\tfft(fa, n);",
      "\tfft(fb, n);",
      "\tdouble r0 = 0.5 / n; // 1/2n",
      "\trep(i,0,n/2+1) {",
      "\t\tint j = (n-i)&(n-1);",
      "\t\tnum g0 = (fb[i] + conj(fb[j])) * r0;",
      "\t\tnum g1 = (fb[i] - conj(fb[j])) * r0;",
      "\t\tswap(g1.x, g1.y); g1.y *= -1;",
      "\t\tif (j != i) {",
      "\t\t\tswap(fa[j], fa[i]);",
      "\t\t\tfb[j] = fa[j] * g1;",
      "\t\t\tfa[j] = fa[j] * g0;",
      "\t\t}",
      "\t\tfb[i] = fa[i] * conj(g1);",
      "\t\tfa[i] = fa[i] * conj(g0);",
      "\t}",
      "\tfft(fa, n);",
      "\tfft(fb, n);",
      "\tvi r(s);",
      "\trep(i,0,s) r[i] = int((int(fa[i].x+0.5)",
      "\t\t\t\t+ (int(fa[i].y+0.5) % m << 15)",
      "\t\t\t\t+ (int(fb[i].x+0.5) % m << 15)",
      "\t\t\t\t+ (int(fb[i].y+0.5) % m << 30)) % m);",
      "\treturn r;",
      "} /// end-hash",
      "#endif",
      "",
      "} // namespace fft",
      "",
      "// For multiply_mod, use num = modnum, poly = vector<num>",
      "using fft::num;",
      "using poly = fft::vn;",
      "using fft::multiply;",
      "using fft::inverse;",
      "/// start-hash",
      "poly& operator+=(poly& a, const poly& b) {",
      "\tif (sz(a) < sz(b)) a.resize(b.size());",
      "\trep(i,0,sz(b)) a[i]=a[i]+b[i];",
      "\treturn a;",
      "}",
      "poly operator+(const poly& a, const poly& b) { poly r=a; r+=b; return r; }",
      "poly& operator-=(poly& a, const poly& b) {",
      "\tif (sz(a) < sz(b)) a.resize(b.size());",
      "\trep(i,0,sz(b)) a[i]=a[i]-b[i];",
      "\treturn a;",
      "}",
      "poly operator-(const poly& a, const poly& b) { poly r=a; r-=b; return r; }",
      "poly operator*(const poly& a, const poly& b) {",
      "\t// TODO: small-case?",
      "\treturn multiply(a, b);",
      "}",
      "poly& operator*=(poly& a, const poly& b) {return a = a*b;}",
      "/// end-hash",
      "poly& operator*=(poly& a, const num& b) { // Optional",
      "\ttrav(x, a) x = x * b;",
      "\treturn a;",
      "}",
      "poly operator*(const poly& a, const num& b) { poly r=a; r*=b; return r; }",
      "",
      "// Polynomial floor division; no leading 0's plz",
      "poly operator/(poly a, poly b) { /// start-hash",
      "\tif (sz(a) < sz(b)) return {};",
      "\tint s = sz(a)-sz(b)+1;",
      "\treverse(a.begin(), a.end());",
      "\treverse(b.begin(), b.end());",
      "\ta.resize(s);",
      "\tb.resize(s);",
      "\ta = a * inverse(move(b));",
      "\ta.resize(s);",
      "\treverse(a.begin(), a.end());",
      "\treturn a;",
      "} /// end-hash",
      "poly& operator/=(poly& a, const poly& b) {return a = a/b;}",
      "poly& operator%=(poly& a, const poly& b) { /// start-hash",
      "\tif (sz(a) >= sz(b)) {",
      "\t\tpoly c = (a / b) * b;",
      "\t\ta.resize(sz(b)-1);",
      "\t\trep(i,0,sz(a)) a[i] = a[i]-c[i];",
      "\t}",
      "\treturn a;",
      "} /// end-hash",
      "poly operator%(const poly& a, const poly& b) { poly r=a; r%=b; return r; }",
      "",
      "// Log/exp/pow",
      "poly deriv(const poly& a) { /// start-hash",
      "\tif (a.empty()) return {};",
      "\tpoly b(sz(a)-1);",
      "\trep(i,1,sz(a)) b[i-1]=a[i]*i;",
      "\treturn b;",
      "} /// end-hash",
      "poly integ(const poly& a) { /// start-hash",
      "\tpoly b(sz(a)+1);",
      "\tb[1]=1; // mod p",
      "\trep(i,2,sz(b)) b[i]=b[fft::mod%i]*(-fft::mod/i); // mod p",
      "\trep(i,1,sz(b)) b[i]=a[i-1]*b[i]; // mod p",
      "\t//rep(i,1,sz(b)) b[i]=a[i-1]*inv(num(i)); // else",
      "\treturn b;",
      "} /// end-hash",
      "poly log(const poly& a) { // a[0] == 1 /// start-hash",
      "\tpoly b = integ(deriv(a)*inverse(a));",
      "\tb.resize(a.size());",
      "\treturn b;",
      "} /// end-hash",
      "poly exp(const poly& a) { // a[0] == 0 /// start-hash",
      "\tpoly b(1,num(1));",
      "\tif (a.empty()) return b;",
      "\twhile (sz(b) < sz(a)) {",
      "\t\tint n = min(sz(b) * 2, sz(a));",
      "\t\tb.resize(n);",
      "\t\tpoly v = poly(a.begin(), a.begin() + n) - log(b);",
      "\t\tv[0] = v[0]+num(1);",
      "\t\tb *= v;",
      "\t\tb.resize(n);",
      "\t}",
      "\treturn b;",
      "} /// end-hash",
      "poly pow(const poly& a, int m) { // m >= 0 /// start-hash",
      "\tpoly b(a.size());",
      "\tif (!m) { b[0] = 1; return b; }",
      "\tint p = 0;",
      "\twhile (p<sz(a) && a[p].v==0) ++p;",
      "\tif (1ll*m*p >= sz(a)) return b;",
      "\tnum mu = pow(a[p], m), di = inv(a[p]);",
      "\tpoly c(sz(a) - m*p);",
      "\trep(i,0,sz(c)) c[i] = a[i+p] * di;",
      "\tc = log(c);",
      "\ttrav(v,c) v = v * m;",
      "\tc = exp(c);",
      "\trep(i,0,sz(c)) b[i+m*p] = c[i] * mu;",
      "\treturn b;",
      "} /// end-hash",
      "",
      "// Multipoint evaluation/interpolation",
      "/// start-hash",
      "vector<num> eval(const poly& a, const vector<num>& x) {",
      "\tint n=sz(x);",
      "\tif (!n) return {};",
      "\tvector<poly> up(2*n);",
      "\trep(i,0,n) up[i+n] = poly({0-x[i], 1});",
      "\tper(i,1,n) up[i] = up[2*i]*up[2*i+1];",
      "\tvector<poly> down(2*n);",
      "\tdown[1] = a % up[1];",
      "\trep(i,2,2*n) down[i] = down[i/2] % up[i];",
      "\tvector<num> y(n);",
      "\trep(i,0,n) y[i] = down[i+n][0];",
      "\treturn y;",
      "} /// end-hash",
      "/// start-hash",
      "poly interp(const vector<num>& x, const vector<num>& y) {",
      "\tint n=sz(x);",
      "\tassert(n);",
      "\tvector<poly> up(n*2);",
      "\trep(i,0,n) up[i+n] = poly({0-x[i], 1});",
      "\tper(i,1,n) up[i] = up[2*i]*up[2*i+1];",
      "\tvector<num> a = eval(deriv(up[1]), x);",
      "\tvector<poly> down(2*n);",
      "\trep(i,0,n) down[i+n] = poly({y[i]*inv(a[i])});",
      "\tper(i,1,n) down[i] = down[i*2] * up[i*2+1] + down[i*2+1] * up[i*2];",
      "\treturn down[1];",
      "} /// end-hash"
    ],
    "description": "num/Polynomials/FFTEcnerwala.h"
  },
  "content/num/Polynomials/FFTmod.h": {
    "scope": "cpp,c",
    "prefix": "FFTmod",
    "body": [
      "/**",
      " * Description: multiply two polynomials with arbitrary \\$MOD\\$",
      "\t* ensures precision by splitting in half",
      " * Source: KACTL, https://cp-algorithms.com/algebra/fft.html",
      " * Verification: see FFT",
      " */",
      "",
      "#include \"FFT.h\"",
      "",
      "vi multMod(const vi& a, const vi& b) { ",
      "\tif (!min(sz(a),sz(b))) return {};",
      "\tint s = sz(a)+sz(b)-1, n = 1<<size(s), cut = sqrt(MOD);",
      "\tvcd roots(n); genRoots(roots);",
      "\t",
      "\tvcd ax(n), bx(n);",
      "\tF0R(i,sz(a)) ax[i] = cd((int)a[i]/cut, (int)a[i]%cut); // ax(x)=a1(x)+i*a0(x)",
      "\tF0R(i,sz(b)) bx[i] = cd((int)b[i]/cut, (int)b[i]%cut); // bx(x)=b1(x)+i*b0(x)",
      "\tfft(ax,roots), fft(bx,roots);",
      "\t",
      "\tvcd v1(n), v0(n);",
      "\tF0R(i,n) {",
      "\t\tint j = (i ? (n-i) : i);",
      "\t\tv1[i] = (ax[i]+conj(ax[j]))*cd(0.5,0)*bx[i]; // v1 = a1*(b1+b0*cd(0,1));",
      "\t\tv0[i] = (ax[i]-conj(ax[j]))*cd(0,-0.5)*bx[i]; // v0 = a0*(b1+b0*cd(0,1));",
      "\t}",
      "\tfft(v1,roots,1), fft(v0,roots,1);",
      "\t",
      "\tvi ret(n);",
      "\tF0R(i,n) {",
      "\t\tint V2 = (int)round(v1[i].real()); // a1*b1",
      "\t\tint V1 = (int)round(v1[i].imag())+(int)round(v0[i].real()); // a0*b1+a1*b0",
      "\t\tint V0 = (int)round(v0[i].imag()); // a0*b0",
      "\t\tret[i] = ((V2%MOD*cut+V1)%MOD*cut+V0)%MOD;",
      "\t}",
      "\tret.resize(s); return ret;",
      "} // ~0.8s when sz(a)=sz(b)=1<<19"
    ],
    "description": "num/Polynomials/FFTmod.h"
  },
  "content/num/Polynomials/Karatsuba.h": {
    "scope": "cpp,c",
    "prefix": "Karatsuba",
    "body": [
      "/**",
      " * Description: multiply two polynomials",
      " * Time: \\$O(N^{\\\\log_2 3})\\$",
      " * Source: kevinsogo ",
      "\t* https://www.hackerrank.com/contests/noi-ph-2019/challenges/yet-another-packing-problem/editorial",
      "\t* also see http://codeforces.com/contest/623/submission/15807539",
      "\t* https://en.wikipedia.org/wiki/Karatsuba\\\\_algorithm",
      " * Verification: https://open.kattis.com/problems/polymul2",
      " */",
      "",
      "int size(int s) { return s > 1 ? 32-__builtin_clz(s-1) : 0; }",
      "",
      "void karatsuba(int *a, int *b, int *c, int *t, int n) {",
      "\tint ca = 0, cb = 0; F0R(i,n) ca += !!a[i], cb += !!b[i];",
      "\tif (min(ca, cb) <= 1500/n) { // few numbers to multiply",
      "\t\tif (ca > cb) swap(a, b);",
      "\t\tF0R(i,n) if (a[i]) F0R(j,n) c[i+j] += a[i]*b[j];",
      "\t} else {",
      "\t\tint h = n >> 1;",
      "\t\tkaratsuba(a, b, c, t, h); // a0*b0",
      "\t\tkaratsuba(a+h, b+h, c+n, t, h); // a1*b1",
      "\t\tF0R(i,h) a[i] += a[i+h], b[i] += b[i+h]; ",
      "\t\tkaratsuba(a, b, t, t+n, h); // (a0+a1)*(b0+b1)",
      "\t\tF0R(i,h) a[i] -= a[i+h], b[i] -= b[i+h];",
      "\t\tF0R(i,n) t[i] -= c[i]+c[i+n];",
      "\t\tF0R(i,n) c[i+h] += t[i], t[i] = 0;",
      "\t}",
      "}",
      "",
      "vi conv(vi a, vi b) {",
      "\tint sa = sz(a), sb = sz(b); if (!sa || !sb) return {};",
      "\tint n = 1<<size(max(sa,sb)); a.resize(n), b.resize(n);",
      "\tvi c(2*n), t(2*n); F0R(i,2*n) t[i] = 0; ",
      "\tkaratsuba(&a[0], &b[0], &c[0], &t[0], n);",
      "\tc.resize(sa+sb-1); return c;",
      "}"
    ],
