      "\t\t\t\tstate = 0;",
      "\t\t\t} else {",
      "\t\t\t\twhile (sz(op) && pri(op.back()) >= pri(expr[ind])) {",
      "\t\t\t\t\tint t = process(num,op);",
      "\t\t\t\t\tif (t == -1) return -1;",
