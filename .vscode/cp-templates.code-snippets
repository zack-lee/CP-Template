  "content/num/Matrix/MatrixInv.h": {
    "scope": "cpp,c",
    "prefix": "MatrixInv",
    "body": [
      "/**",
      " * Description: calculates determinant via gaussian elimination",
      " * Time: O(N^3)",
      " * Source: various",
      " * Verification: SPOJ MIFF (matrix inverse modulo prime)",
      " */",
      "",
      "#include \"Matrix.h\"",
      "",
      "template<class T> T gauss(Mat<T>& m) { // determinant of 1000x1000 Matrix in ~1s",
      "\tint n = m.r;",
      "\tT prod = 1; int nex = 0;",
      "\tF0R(i,n) {",
      "\t\tint row = -1; // for ld use EPS rather than 0",
      "\t\tFOR(j,nex,n) if (m.d[j][i] != 0) { row = j; break; } ",
      "\t\tif (row == -1) { prod = 0; continue; }",
      "\t\tif (row != nex) prod *= -1, swap(m.d[row],m.d[nex]);",
      "\t\tprod *= m.d[nex][i];",
      "\t\tauto x = 1/m.d[nex][i]; FOR(k,i,m.c) m.d[nex][k] *= x;",
      "\t\tF0R(j,n) if (j != nex) {",
      "\t\t\tauto v = m.d[j][i];",
      "\t\t\tif (v != 0) FOR(k,i,m.c) m.d[j][k] -= v*m.d[nex][k];",
      "\t\t}",
      "\t\tnex ++;",
      "\t}",
      "\treturn prod;",
      "}",
      "",
      "template<class T> Mat<T> inv(Mat<T> m) {",
      "\tint n = m.r;",
      "\tMat<T> x(n,2*n); ",
      "\tF0R(i,n) {",
      "\t\tx.d[i][i+n] = 1;",
      "\t\tF0R(j,n) x.d[i][j] = m.d[i][j];",
      "\t}",
      "\tif (gauss(x) == 0) return Mat<T>(0,0);",
      "\tMat<T> r(n,n); ",
      "\tF0R(i,n) F0R(j,n) r.d[i][j] = x.d[i][j+n];",
      "\treturn r;",
      "}"
    ],
    "description": "num/Matrix/MatrixInv.h"
  },
